    {
      "id": "notify-now-mode-retired",
      "scope": "profile",
      "severity": "warning",
      "text": "session_notify's 'now' mode is RETIRED and passing it FAILS the delivery outright - it is not merely discouraged. 'turn-end' is the default and wakes an idle target immediately, so it loses nothing 'now' ever delivered; 'quiet' is retained for batch notices whose ack contract is the ledger. interrupt:true is accepted but INERT - it is not an escalation. A 'no wake observed' confirm verdict means the target is mid-turn; never re-send on it.",
      "affects": [
        "profile"
      ],
      "since": "2026-09-19",
      "review_by": "2026-12-19",
      "evidence": "fork issue #373; commits 9dffa5632 + 6db34e1fd, deployed. notify_policy.rs returns Err for mode=now; the session_notify schema's delivery.mode enum is exactly [turn-end, quiet]."
    }
  ],
