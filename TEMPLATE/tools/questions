# Argument helpers
# =============================================================================
def parse_flags(argv, valued, boolean=()):
    """Return (positional, {flag: value}). Unknown flags are a usage error —
    silently ignoring one would let a typo register a question with no
    recommendation while appearing to succeed."""
    valued = set(valued)
    boolean = set(boolean)
    positional, flags, index = [], {}, 0
    while index < len(argv):
        token = argv[index]
        if token in boolean:
            flags[token] = True
            index += 1
            continue
        if token in valued:
            if index + 1 >= len(argv):
                die(2, f"{token} requires a value")
            if token in flags:
                existing = flags[token]
                flags[token] = existing + [argv[index + 1]] if isinstance(existing, list) \
                    else [existing, argv[index + 1]]
            else:
                flags[token] = argv[index + 1]
            index += 2
            continue
        if token.startswith("--"):
            die(2, f"unknown flag {token} (see {PROG} --help)")
        positional.append(token)
        index += 1
    return positional, flags


def flag_list(flags, name):
    value = flags.get(name)
    if value is None:
        return []
    return value if isinstance(value, list) else [value]


def _resolve_one(raw, options, where):
    """#652: resolve ONE --recommended value to (index, label), or die 2.

    Accepts EITHER a 0-based index OR an option label, because the alternative
    is forcing the caller to compute an array index, which fleet-directives.md
    LLM Ergonomics item 1 forbids outright ("Never force an agent to compute,
    track, or predict numeric array indices ... Prefer semantic anchors").
    Measured cost: lane 6630dc9a passed `--recommended 1` meaning "the FIRST
    option" (its prose said "RECOMMENDED: A"); both questions stored index 1,
    the SECOND option, so the owner's page pre-checked the radio OPPOSING each
    question's own prose for 4h26m (q24/q25, amend_count 1 each -- the lane's
    own correction is the evidence).

    Precedence is deliberate: an all-digit value is an INDEX (so an option
    literally named "1" stays reachable), then an exact label, then a leading
    letter. Anything else is REFUSED naming the options -- never silently
    fallen back to an index, which is how the original wrong-base landed.
    Returns (index, label) so callers can ECHO what they resolved; the stored
    value stays the index, so no existing question is reinterpreted.
    """
    if raw is None:
        return None, None
    if isinstance(raw, bool) or (not isinstance(raw, int)
                                 and not isinstance(raw, str)):
        die(2, f"{where}: recommended must be an integer index or an option label")
    if not options:
        die(2, f"{where}: recommended is set but the question carries no options "
               f"-- there is nothing to recommend")
    if isinstance(raw, int):
        index = raw
    elif re.fullmatch(r"[0-9]+", raw.strip()):
        index = int(raw.strip())
    else:
        text = raw.strip()
        index = None
        for i, o in enumerate(options):
            if o == text:
                index = i
                break
        if index is None:
            # A bare letter is the most natural semantic anchor ("--recommended
            # Y"). It must be matched against the OPTIONS' OWN leading letters,
            # NOT the alphabet position: ord('Y')-65 would be 24, which would
            # refuse options labelled X/Y with a complaint about index 24.
            m = re.match(r"^([A-Za-z])(?:\s*[).:-]|\s*$)", text)
            if m:
                want = m.group(1).upper()
                hits = [i for i, o in enumerate(options)
                        if re.match(r"^[A-Za-z](?:\s*[).:-]|\s*$)", o)
                        and o[0].upper() == want]
                if len(hits) == 1:
                    index = hits[0]
                elif len(hits) > 1:
                    die(2, f"{where}: recommended letter {want!r} is ambiguous -- "
                           f"options {hits} all start with it. Pass the full label.")
        if index is None:
            die(2, f"{where}: recommended {text!r} matches no option and is not "
                   f"a 0-based index. Options: "
                   + "; ".join(f"[{i}] {o!r}" for i, o in enumerate(options)))
    if not 0 <= index < len(options):
        die(2, f"{where}: recommended {index} is outside options "
               f"(0..{len(options) - 1}): "
               + "; ".join(f"[{i}] {o!r}" for i, o in enumerate(options)))
    return index, options[index]

def split_recommended_values(raw):
    """Split a comma-joined value ONLY when every part is an all-digit index.

    The answer verb already accepts `0,2` for a multi answer, so the ask side
    mirrors it -- but an option LABEL may legally contain a comma, and splitting
    one would make that label unreachable. An all-digit value is always an index
    (never a label), so the split is unambiguous exactly there and nowhere else.
    """
    if isinstance(raw, str) and "," in raw:
        parts = [p.strip() for p in raw.split(",")]
        if parts and all(re.fullmatch(r"[0-9]+", p or "") for p in parts):
            return parts
    return raw

def resolve_recommendation(raw, options, where, kind="single"):
    """Resolve --recommended to its STORED shape, or die 2.

    The stored shape is `null`, an `int`, or a `list[int]`:
      * `null` -- nothing recommended;
      * `int`  -- ONE recommended option. This is the shape every question asked
                  before multi-select existed already carries, so it stays the
                  shape of a single recommendation rather than being widened to
                  a one-element list;
      * `list` -- SEVERAL recommended options, legal ONLY on kind=multi, because
                  two pre-checked radios are not a state a browser can render.

    An int is never widened and a list never collapsed, so no existing question
    is reinterpreted by this shape. A repeated flag arrives as a list from
    parse_flags; a comma-joined value is split only where that is unambiguous.
    """
    raw = split_recommended_values(raw)
    if raw is None:
        return None, None
    items = raw if isinstance(raw, list) else [raw]
    if not items:
        return None, None
    if kind != "multi" and len(items) > 1:
        die(2, f"{where}: recommended names {len(items)} options but the "
               f"question is single-select -- only ONE option can be "
               f"pre-checked. Pass one value, or ask it with kind=multi.")
    resolved, labels = [], []
    for item in items:
        index, label = _resolve_one(item, options, where)
        if index in resolved:
            continue
        resolved.append(index)
        labels.append(label)
    ordered = sorted(zip(resolved, labels))
    resolved = [pair[0] for pair in ordered]
    labels = [pair[1] for pair in ordered]
    if len(resolved) == 1:
        return resolved[0], labels[0]
    return resolved, labels

def recommended_indices(recommended):
    """The recommended options as a LIST of indices, for ANY stored shape.

    Every reader wants the same thing -- which boxes are pre-checked -- so the
    widening from `null | int | list[int]` happens here once, rather than as an
    ad-hoc branch at each call site (five of them, each of which would have to
    remember that a list is legal now).
    """
    if recommended is None:
        return []
    if isinstance(recommended, list):
        return [i for i in recommended if isinstance(i, int)]
    if isinstance(recommended, int) and not isinstance(recommended, bool):
        return [recommended]
    return []

def recommended_labels(options, recommended):
    """The recommended options as LABELS, for echo and for `list`.

    A stored index outside the current option range is dropped rather than
    raising: `--clear-options` or an `--option` rewrite can leave a stale index
    behind, and a reader that crashed on one would make the register unreadable
    exactly when a caller needs to see what it holds.
    """
    return [options[i] for i in recommended_indices(recommended)
            if 0 <= i < len(options)]

def normalise_questions(raw):
    """Validate and normalise the ordered question array. Order is the contract
    (#547: 'questions[] in call order'), so nothing here reorders."""
    if not isinstance(raw, list) or not raw:
        die(2, "at least one question is required")
    out = []
    for position, item in enumerate(raw, start=1):
        if not isinstance(item, dict):
            die(2, f"question {position} must be an object")
        title = str(item.get("title") or "").strip()
        description = str(item.get("description") or "").strip()
        if not title:
            die(2, f"question {position}: title is required")
        if not description:
            die(2, f"question {position}: description is required")
        options = item.get("options") or []
        if not isinstance(options, list):
            die(2, f"question {position}: options must be an array")
        options = [str(o) for o in options]
        # kind: SINGLE (radio, the default) or MULTI (checkboxes). Question-level
        # and fixed at ask time (owner order 2026-09-28) -- it says how many
        # options an answer may carry, which is a property of the question, not
        # of an answer or of the page.
        kind = str(item.get("kind") or "single").strip().lower()
        if kind not in ("single", "multi"):
            die(2, f"question {position}: kind must be 'single' or 'multi' "
                   f"(got {kind!r})")
        if kind == "multi" and not options:
            die(2, f"question {position}: kind=multi needs options to choose "
                   f"between; it carries none")
        # A label or letter is accepted because a caller must not have to count
        # array positions; the STORED value stays an index.
        recommended, _rec_label = resolve_recommendation(
            item.get("recommended"), options, f"question {position}", kind)
        out.append({
            "qid": f"q{position}",
            "title": title,
            "description": description,
            "options": options,
            "recommended": recommended,
            "kind": kind,
            "clarify": bool(item.get("clarify", True)),
            "status": "open",
            "answer": None,
            "answered_at": None,
            "answered_by": None,
        })
    return out


def questions_from_flags(flags):
    path = flags.get("--questions-file")
    inline = flags.get("--questions-json")
    if path:
        try:
            with open(path, "r", encoding="utf-8") as fh:
                return json.load(fh)
        except Exception as exc:
            die(2, f"--questions-file unreadable: {exc}")
    if inline:
        try:
            return json.loads(inline)
        except Exception as exc:
            die(2, f"--questions-json is not valid JSON: {exc}")
    if flags.get("--title") or flags.get("--description"):
        kind = ("multi" if "--multi" in flags
                else (flags.get("--kind") or "single"))
        return [{
            "title": flags.get("--title", ""),
            "description": flags.get("--description", ""),
            "options": flag_list(flags, "--option"),
            "recommended": resolve_recommendation(
                flags.get("--recommended"), flag_list(flags, "--option"),
                "question 1", kind)[0],
            "kind": kind,
            "clarify": "--no-clarify" not in flags,
        }]
    die(2, "supply --questions-file, --questions-json, or --title/--description")


# =============================================================================
# ask — register an ordered question set (the single-writer cycle)
# =============================================================================
def cmd_ask(argv):
    _, flags = parse_flags(argv, *flag_spec("ask"))
    # --lane was REMOVED (owner order 2026-09-25): the lane is resolved from the
    # asking session's own binding, so a caller cannot mislabel itself. parse_flags
    # rejects it as an unknown flag, rc 2.
    factory = (flags.get("--factory") or "").strip()
    if not factory:
        die(2, "ask requires --factory <KEY> — the factory key IS the standing "
               "set id (e.g. --factory opencrabs-dev)")
    # The asking session is read from the ENV (C1, owner order 2026-09-24) so a
    # lane cannot register a question whose answer has nowhere to go.
    session = (flags.get("--session")
               or os.environ.get("OPENCRABS_SESSION_ID") or "").strip()
    if not session:
        die(2, "ask requires --session, and OPENCRABS_SESSION_ID is not set — "
               "the register must record a RETURN ADDRESS")
    if not UUID_RE.fullmatch(session):
        die(2, f"--session must be a session UUID (got {session!r}); the return "
               f"path delivers to this id")
    lane, why = resolve_lane(session)
    if lane is None:
        # Owner order 2026-09-25: an unbound session can never receive the
        # answer, so registering against it strands the question. Measured:
        # 8 notify_queue rows across 5 zero-binding cron sessions, none
        # drainable.
        die(2, "refusing: %s. An unbound session can never receive the answer, "
               "so a question registered against it would be stranded." % why)

    # --- the cross-factory registration gate (#309) ------------------------
    # A session bound to ANOTHER factory's chat must not be filed into this one.
    # The lane display name is not unique across the fleet, so a foreign session
    # reads as a plausible lane while the answer is delivered to the wrong chat.
    # Measured 2026-09-30: `infra-factory/q9` was registered by a session whose
    # chat belongs to opencrabs-dev, and nothing refused it.
    own_slug, own_display, fleet_known = factory_of_session(session)
    declared = {slug for slug, _chat, _name in load_fleet()}
    foreign_reason = None
    if not fleet_known:
        # No manifest resolved, so the gate cannot observe the failure class it
        # exists for. It stays INERT and says so, rather than firing a verdict
        # off an instrument that cannot see. The note goes to stderr so it never
        # pollutes the JSON on stdout.
        sys.stderr.write(
            "%s: note: no fleet manifest resolved (%s unset, and no "
            "registry/fleet.json in this tree or above it); the cross-factory "
            "registration gate is INERT for this call.\n" % (PROG, FLEET_ENV))
    elif factory not in declared:
        # The named set is NOT a factory the fleet declares, so there is no
        # DECLARED chat to compare the session's binding against: the gate has
        # no expectation to test and stays INERT, saying so.
        #
        # This is not a hole, and it is what keeps the gate from firing on work
        # it cannot see. The factory key IS the set id and sets are MINTED ON
        # DEMAND (`ask --factory <new>` creates one), so a name the fleet does
        # not declare is a NEW set, not another factory's set -- there is no
        # second chat whose lane could be borrowed, which is the whole defect
        # (#309). The case the gate exists for is a set that IS declared:
        # `--factory ai-antispam` from an opencrabs-dev session, refused below.
        # Refusing here instead would forbid every unenrolled factory and every
        # ad-hoc set from filing at all, which is a regression, not a gate.
        sys.stderr.write(
            "%s: note: %r is not a factory declared in the fleet manifest, so "
            "the cross-factory registration gate has no declared chat to "
            "compare this session against and is INERT for this call.\n"
            % (PROG, factory))
    elif own_slug is None:
        die(2, "refusing: session %s is bound to chat %s, which is not a "
               "factory declared in the fleet manifest. --factory %s names a "
               "different factory, so this question would be filed under a lane "
               "that is not the asker's, and the answer would be delivered to a "
               "chat that did not ask." % (session, session_chat_id(session),
                                           factory))
    elif own_slug != factory:
        allow = (flags.get("--allow-foreign") or "").strip()
        if not allow:
            die(2, "refusing: session %s belongs to factory %r, not %r. A lane "
                   "name is not unique across the fleet, so this would file the "
                   "question under another factory's lane and deliver the answer "
                   "to the wrong chat. Pass --factory %s, or --allow-foreign "
                   "\"<reason>\" to register it deliberately as a cross-factory "
                   "ask." % (session, own_slug, factory, own_slug))
        foreign_reason = allow

    questions = normalise_questions(questions_from_flags(flags))
    try:
        ttl_days = int(flags.get("--ttl-days", DEFAULT_TTL_DAYS))
    except ValueError:
        die(2, "--ttl-days must be an integer")
    if not 1 <= ttl_days <= 365:
        die(2, "--ttl-days must be between 1 and 365")
    close_when = (flags.get("--close-when") or "").strip()

    with RegisterLock():
        data = read_register()
        entry = find_set(data, factory)
        created = entry is None
        if not created and flags.get("--subject") is not None:
            # Defect reported 2026-09-28 (miidas): on an EXISTING set the flag
            # parsed, was never read, and the command exited 0 -- the caller's
            # unit key went nowhere, and only a read of the stored set showed
            # it. The set subject is CREATION-ONLY: it is recorded when the set
            # is minted, and a set names ONE unit, so a second value could not
            # describe a set holding questions about two. Refusing converts a
            # silent no-op into a loud one: a field that cannot be updated must
            # not read as one that can.
            die(2, "--subject is CREATION-ONLY: set %r already carries %r, and "
                   "a set names ONE unit. This add cannot change it, so the "
                   "value would be discarded rather than recorded. Omit "
                   "--subject, or name the unit in the question's own "
                   "title/description." % (factory, entry.get("subject")))
        if entry is None:
            entry = {
                "id": factory,
                # The lane that CREATED the standing set. Per-question lanes are
                # authoritative for grouping; this field records provenance.
                "lane": lane,
                "session": session,
                "subject": flags.get("--subject"),
                "asked_at": now_iso(),
                "ttl_days": ttl_days,
                "status": "open",
                "questions": [],
            }
            data["sets"].append(entry)
        if entry.get("status") != "open":
            # A factory set is never auto-closed, so this only happens after an
            # explicit archive. Reopening silently would resurrect questions the
            # owner already dismissed.
            die(1, f"factory set {factory!r} is {entry.get('status')!r} — reopen "
                   f"it explicitly before adding questions")
        # qids must be UNIQUE across the standing set, and order is the contract,
        # so the new questions continue the existing numbering rather than
        # restarting at q1.
        base = len(entry.get("questions", []))
        for offset, question in enumerate(questions):
            question["qid"] = "q%d" % (base + offset + 1)
            # Each question carries its OWN lane and session: one standing set
            # holds questions from many lanes, and the answer must return to the
            # lane that asked it, not to whoever created the set.
            question["lane"] = lane
            question["session"] = session
            question["asked_at"] = now_iso()
            if foreign_reason:
                # A deliberate cross-factory ask is RECORDED as one, so the
                # mismatch is visible on every later read instead of buried.
                question["cross_factory"] = True
                question["cross_factory_from"] = own_slug
                question["cross_factory_reason"] = foreign_reason
            if close_when:
                question.setdefault("close_when", close_when)
        entry["questions"].extend(questions)
        # ECHO what --recommended RESOLVED, read back from what was STORED
        # (#652). A caller who typed a label must see which option it became,
        # and echoing the stored value proves the RECORD rather than restating
        # the intention -- which is exactly what the silent wrong-base hid.
        resolved_recs = [(q.get("qid"), q.get("recommended"),
                          recommended_labels(q.get("options") or [],
                                             q.get("recommended")))
                         for q in questions]
        write_register_atomic(data)

    oc_log_extra("set", factory)
    oc_log_extra("questions", str(len(questions)))
    oc_log_extra("lane", lane)
    meta = republish(flags)
    page = (meta or {}).get("url")
    total, sets = open_totals()
    oc_log_extra("open_total", str(total))
    if flags.get("--json"):
        print(json.dumps({"set": factory, "factory": factory, "lane": lane,
                          "created": created, "registered": len(questions),
                          "open_questions": total, "open_sets": sets,
                          "page": page, "entry": entry},
                         indent=2, ensure_ascii=False))
    else:
        # C2 (owner order): give back the TOTAL, not a card payload. The page is
        # the surface now; the caller needs the count and the link.
        print(f"registered {len(questions)} question(s) in {factory} "
              f"(lane {lane}, ttl {ttl_days}d)")
        for _qid, _idx, _labels in resolved_recs:
            if _idx is None:
                continue
            if isinstance(_idx, list):
                _shown = ", ".join(f"[{i}] {lab!r}"
                                   for i, lab in zip(_idx, _labels))
            else:
                _shown = "[%s] %r" % (_idx, _labels[0] if _labels else None)
            print(f"  recommended {_qid}: {_shown}")
        print(f"{total} open question(s) across {sets} factory set(s)")
        if page:
            print(f"page {page}")
    return 0

# =============================================================================
# list — every parked decision, OLDEST FIRST (that ordering is the instrument)
# =============================================================================
def cmd_list(argv):
    _, flags = parse_flags(argv, *flag_spec("list"))
    with RegisterLock():
        data = read_register()
    all_sets = data["sets"]

    # #310: a filter that matches NOTHING must say so. Pre-fix `list --lane
    # no-such-lane` printed "0 open question(s) across 0 lane(s)" and exited 0,
    # which is indistinguishable from a lane that is merely empty -- so a typo
    # read as a clean answer. Existence is judged against the WHOLE register,
    # not the status-filtered view: a lane or factory whose questions are all
    # closed still EXISTS, and reporting it absent would be its own wrong answer.
    want_factory = (flags.get("--factory") or "").strip()
    if want_factory and not any(s.get("id") == want_factory for s in all_sets):
        die(1, "no-such-factory: %s" % want_factory)

    entries = all_sets
    if want_factory:
        entries = [s for s in entries if s.get("id") == want_factory]
    if "--all" not in flags:
        entries = [s for s in entries if s.get("status") == "open"]
    # --session is the RETURN ADDRESS, so it must select QUESTIONS, not sets
    # (#632, 2026-09-28). A standing factory set is created once by one lane and
    # then asked into by MANY, so comparing the SET's session against the caller
    # compares the CREATOR against the caller and returns zero for every
    # question's own author. Measured cost: a lane using `list` as its "have I
    # already asked this?" check saw 0 open, filed a duplicate, and put two
    # questions for one issue on the owner's page. This mirrors
    # question_return_address, the per-question rule notify already uses.
    want_session = (flags.get("--session") or "").strip()

    # Group by LANE, not by set (owner order 2026-09-25): one standing factory
    # set holds questions from many lanes, so the SET is not the unit a reader
    # cares about.
    lanes = {}
    for entry in entries:
        for question in entry.get("questions", []):
            if want_session:
                q_session = (question.get("session")
                             or entry.get("session") or "").strip()
                if q_session != want_session:
                    continue
            lane = question.get("lane") or entry.get("lane") or "unknown"
            lanes.setdefault(lane, []).append((entry, question))

    if flags.get("--lane"):
        want_lane = flags["--lane"].strip()
        # The lane's identity is the PAIR (factory, lane), so `--lane` accepts
        # EITHER the bare display name OR the qualified `<factory>/<lane>`. A
        # bare name that matches several lanes across the fleet is NOT an error
        # here -- `list` is a READ, and showing every Triage lane is honest.
        # What is an error is matching NOTHING: that is a typo, not a clean
        # answer, so it exits non-zero and names the filter.
        known = {(s.get("id"), q.get("lane") or s.get("lane") or "unknown")
                 for s in all_sets for q in s.get("questions", [])}
        if "/" in want_lane:
            lane_factory, _, lane_bare = want_lane.partition("/")
            if (lane_factory, lane_bare) not in known:
                die(1, "no-such-lane: %s" % want_lane)
            # Keep only the PAIRS whose entry is the named factory: `lanes` is
            # grouped by the BARE name, so the same key can hold questions from
            # several factories and dropping the key would drop the others too.
            lanes = {k: [(e, q) for (e, q) in v if e.get("id") == lane_factory]
                     for k, v in lanes.items() if k == lane_bare}
            lanes = {k: v for k, v in lanes.items() if v}
        else:
            if not any(name == want_lane for _f, name in known):
                die(1, "no-such-lane: %s" % want_lane)
            lanes = {k: v for k, v in lanes.items() if k == want_lane}

    # Counted AFTER the filter: the header must describe what is SHOWN, not the
    # fleet. Pre-fix `list --lane X` printed the fleet total against the
    # filtered lane count ("7 open ... across 1 lane(s)" for a lane holding
    # zero), which sends a reader looking for questions that are not there.
    # Same mis-scope reached --json (open_questions vs a filtered lanes[]).
    total_open = sum(1 for pairs in lanes.values() for (_e, q) in pairs
                     if not question_is_closed(q))

    if flags.get("--json"):
        rows = []
        for lane in sorted(lanes):
            pairs = lanes[lane]
            rows.append({
                "lane": lane,
                "anchor": lane_anchor(lane),
                "open": sum(1 for (_e, q) in pairs if not question_is_closed(q)),
                "total": len(pairs),
                "questions": [
                    {"set": entry.get("id"), "qid": question.get("qid"),
                     "title": question.get("title"),
                     "status": question.get("status"),
                     "kind": question.get("kind") or "single",
                     "age": fmt_age(question.get("asked_at")
                                    or entry.get("asked_at")),
                     "delivery": question.get("delivery")}
                    for (entry, question) in pairs],
            })
        print(json.dumps({"open_questions": total_open, "lanes": rows},
                         indent=2, ensure_ascii=False))
        return 0

    # C2 (owner order): the OPEN COUNT is the primary output.
    print(f"{total_open} open question(s) across {len(lanes)} lane(s)")
    for lane in sorted(lanes):
        pairs = lanes[lane]
        n_open = sum(1 for (_e, q) in pairs if not question_is_closed(q))
        n_closed = len(pairs) - n_open
        # A lane with 0 open still lists its answered rows (unless --quiet), so
        # the subtotal names that history rather than reading as a disagreement
        # between the heading and the rows beneath it.
        suffix = f", {n_closed} closed (history)" if n_closed and "--quiet" not in flags else ""
        print(f"{lane} — {n_open} open{suffix}")
        for (entry, question) in pairs:
            if "--quiet" in flags and question_is_closed(question):
                continue
            detail = (f"    {entry.get('id')} {question.get('qid')}  "
                      f"{question.get('title')}")
            if question.get("status") == "open":
                options = question.get("options") or []
                recommended = question.get("recommended")
                labels = recommended_labels(options, recommended)
                if labels:
                    detail += f"  (recommended: {', '.join(labels)})"
            else:
                detail += f"  -> {question.get('status')}"
                if (question.get("kind") or "single") == "multi":
                    detail += " [multi-select]"
                if question.get("answer") is not None:
                    detail += f": {question.get('answer')}"
                detail += delivery_note(question)
            print(detail)
    return 0

def archive_entries(data, entries):
    """Append closed sets to archive.jsonl, then drop them from the live
    register. Caller MUST hold the lock. Append-only, so an archive write
    cannot destroy a previously archived set."""
    if not entries:
        return 0
    ids = {e.get("id") for e in entries}
    os.makedirs(store_dir(), exist_ok=True)
    with open(archive_path(), "a", encoding="utf-8") as fh:
        for entry in entries:
            fh.write(json.dumps(entry, ensure_ascii=False) + "\n")
        fh.flush()
        os.fsync(fh.fileno())
    data["sets"] = [s for s in data["sets"] if s.get("id") not in ids]
    return len(ids)

# =============================================================================
# answer — record an answer against ONE question (card tap or page submit)
# =============================================================================
def cmd_answer(argv):
    positional, flags = parse_flags(argv, *flag_spec("answer"))
    if len(positional) < 2:
        die(2, "answer requires <set-id> <question-id> [choice-index|clarify]")
    set_id, qid = positional[0], positional[1]
    # Several choices arrive as several positionals or as one comma-joined
    # value, so `answer S q1 0 2` and `answer S q1 0,2` are the same act.
    choice = ",".join(positional[2:]) if len(positional) > 2 else None
    if flags.get("--clarify"):
        choice = "clarify"
    if choice is None and flags.get("--text") is None:
        die(2, "supply one or more choice indices, the literal 'clarify', or --text")
    via = flags.get("--via") or "cli"
    if via not in ("card", "page", "cli"):
        die(2, "--via must be card, page or cli")

    with RegisterLock():
        data = read_register()
        entry = find_set(data, set_id)
        if entry is None:
            die(1, f"no question set {set_id!r} in the register")
        question = find_question(entry, qid)
        if question is None:
            die(1, f"set {set_id} has no question {qid!r}")
        if question_is_closed(question):
            # Idempotent by contract: a re-submit says so, it does not mutate.
            # NOTE the predicate is CLOSED, not "not open": a CLARIFYING question
            # is still awaiting the owner's real answer and MUST stay answerable.
            # Keying on "not open" made a clarified question unanswerable forever.
            if flags.get("--json"):
                print(json.dumps({"set": set_id, "qid": qid,
                                  "status": question.get("status"),
                                  "answer": question.get("answer"),
                                  "idempotent": True}, indent=2))
            else:
                print(f"{set_id}/{qid} is already {question.get('status')} "
                      f"({question.get('answer')!r}) — re-submit ignored")
            return 3

        is_clarify = (str(choice).lower() == "clarify")
        text = (flags.get("--text") or "").strip()
        if is_clarify:
            # AN EMPTY CLARIFY IS A COMPLETE REQUEST (#183, 2026-09-26,
            # superseding the same-date refusal this block carried). Clarify
            # means the ASKING LANE widens its own question and re-asks in
            # clearer language; the owner's click says exactly that and owes
            # no payload — demanding --text demanded specification from the
            # wrong party. But the 2026-09-25 lesson underneath the old
            # refusal still binds (process law, shape (a): a state transition
            # must carry the content that justifies it): answer=None left the
            # asking lane holding "CLARIFY REQUESTED" with nothing to act on.
            # So when the owner supplies no text, the TOOL supplies the
            # click's meaning; owner text, when present, is the request
            # verbatim and wins.
            question["status"] = "clarifying"
            question["answer"] = text or CLARIFY_EMPTY_TEXT
            question["answer_kind"] = "clarify"
        else:
            options = question.get("options") or []
            kind = question.get("kind") or "single"
            indices = []
            if choice is not None:
                try:
                    indices = [int(piece) for piece in str(choice).split(",")
                               if piece.strip() != ""]
                except ValueError:
                    die(2, f"{choice!r} is neither an option index nor 'clarify'")
                if not indices:
                    die(2, "no option index given")
                if not options:
                    die(2, f"set {set_id}/{qid} has no options; answer with --text")
                for _i in indices:
                    if not 0 <= _i < len(options):
                        die(2, f"option {_i} is outside 0..{len(options) - 1}")
                if kind != "multi" and len(indices) > 1:
                    # The kind is fixed at ASK time, so an answer cannot widen it.
                    # Silently taking the first would record an answer the reader
                    # did not give, which is the class this instrument exists to
                    # remove.
                    die(2, f"{set_id}/{qid} is single-select and takes ONE option; "
                           f"got {len(indices)} ({choice!r})")
            # A TYPED ANSWER IS NEVER DISCARDED (owner report 2026-09-25). The
            # page pre-checks the recommended radio, so the browser always posts
            # a choice index; a filled text box therefore arrives with BOTH
            # fields set, and the old code took the index and dropped the text
            # silently. Text WINS when present; the selected index is kept as
            # context rather than lost.
            if text:
                question["answer"] = text
                question["answer_kind"] = "text"
                if indices:
                    # The NAME follows the kind, so an existing reader of a
                    # single-select question finds what it always found. A typed
                    # answer keeps the chosen index as context (owner rule: a
                    # typed answer is never discarded).
                    if kind == "multi":
                        question["selected_options"] = indices
                    else:
                        question["selected_option"] = indices[0]
            elif indices:
                if kind == "multi":
                    # A multi answer is a LIST, and answer_kind says so: a reader
                    # must be able to tell one label from several without
                    # inspecting the option set.
                    question["answer"] = [options[_i] for _i in indices]
                    question["answer_kind"] = "options"
                    question["selected_options"] = indices
                else:
                    question["answer"] = options[indices[0]]
                    question["answer_kind"] = "option"
                    question["selected_option"] = indices[0]
            else:
                question["answer"] = flags.get("--text")
                question["answer_kind"] = "text"
            question["status"] = "answered"
        question["answered_at"] = now_iso()
        question["answered_by"] = flags.get("--by")
        question["answered_via"] = via

        remaining = [q for q in entry.get("questions", [])
                     if not question_is_closed(q)]
        # A factory set is NEVER auto-archived (owner order 2026-09-25): it stays
        # open at 0..N questions, so the page and its ADDRESS are permanent.
        # Answering the last question leaves the set OPEN with 0 open questions;
        # its lane section stops rendering (owner order 2026-09-28), so the
        # section is explicitly NOT part of what "permanent" names here.
        archived = 0
        write_register_atomic(data)

    oc_log_extra("set", set_id)
    oc_log_extra("qid", qid)
    oc_log_extra("via", via)
    meta = republish(flags)
    page = (meta or {}).get("url")
    total, sets = open_totals()

    # `--notify` folds the delivery into this verb (S2, 2026-10-02). It runs
    # HERE -- after the RegisterLock() block has exited -- because deliver_answer
    # -> stamp_delivery takes RegisterLock itself and a nested acquire dies after
    # 10 s (die(4)). The flag is OPT-IN: with it absent this verb is byte-for-byte
    # what it was, so a caller that already runs `notify` (the cron sweep) is
    # unchanged and nothing is delivered twice. The exit code stays the
    # MUTATION's -- a failed delivery is DATA in the payload below, never an rc,
    # because the backend's confirmation has two branches and needs the fact.
    delivery = None
    if flags.get("--notify"):
        delivery = deliver_answer(set_id, qid, mode="turn-end")

    if flags.get("--json"):
        payload = {"set": set_id, "qid": qid, "status": question["status"],
                   "answer": question.get("answer"),
                   "remaining": len(remaining), "archived": archived,
                   "open_questions": total, "open_sets": sets,
                   "page": page}
        if delivery is not None:
            payload["delivery"] = delivery.get("delivery")
            payload["http"] = delivery.get("http")
            payload["delivered"] = delivery.get("delivery") == "delivered"
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        print(f"{set_id}/{qid} -> {question['status']}: {question.get('answer')!r}")
        if remaining:
            print(f"  {len(remaining)} question(s) still open in {set_id}")
        else:
            print(f"  {set_id} has no open questions (the set stays open)")
        print(f"{total} open question(s) across {sets} set(s)")
        if page:
            print(f"  page {page}")
        if delivery is not None:
            if delivery.get("error"):
                print(f"  delivery: NOT attempted -- {delivery['error']}")
            else:
                print(f"  delivery: {delivery.get('delivery')} "
                      f"(http {delivery.get('http')})")
    return 0

# =============================================================================
# amend — the CLARIFY path's return leg (#547 C5)
#
# A Clarify click records status=clarifying and the loop used to dead-end there:
# the owner never saw the answer and the question could not be answered again.
# amend edits the question and returns it to "open", so the loop closes.
# =============================================================================
def cmd_amend(argv):
    _, flags = parse_flags(argv, *flag_spec("amend"))
    set_id = (flags.get("--set") or "").strip()
    qid = (flags.get("--qid") or "").strip()
    if not set_id or not qid:
        die(2, "amend requires --set <id> --qid <qid>")
    fields = [k for k in ("--title", "--description", "--option",
                          "--recommended", "--clear-options")
              if k in flags]
    if not fields:
        die(2, "amend requires at least one of --title --description "
               "--option --recommended --clear-options")

    with RegisterLock():
        data = read_register()
        entry = next((s for s in data["sets"] if s.get("id") == set_id), None)
        if entry is None:
            die(1, f"no open question set {set_id!r}")
        question = next((q for q in entry.get("questions", [])
                         if q.get("qid") == qid), None)
        if question is None:
            die(1, f"set {set_id} has no question {qid!r}")

        changed = []
        if flags.get("--title"):
            question["title"] = flags["--title"]
            changed.append("title")
        if flags.get("--description"):
            question["description"] = flags["--description"]
            changed.append("description")
        if flags.get("--clear-options"):
            question["options"] = []
            question["recommended"] = None
            changed.append("options")
        options = flags.get("--option")
        if options:
            question["options"] = options if isinstance(options, list) else [options]
            changed.append("options")
        if flags.get("--recommended") is not None:
            index, rec_label = resolve_recommendation(
                flags["--recommended"], question.get("options") or [],
                f"{set_id}/{qid}", question.get("kind") or "single")
            question["recommended"] = index
            # Echo what it RESOLVED, so a caller who typed a label sees which
            # option it became rather than having to re-read the register.
            changed.append(f"recommended={index} ({rec_label})")

        # The whole point: the question becomes ANSWERABLE again.
        was = question.get("status")
        question["status"] = "open"
        question.pop("answer", None)
        # answer_kind must go WITH the answer. Leaving "clarify" (or "text" /
        # "option") on an OPEN, unanswered question is a record asserting
        # something untrue -- the same class this register exists to remove.
        # Found live 2026-09-25: q14 read status=open, answer=None, but
        # answer_kind="clarify" after a clarify was amended back open.
        question.pop("answer_kind", None)
        question["amend_count"] = int(question.get("amend_count") or 0) + 1
        if flags.get("--by"):
            question["amended_by"] = flags["--by"]
        entry["status"] = "open"
        write_register_atomic(data)

    oc_log_extra("set", set_id)
    oc_log_extra("qid", qid)
    meta = republish(flags)
    page = (meta or {}).get("url")
    if flags.get("--json"):
        print(json.dumps({"set": set_id, "qid": qid, "changed": changed,
                          "status": question["status"], "was": was,
                          "amend_count": question["amend_count"], "page": page},
                         indent=2, ensure_ascii=False))
    else:
        print(f"{set_id}/{qid} amended ({', '.join(changed)}) — "
              f"{was} -> open, amend #{question['amend_count']}")
        if page:
            print(f"  page {page}")
    return 0

# =============================================================================
# withdraw — retract a question that has become moot (HQ 2026-09-25)
#
# "withdrawn" was in CLOSED_STATUSES and named by the law, but NOTHING WROTE IT
# and --help listed no verb, so a lane whose question went moot had no way to
# take it off the owner's page: it sat there until TTL expired. A register the
# asker cannot correct is the noise it exists to remove.
# =============================================================================
def cmd_withdraw(argv):
    _, flags = parse_flags(argv, *flag_spec("withdraw"))
    set_id = (flags.get("--set") or "").strip()
    qid = (flags.get("--qid") or "").strip()
    if not set_id or not qid:
        die(2, "withdraw requires --set <id> --qid <qid>")

    with RegisterLock():
        data = read_register()
        entry = next((s for s in data["sets"] if s.get("id") == set_id), None)
        if entry is None:
            die(1, f"no open question set {set_id!r}")
        question = next((q for q in entry.get("questions", [])
                         if q.get("qid") == qid), None)
        if question is None:
            die(1, f"set {set_id} has no question {qid!r}")
        if question_is_closed(question):
            # Idempotent, like answer: a re-withdraw says so, it does not mutate.
            if flags.get("--json"):
                print(json.dumps({"set": set_id, "qid": qid,
                                  "status": question.get("status"),
                                  "idempotent": True}, indent=2))
            else:
                print(f"{set_id}/{qid} is already {question.get('status')} "
                      f"-- re-withdraw ignored")
            return 3
        was = question.get("status")
        question["status"] = "withdrawn"
        if flags.get("--text"):
            question["withdrawn_reason"] = flags["--text"]
        if flags.get("--by"):
            question["withdrawn_by"] = flags["--by"]
        write_register_atomic(data)

    oc_log_extra("set", set_id)
    oc_log_extra("qid", qid)
    meta = republish(flags)
    page = (meta or {}).get("url")
    total, sets = open_totals()
    if flags.get("--json"):
        print(json.dumps({"set": set_id, "qid": qid, "status": "withdrawn",
                          "was": was, "open_questions": total,
                          "open_sets": sets, "page": page},
                         indent=2, ensure_ascii=False))
    else:
        print(f"{set_id}/{qid} withdrawn ({was} -> withdrawn)")
        print(f"{total} open question(s) across {sets} set(s)")
        if page:
            print(f"  page {page}")
    return 0

# =============================================================================
# lint — the register must not carry a uuid, a secret, or a broken predicate
# =============================================================================
def cmd_lint(argv):
    _, flags = parse_flags(argv, *flag_spec("lint"))
    with RegisterLock():
        data = read_register()
    findings = []
    for entry in data["sets"]:
        set_id = entry.get("id")
        lane = str(entry.get("lane") or "")
        if UUID_RE.search(lane):
            findings.append({"set": set_id, "qid": "-",
                             "why": "lane is a session id, not a topic NAME"})
        if not str(entry.get("session") or "").strip():
            findings.append({"set": set_id, "qid": "-",
                             "why": "missing return address (session)"})
        for question in entry.get("questions", []):
            qid = question.get("qid")
            blob = f"{question.get('title', '')}\n{question.get('description', '')}"
            if SECRET_RE.search(blob):
                findings.append({"set": set_id, "qid": qid,
                                 "why": "text matches the no-secrets pattern"})
            options = question.get("options") or []
            if options and question.get("recommended") is None:
                findings.append({"set": set_id, "qid": qid,
                                 "why": "options without a recommendation"})
    if flags.get("--json"):
        print(json.dumps({"findings": findings, "count": len(findings)}, indent=2))
    elif not findings:
        print("lint clean — no uuid lanes, no secrets, no unresolved predicates")
    else:
        for item in findings:
            print(f"FINDING {item['set']}/{item['qid']}: {item['why']}")
        print(f"-- {len(findings)} finding(s)")
    return 1 if findings else 0

# =============================================================================
# gc — archive expired and fully-closed sets
# =============================================================================
def cmd_gc(argv):
    _, flags = parse_flags(argv, *flag_spec("gc"))
    now = datetime.datetime.now(datetime.timezone.utc)
    with RegisterLock():
        data = read_register()
        mechanical, pred_notes = apply_mechanical_closures(data)
        expired = []
        for entry in data["sets"]:
            if entry.get("status") != "open":
                continue
            ttl = int(entry.get("ttl_days") or DEFAULT_TTL_DAYS)
            for question in entry.get("questions", []):
                if question_is_closed(question):
                    continue
                asked = parse_iso(question.get("asked_at") or entry.get("asked_at"))
                if not asked:
                    continue
                if asked.tzinfo is None:
                    asked = asked.replace(tzinfo=datetime.timezone.utc)
                if now >= asked + datetime.timedelta(days=ttl):
                    # TTL expires the QUESTION, never the SET (owner order
                    # 2026-09-25). A factory set stays open at 0..N so the page
                    # and its lane anchors remain permanent.
                    question["status"] = "expired"
                    question["expired_at"] = now_iso()
                    expired.append("%s %s" % (entry.get("id"), question.get("qid")))
        closed = [s for s in data["sets"] if set_is_closed(s)]
        closed_ids = {s.get("id") for s in closed}
        if flags.get("--dry-run"):
            moved = 0
        else:
            if mechanical or pred_notes or expired:
                write_register_atomic(data)
            # A factory set is NEVER auto-archived: only an explicit request
            # moves one out of the live register.
            victims = closed if flags.get("--archive-closed") else []
            moved = archive_entries(data, victims)
            if moved:
                write_register_atomic(data)
    if flags.get("--json"):
        print(json.dumps({"expired": len(expired),
                          "expired_questions": expired,
                          "closed": len(closed_ids),
                          "mechanically_closed": mechanical,
                          "predicate_notes": pred_notes,
                          "archived": moved,
                          "dry_run": bool(flags.get("--dry-run"))}, indent=2))
    else:
        print(f"gc: {len(expired)} question(s) expired, {len(closed_ids)} "
              f"set(s) with no open questions, {moved} archived"
              + (" (dry run — nothing written)" if flags.get("--dry-run") else ""))
        for item in expired:
            print(f"  expired: {item}")
        for item in mechanical:
            print(f"  closed mechanically: {item}")
        for note in pred_notes:
            print(f"  SKIP {note}")
    return 0

# =============================================================================
# notify — the RETURN PATH (#547). An answer must reach the calling session.
# =============================================================================
# Delivery is a SEPARATE verb, never folded into `answer`. `answer` is a pure
# state mutation that holds RegisterLock; a network call inside that lock would
# hold it for up to A2A_TIMEOUT seconds and block every other lane's ask/list —
# on a store whose entire point is concurrent safety. Keeping it separate also
# keeps rc honest: a delivery fault must not read as an answer fault.
#
# The destination is ALWAYS the session recorded in the register — never a
# caller-supplied id, never a field from a browser. That is the security
# property: a page or a card tap cannot redirect an answer to a third party.
# There is deliberately no --session flag on this verb.
#
# Transport is the A2A gateway, NOT `opencrabs session notify`: the CLI hangs on
# this host (rc=124, enqueues nothing) — fork issue #412.
A2A_URL = os.environ.get("OC_QUESTIONS_A2A") or "http://127.0.0.1:18791/a2a/v1"
A2A_TIMEOUT = int(os.environ.get("OC_QUESTIONS_A2A_TIMEOUT") or "20")
NOTIFY_BODY_MAX = 3000

def load_all_sets():
    """Open sets PLUS archived ones. An answered set is normally ARCHIVED, so a
    reader that only opens open.json cannot deliver the one answer that matters."""
    sets = list(read_register()["sets"])
    try:
        with open(archive_path(), encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line:
                    continue
                try:
                    sets.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except FileNotFoundError:
        pass
    return sets

def find_set_anywhere(set_id):
    for entry in load_all_sets():
        if entry.get("id") == set_id:
            return entry
    return None

def compose_answer_body(entry, qid=None):
    answered = answerable_questions(entry, qid)
    if not answered:
        return None
    # The lane comes from the ANSWERING questions, not from the set: one
    # standing factory set holds questions from many lanes, and the set's own
    # lane is only whoever created it. Naming the set's lane here would
    # misattribute the answer to the wrong lane.
    lanes = []
    for question in answered:
        lane = question.get("lane") or entry.get("lane") or "unknown"
        if lane not in lanes:
            lanes.append(lane)
    lines = ["Open Questions — answer received (set %s, lane %s)"
             % (entry.get("id"), ", ".join(lanes)), ""]
    for question in answered:
        lines.append("%s. %s" % (question.get("qid"), question.get("title")))
        if question.get("answer") is None:
            lines.append("   -> CLARIFY REQUESTED")
        else:
            lines.append("   -> %s" % (question.get("answer"),))
        if question.get("answer_text"):
            lines.append("   text: %s" % (question["answer_text"],))
        lines.append("")
    body = "\n".join(lines).strip()
    if len(body) > NOTIFY_BODY_MAX:
        body = body[:NOTIFY_BODY_MAX] + " (truncated)"
    return body

def answerable_questions(entry, qid=None):
    """The questions a delivery BODY carries: answered, or awaiting a clarify.
    Extracted so the body and the delivery stamp cannot disagree about which
    questions were actually in the message."""
    questions = entry.get("questions") or []
    if qid:
        questions = [q for q in questions if q.get("qid") == qid]
    return [q for q in questions
            if q.get("answer") is not None
            or q.get("status") in ("clarifying", "clarified")]

def delivery_outcome(status):
    """HTTP status -> the vocabulary the register records."""
    if 200 <= status < 300:
        return "delivered"
    if status == 0:
        return "unreachable"
    return "refused"

def stamp_delivery(set_id, qids, outcome, http, mode):
    """Record that a delivery was ATTEMPTED and what happened. Returns the count
    stamped, or None when the set is not in the live register.

    A consequence is not a receipt: "answered" says the register closed the
    question, not that the lane ever saw the answer. Only a delivery knows, so
    only a delivery can record it.

    ATTEMPTS is cumulative, and its default for a PRE-EXISTING stamp is 1: a
    stamp that carries no counter was written before this key existed, and it
    records one attempt. A missing `delivery` object is 0 -- nothing was tried.

    BOUND: this stamps the LIVE register. A set that has been archived carries
    its questions in archive.jsonl, which this does not rewrite -- an archive is
    history, and rewriting history to record a delivery would be worse than the
    gap it closes.
    """
    with RegisterLock():
        data = read_register()
        live = next((s for s in data["sets"] if s.get("id") == set_id), None)
        if live is None:
            return None
        targets = answerable_questions(live) if qids is None else [
            q for q in (live.get("questions") or []) if q.get("qid") in qids]
        for question in targets:
            prior = question.get("delivery") or {}
            prior_attempts = prior.get("attempts")
            if prior_attempts is None:
                prior_attempts = 1 if prior else 0
            question["delivery"] = {"attempted_at": now_iso(), "outcome": outcome,
                                    "http": http, "mode": mode,
                                    "attempts": prior_attempts + 1}
        write_register_atomic(data)
        return len(targets)

def delivery_note(question):
    """How the register read renders delivery. An answer with no stamp reads as
    NOT RECORDED rather than as delivered -- the absence is the finding, so it
    is printed rather than omitted."""
    delivery = question.get("delivery") or {}
    if not delivery:
        return "  [delivery: NOT RECORDED]"
    if delivery.get("outcome") == "delivered":
        return "  [delivered %s]" % (delivery.get("attempted_at") or "?")
    return "  [delivery FAILED: %s %s]" % (delivery.get("outcome"),
                                           delivery.get("attempted_at") or "?")

def a2a_deliver(session, body, mode="turn-end"):
    import urllib.error
    import urllib.request
    payload = {"jsonrpc": "2.0", "id": "1", "method": "session/notify",
               "params": {"session_id": session, "message": body, "mode": mode}}
    request = urllib.request.Request(
        A2A_URL, data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=A2A_TIMEOUT) as response:
            return response.status, response.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read().decode("utf-8", "replace")
    except Exception as exc:  # noqa: BLE001
        return 0, "transport error: %s" % (exc,)

def deliver_answer(set_id, qid=None, mode="turn-end", dry_run=False, entry=None):
    """Resolve -> compose -> deliver -> stamp, for ONE question (qid given) or a
    batch (qid None). THE single delivery path: `notify` formats one result for
    a caller, `redeliver` calls it in a loop over the pending population.

    Returns a dict. Per-question failures come back as {"error","rc"} rather
    than raising, because a sweep must not die on one bad address -- but the
    CALLER decides how loud that is. `notify` dies on the first error exactly as
    it always did; `redeliver` records it and carries on.
    """
    if entry is None:
        entry = find_set_anywhere(set_id)
        if entry is None:
            return {"error": "no question set %s in the register or the archive"
                             % (set_id,), "rc": 1}
    if qid:
        session, lane_name, why = question_return_address(entry, qid)
        if why:
            return {"error": why, "rc": 1}
    else:
        # No --qid: the destination must be the session every answered question
        # shares, never the set's own by default (#612).
        session, why = batch_return_address(entry)
        if why:
            return {"error": why, "rc": 1}
        lane_name = entry.get("lane") or "unknown"
    if not UUID_RE.fullmatch(session):
        # Refuse rather than guess: a wrong destination leaks an answer to an
        # unrelated lane, and the register is the only authority for it.
        return {"error": "set %s records no usable calling session for qid %s — "
                         "refusing to guess a destination"
                         % (entry.get("id"), qid), "rc": 3}
    body = compose_answer_body(entry, qid)
    if body is None:
        return {"error": "no answer recorded yet for set %s" % (entry.get("id"),),
                "rc": 1}

    result = {"set": entry.get("id"), "qid": qid, "session": session,
              "lane": lane_name, "mode": mode, "body": body, "rc": 0}
    if dry_run:
        result["dry_run"] = True
        return result

    status, response = a2a_deliver(session, body, mode)
    result["http"] = status
    result["response"] = response
    result["delivery"] = delivery_outcome(status)

    # Stamp the ATTEMPT on the questions the body carried. A delivery the exit
    # code reports and the register forgets leaves a lane blocked while every
    # surface it can read says the question is closed.
    result["stamped"] = stamp_delivery(
        entry.get("id"),
        [q.get("qid") for q in answerable_questions(entry, qid)],
        result["delivery"], status, mode)

    result["rc"] = 4 if status == 0 else (3 if status >= 400 else 0)
    return result

def cmd_notify(argv):
    positional, flags = parse_flags(argv, *flag_spec("notify"))
    set_id = flags.get("--set") or (positional[0] if positional else None)
    lane = flags.get("--lane")
    if not set_id and not lane:
        die(2, "notify requires --set <set-id> or --lane <NAME>")
    mode = flags.get("--mode") or "turn-end"
    if mode not in ("turn-end", "interrupt", "quiet"):
        die(2, "--mode must be turn-end, interrupt or quiet")

    if set_id:
        entry = find_set_anywhere(set_id)
    else:
        entry, lane_error = resolve_lane_target(lane)
        if lane_error:
            die(lane_error[0], lane_error[1])
    if entry is None:
        die(1, "no question set %s in the register or the archive"
            % (set_id or lane,))

    result = deliver_answer(entry.get("id"), flags.get("--qid"), mode,
                            bool(flags.get("--dry-run")), entry=entry)
    if result.get("error"):
        die(result["rc"], result["error"])

    if flags.get("--dry-run"):
        if flags.get("--json"):
            print(json.dumps({"set": result["set"], "session": result["session"],
                              "mode": result["mode"], "body": result["body"]},
                             indent=2, ensure_ascii=False))
        else:
            print("would notify %s (set %s, %s):\n\n%s"
                  % (result["lane"], result["set"], result["mode"],
                     result["body"]))
        return 0

    if flags.get("--json"):
        print(json.dumps({"set": result["set"], "session": result["session"],
                          "mode": result["mode"], "http": result["http"],
                          "response": result["response"],
                          "delivery": result["delivery"],
                          "stamped": result["stamped"]},
                         indent=2, ensure_ascii=False))
    else:
        note = ("stamped %d question(s) as %s"
                % (result["stamped"], result["delivery"])) if result["stamped"] \
               else "not stamped: the set is not in the live register"
        print("notified %s (set %s) — http %s (%s)"
              % (result["lane"], result["set"], result["http"], note))
    return result["rc"]

# =============================================================================
# redeliver — retry the deliveries the register RECORDS as failed
# =============================================================================
# The delivery stamp landed in e109b44 (2026-09-28T22:35:34+00:00). Before that
# instant a question could be answered and notified with nothing written down,
# so a question answered BEFORE it and carrying no stamp is not evidence of a
# failed delivery -- it is evidence of a register that had nowhere to write.
# 50 such questions sit in the live register. This boundary is a fact about the
# CODE, not about the data, which is why it is a constant and not a flag.
DELIVERY_STAMP_EPOCH = "2026-09-28T22:35:34+00:00"
DEFAULT_MAX_ATTEMPTS = 3

def _answered_at(question):
    return question.get("answered_at") or question.get("asked_at") or ""

def pending_deliveries():
    """The questions a redelivery sweep should retry, as
    (pending, skipped) where pending is [{set, qid, why, attempts}] and skipped
    is the count of questions the predicate deliberately did NOT pick up.

    TWO classes qualify, and the difference between them is the whole design:

      unreachable -- a delivery was ATTEMPTED and the transport failed. The
                     register recorded that failure, so retrying it reads back a
                     fact instead of guessing at one.
      unattempted -- no delivery object at all on a question answered AFTER the
                     stamp existed. A live set is stamped on EVERY attempt, so
                     the record can only be silent for a question nothing was
                     ever attempted for. Absence before the epoch is NOT this
                     class (see DELIVERY_STAMP_EPOCH).

    `delivered` and `refused` are NEVER retried, and that is the idempotency
    guard #251 asks for: the stamp is written on every attempt and READ here, so
    a sweep cannot re-deliver what already landed. `refused` means an HTTP
    answer arrived -- the transport worked and the address is what is wrong, so
    a retry would repeat the same refusal.

    `skipped` exists so the sweep can SAY what it did not do. A silent filter
    and an empty population print the same thing, and only one of them is a
    finding.
    """
    out, skipped = [], 0
    for entry in read_register()["sets"]:
        for question in answerable_questions(entry):
            delivery = question.get("delivery") or {}
            outcome = delivery.get("outcome")
            if outcome in ("delivered", "refused"):
                continue
            if outcome == "unreachable":
                why = "unreachable"
            elif not delivery and _answered_at(question) >= DELIVERY_STAMP_EPOCH:
                why = "unattempted"
            elif not delivery:
                # Answered before the stamp existed: the register had nowhere to
                # write. Absence here is not evidence of a failure, so it is
                # counted and named rather than retried.
                skipped += 1
                continue
            else:
                continue
            prior = delivery.get("attempts")
            if prior is None:
                prior = 1 if delivery else 0
            out.append({"set": entry.get("id"), "qid": question.get("qid"),
                        "why": why, "attempts": prior})
    return out, skipped

def cmd_redeliver(argv):
    positional, flags = parse_flags(argv, *flag_spec("redeliver"))
    if positional:
        die(2, "redeliver takes no positional argument; the selector is "
               "--pending")
    raw_max = flags.get("--max-attempts")
    if raw_max is not None:
        try:
            max_attempts = int(raw_max)
        except ValueError:
            die(2, "--max-attempts must be an integer, got %r" % (raw_max,))
    else:
        max_attempts = DEFAULT_MAX_ATTEMPTS
    if max_attempts < 1:
        die(2, "--max-attempts must be at least 1")
    mode = flags.get("--mode") or "turn-end"
    if mode not in ("turn-end", "interrupt", "quiet"):
        die(2, "--mode must be turn-end, interrupt or quiet")
    dry_run = bool(flags.get("--dry-run"))

    pending, skipped = pending_deliveries()
    ready = [p for p in pending if p["attempts"] < max_attempts]
    # EXHAUSTED is a REPORTED state, never a silent drop: a sweep that stops
    # trying without saying so turns a live blockage into a quiet one.
    exhausted = [p for p in pending if p["attempts"] >= max_attempts]

    if dry_run:
        if flags.get("--json"):
            print(json.dumps({"pending": len(pending), "ready": ready,
                              "exhausted": exhausted, "max_attempts": max_attempts,
                              "not_retried_pre_epoch": skipped,
                              "mode": mode, "dry_run": True},
                             indent=2, ensure_ascii=False))
        else:
            print("would redeliver %d question(s) (max-attempts %d, %s):"
                  % (len(ready), max_attempts, mode))
            for item in ready:
                print("  %s %s (%s, attempts=%d)"
                      % (item["set"], item["qid"], item["why"], item["attempts"]))
            for item in exhausted:
                print("  EXHAUSTED %s %s (attempts=%d)"
                      % (item["set"], item["qid"], item["attempts"]))
            if skipped:
                print("  NOT retried: %d question(s) answered before the "
                      "delivery stamp existed — absence there is not evidence "
                      "of a failed delivery" % (skipped,))
        return 1 if exhausted else 0

    results = []
    for item in ready:
        result = deliver_answer(item["set"], item["qid"], mode, False,
                                entry=find_set_anywhere(item["set"]))
        result["why"] = item["why"]
        results.append(result)

    delivered = [r for r in results if r.get("delivery") == "delivered"]
    unreachable = [r for r in results if r.get("delivery") == "unreachable"]
    refused = [r for r in results
               if r.get("delivery") == "refused" or r.get("rc") == 3]

    if exhausted:
        rc = 1
    elif refused:
        rc = 3
    elif unreachable:
        rc = 4
    else:
        rc = 0

    if flags.get("--json"):
        print(json.dumps({"pending": len(pending), "attempted": len(results),
                          "delivered": len(delivered),
                          "unreachable": len(unreachable),
                          "refused": len(refused),
                          "exhausted": exhausted,
                          "not_retried_pre_epoch": skipped,
                          "results": results, "rc": rc},
                         indent=2, ensure_ascii=False))
        return rc
    if not pending:
        print("redeliver: nothing pending — no delivery is recorded as failed")
        if skipped:
            print("redeliver: %d question(s) NOT retried — answered before the "
                  "delivery stamp existed, so their silence is not a finding"
                  % (skipped,))
        return 0
    print("redeliver: %d pending, %d attempted — %d delivered, %d still "
          "unreachable, %d refused, %d exhausted (max-attempts %d)"
          % (len(pending), len(results), len(delivered), len(unreachable),
             len(refused), len(exhausted), max_attempts))
    if skipped:
        print("redeliver: %d question(s) NOT retried — answered before the "
              "delivery stamp existed, so their silence is not a finding"
              % (skipped,))
    for item in exhausted:
        print("  EXHAUSTED %s %s after %d attempt(s) — needs a human"
              % (item["set"], item["qid"], item["attempts"]))
    for result in results:
        if result.get("error"):
            print("  FAILED %s %s: %s" % (result["set"], result["qid"],
                                          result["error"]))
    return rc

