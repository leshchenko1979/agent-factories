def selftest():
    import shutil
    import subprocess

    fails = []

    def ck(cond, msg):
        print(("  ok   - " if cond else "  FAIL - ") + msg)
        if not cond:
            fails.append(msg)

    tool = os.path.abspath(__file__)
    root = tempfile.mkdtemp(prefix="questions-selftest-")
    env = dict(os.environ)
    env["OC_QUESTIONS_DIR"] = os.path.join(root, "store")
    env["OC_TOOLS_NOLOG"] = "1"
    env["OC_QUESTIONS_BASE_URL"] = PRODUCTION_BASE_URL
    # The asking session comes from the ENV and the lane is resolved from that
    # session's OWN binding, so the fixture needs a REAL session DB. Two bound
    # sessions (different lanes -- the multi-lane page) and one deliberately
    # UNBOUND (the refusal leg).
    session_a = "11111111-2222-3333-4444-555555555555"
    session_b = "aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"
    session_unbound = "99999999-8888-7777-6666-555555555555"
    fixture_db = os.path.join(root, "sessions.db")
    env["OC_QUESTIONS_DB"] = fixture_db
    env["OPENCRABS_SESSION_ID"] = session_a
    import sqlite3 as _sqlite3
    _db = _sqlite3.connect(fixture_db)
    _db.executescript(
        "create table session_bindings (session_id text primary key, "
        "channel text not null, chat_id text not null, thread_id integer, "
        "updated_at integer not null default 0);"
        "create table channel_messages (id text primary key, channel text not null, "
        "channel_chat_id text not null, topic_name text, created_at integer not null, "
        "thread_id text);")
    for _sid, _tid, _name in ((session_a, 39171, "Carrier tools"),
                              (session_b, 43993, "Governance: Ontology & RSI")):
        _db.execute("insert into session_bindings (session_id,channel,chat_id,"
                    "thread_id,updated_at) values (?,?,?,?,0)",
                    (_sid, "telegram", "-1003936827469", _tid))
        _db.execute("insert into channel_messages (id,channel,channel_chat_id,"
                    "topic_name,created_at,thread_id) values (?,?,?,?,?,?)",
                    ("m-%d" % _tid, "telegram", "-1003936827469", _name, 1000,
                     str(_tid)))
    _db.commit()
    _db.close()
    # The Node renderer resolves its bare imports against node_modules BESIDE
    # the render file, so the fixture links the real installed tree into its own
    # render dir. A symlink keeps the test from writing the live store while
    # still exercising the json-render path rather than silently falling back.
    fixture_render = os.path.join(root, "render")
    real_modules = os.path.join(profile_home(), "questions", "build", "node_modules")
    try:
        os.makedirs(fixture_render, exist_ok=True)
        link = os.path.join(fixture_render, "node_modules")
        if os.path.isdir(real_modules) and not os.path.exists(link):
            os.symlink(real_modules, link)
    except OSError:
        pass
    env["OC_QUESTIONS_RENDER_DIR"] = fixture_render

    def run(*args):
        proc = subprocess.run([tool] + list(args), env=env, capture_output=True,
                              text=True, timeout=90)
        return proc.returncode, proc.stdout, proc.stderr

    def store_json():
        with open(os.path.join(env["OC_QUESTIONS_DIR"], "open.json"),
                  encoding="utf-8") as fh:
