def flag_spec(verb):
    """(valued_flags, boolean_flags) for one verb, from the ONE table (#709).

    The handlers want FLAG NAMES; the bridge wants the param->flag MAP. Both
    come from the same table -- `flag_spec` flattens it, `schema_payload`
    publishes it whole.
    """
    spec = FLAG_SPEC[verb]
    return list(spec["valued"].values()), list(spec["boolean"].values())


# Which params arrive as POSITIONAL arguments rather than as flags, and whether
# each is required. The CLI publishes this machine-readably so the bridge does
# not have to parse the human `positional` string -- a hand-kept mirror of a
# parser is the defect class #709 is about, and a positional is as much a part
# of the contract as a flag. `answer` takes its choice as a third positional
# when one is given; `notify` may address a set positionally.
POSITIONAL_PARAMS = {
    "answer": [("set_id", True), ("qid", True), ("choice", False)],
    "notify": [("set_id", False)],
}


def schema_payload():
    """The machine-readable flag schema, for the dynamic-tool bridge (#709).

    `valued`/`boolean` are param->flag MAPS, not bare flag lists: the bridge
    cannot recover `set_id` -> `--set` from a flag name alone, and guessing it
    with a dash rule is how a caller's param goes missing. `store` is published
    so a caller can watch the register across a call: the bridge uses it to
    tell a timed-out write that LANDED from one that never started, instead of
    reporting a bare failure over a settled mutation.
    """
    return {
        "prog": PROG,
        "version": VERSION,
        "verbs": {
            verb: {
                "valued": dict(spec["valued"]),
                "boolean": dict(spec["boolean"]),
                "positional": spec["positional"],
                "positional_params": [
                    {"name": name, "required": required}
                    for name, required in POSITIONAL_PARAMS.get(verb, [])
                ],
            }
            for verb, spec in FLAG_SPEC.items()
        },
        "store": store_path(),
        "archive": archive_path(),
    }


