def inline_md(text):
    """Escape FIRST, then apply the two inline forms worth having. The page is
    world-readable, so nothing reaches the output unescaped."""
    safe = html.escape(str(text), quote=False)
    safe = re.sub(r"\*\*(.+?)\*\*", r"<b>\1</b>", safe)
    safe = re.sub(r"`([^`]+?)`", r"<code>\1</code>", safe)
    return safe

_INLINE_RE = re.compile(r"(\*\*.+?\*\*|`[^`]+?`|\*[^*\n]+?\*)")

def inline_spans(text):
    """Inline emphasis -> typed SPANS, never an HTML fragment.

    React escapes text nodes itself, so the old escape-then-inject round trip
    disappears along with dangerouslySetInnerHTML. Returns a list of
    {kind, text} dicts the renderer maps to strong/em/code/span."""
    spans = []
    for part in _INLINE_RE.split(str(text or "")):
        if not part:
            continue
        if part.startswith("**") and part.endswith("**") and len(part) > 4:
            spans.append({"kind": "Strong", "text": part[2:-2]})
        elif part.startswith("`") and part.endswith("`") and len(part) > 2:
            spans.append({"kind": "InlineCode", "text": part[1:-1]})
        elif part.startswith("*") and part.endswith("*") and len(part) > 2:
            spans.append({"kind": "Emphasis", "text": part[1:-1]})
        else:
            spans.append({"kind": "Text", "text": part})
    return spans

def parse_blocks(markdown):
    """Markdown -> typed BLOCK DATA. A bounded parser, NOT a Markdown engine.

    Fenced blocks, tables, headings, lists and paragraphs -- the same surface the
    old HTML builder covered -- but returned as (type, props) pairs the spec turns
    into catalog elements. An unknown type is then REJECTED by the catalog rather
    than injected, which is the point of the rewrite.

    Bounded by design: no nested lists, no block quotes, no reference links. A
    richer parser is a renderer's job if wanted."""
    lines = str(markdown or "").split("\n")
    blocks, index = [], 0
    while index < len(lines):
        stripped = lines[index].strip()
        if stripped.startswith("```"):
            lang = stripped[3:].strip()
            body, index = [], index + 1
            while index < len(lines) and not lines[index].strip().startswith("```"):
                body.append(lines[index])
                index += 1
            index += 1
            joined = "\n".join(body)
            if lang == "mermaid":
                blocks.append(("Mermaid", {"code": joined}))
            else:
                blocks.append(("CodeBlock", {"lang": lang, "code": joined}))
            continue
        if stripped.startswith("|") and stripped.endswith("|"):
            rows = []
            while index < len(lines) and lines[index].strip().startswith("|"):
                rows.append(lines[index].strip())
                index += 1
            cells = [[c.strip() for c in r.strip("|").split("|")] for r in rows]
            body = [c for c in cells
                    if not all(x and set(x) <= set("-: ") for x in c)]
            if body:
                blocks.append(("Table", {
                    "headers": [inline_spans(c) for c in body[0]],
                    "rows": [[inline_spans(c) for c in row] for row in body[1:]]}))
            continue
        heading = re.match(r"^(#{1,3}) (.+)$", stripped)
        if heading:
            blocks.append(("Heading", {"level": len(heading.group(1)),
                                       "text": heading.group(2)}))
            index += 1
            continue
        bullet = re.match(r"^(?:[-*]|\d+[.)]) (.+)$", stripped)
        if bullet:
            ordered = bool(re.match(r"^\d+[.)] ", stripped))
            items = []
            while index < len(lines):
                item = re.match(r"^(?:[-*]|\d+[.)]) (.+)$", lines[index].strip())
                if not item:
                    break
                items.append(inline_spans(item.group(1)))
                index += 1
            blocks.append(("List", {"items": items, "ordered": ordered}))
            continue
        if stripped:
            blocks.append(("Paragraph", {"spans": inline_spans(stripped)}))
        index += 1
    return blocks

# ---------------------------------------------------------------- json-render
# The page is built as a typed SPEC and rendered by a Node process. The catalog
# in questions-render.mjs is a GUARDRAIL: a spec can only name a component
# registered there, so an unknown type is rejected rather than rendering
# nothing. The spec is therefore testable data -- its structure can be asserted
# without parsing HTML.
RENDER_SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                          "questions-render.mjs")
# The Node process needs node_modules beside it, so it runs from the build dir.
# Overridable so the selftest can point at a scratch tree.
RENDER_TIMEOUT = 30

def render_dir():
    return (os.environ.get("OC_QUESTIONS_RENDER_DIR")
            or os.path.join(store_dir(), "build"))

def build_spec(entries, slug, expires_at, action):
    """The page as a json-render spec. FLAT: every element keyed in `elements`,
    children are KEYS, and `root` names the top element.

    Sections are per LANE, not per set (owner order 2026-09-25): one standing
    factory set holds questions from many lanes, and the owner addresses a
    sub-part of the page by LANE ANCHOR. A lane renders while it has an OPEN
    question (owner order 2026-09-28): an all-answered lane is NOT rendered, so
    the page never carries a block reporting nothing. That SUPERSEDES the
    earlier rule that an all-answered lane kept its section for the sake of a
    handed-out anchor -- the page is what the owner reads.

    `slug` rides in the form's `token` field: the answer backend's token check
    is a SLUG check now. The field NAME is unchanged because that is the wire
    contract the backend reads.
    """
    elements = {}
    section_keys = []
    # ONE pass, grouped by LANE across the WHOLE page. Grouping per (set, lane)
    # made two sets from the same lane collide on one anchor: the element was
    # overwritten and its key appended twice, so the page rendered one section
    # N times and every other set's questions vanished. A page-wide group makes
    # the anchor unique by construction.
    by_lane = {}
    for entry in entries:
        for question in entry.get("questions", []):
            lane = question.get("lane") or entry.get("lane") or "unknown"
            by_lane.setdefault(lane, []).append((entry, question))
    for lane in sorted(by_lane):
        anchor = lane_anchor(lane)
        question_keys = []
        for (entry, question) in by_lane[lane]:
                if question_is_closed(question):
                    continue
                set_id = entry["id"]
                qid = question["qid"]
                base = "%s-%s" % (set_id, qid)
                options = question.get("options") or []
                recommended = question.get("recommended")
                rec_set = set(recommended_indices(recommended))
                # Absent means SINGLE (owner order 2026-09-28) -- the store's 44
                # pre-existing questions carry no kind and must keep rendering
                # radios, so the default lives here as well as in normalise.
                is_multi = (question.get("kind") or "single") == "multi"
                # One element per BLOCK, in document order: the description is no
                # longer a single opaque fragment but typed children of the question.
                children = []
                for position, (btype, bprops) in enumerate(
                        parse_blocks(question.get("description") or "")):
                    key = "%s-b%d" % (base, position)
                    elements[key] = {"type": btype, "props": bprops, "children": []}
                    children.append(key)
                for index in range(len(options)):
                    key = "%s-o%d" % (base, index)
                    elements[key] = {
                        "type": "Option",
                        "props": {"label": options[index], "value": str(index),
                                  "recommended": index in rec_set,
                                  "multi": is_multi},
                        "children": []}
                    children.append(key)
                children.append(base + "-text")
                children.append(base + "-submit")
                if question.get("clarify"):
                    children.append(base + "-clarify")
                elements[base + "-text"] = {
                    "type": "FreeText", "props": {"label": "free-text answer"},
                    "children": []}
                elements[base + "-submit"] = {
                    "type": "Submit", "props": {"label": "Submit", "value": "submit"},
                    "children": []}
                if question.get("clarify"):
                    elements[base + "-clarify"] = {
                        "type": "Clarify", "props": {"label": "Clarify"}, "children": []}
                elements[base] = {
                    "type": "Question",
                    "props": {"qid": qid, "title": question["title"],
                              "multi": is_multi,
                              "recommendation": (", ".join(
                                  recommended_labels(options, recommended))
                                  or None),
                              "token": slug, "set": set_id, "action": action,
                              "status": question.get("status") or "open",
                              "clarifyText": (question.get("answer")
                                              if question.get("status") == "clarifying"
                                              else None),
                              # Owner order 2026-09-30: the lane and the
                              # factory are gone from this line. The section
                              # heading names both, and the selector names the
                              # factory again, so a card repeating them said it
                              # twice. What is left is the CARD's own: its age
                              # and its qid.
                              "footer": "asked %s / %s"
                                        % (fmt_age(question.get("asked_at")
                                                   or entry.get("asked_at")),
                                           qid)},
                    "children": children}
                question_keys.append(base)
        if not question_keys:
            # Owner order 2026-09-28: a lane with nothing OPEN renders NO
            # section. It used to render one carrying "0 open", on the argument
            # that a handed-out lane anchor should keep resolving -- but the
            # cost was a page of empty blocks reporting nothing, and the owner
            # READS the page, not the anchors. A lane's anchor resolves while
            # that lane has an open question; a register with nothing open at
            # all falls through to the typed empty state below.
            continue
        n_open = sum(1 for (_e, q) in by_lane[lane] if not question_is_closed(q))
        # set_id: the section can span several sets, so it names the set only
        # when there is exactly one. data-set is for the reader, not the tool.
        # Derived from the CARDS this section renders (owner order 2026-09-28):
        # a lane also holds questions that are already CLOSED, and naming their
        # factory here put a control on the selector for a block holding none
        # of that factory's cards -- another empty set offered to the reader,
        # and a filter that scopes someone else's question.
        set_ids = []
        for key in question_keys:
            sid = elements[key]["props"]["set"]
            if sid not in set_ids:
                set_ids.append(sid)
        elements[anchor] = {
            "type": "QuestionSet",
            "props": {"set_id": ",".join(set_ids), "lane": lane, "anchor": anchor,
                      "open": n_open},
            "children": question_keys}
        section_keys.append(anchor)
    if not section_keys:
        # Owner order 2026-09-24: the page is ALWAYS deployed, including when
        # nothing is open. An empty register used to early-return, so the
        # previous page kept serving a question that had already been answered
        # and tapping it read as a failure. The empty state is typed DATA like
        # every other block -- no second builder, no renderer change.
        elements["empty-head"] = {
            "type": "Heading",
            "props": {"level": 2, "text": "No open questions"},
            "children": []}
        elements["empty-body"] = {
            "type": "Paragraph",
            "props": {"spans": [{"kind": "Text",
                                 "text": "Nothing is waiting on you right now."}]},
            "children": []}
        section_keys = ["empty-head", "empty-body"]
    elements["page"] = {
        "type": "Page",
        "props": {"title": "Open questions", "expires_at": expires_at},
        "children": section_keys}
    return {"root": "page", "elements": elements}

def render_via_node(spec):
    """(html, None) on success, (None, reason) on ANY failure.

    The Node file is copied into the build dir first (write-if-different) so the
    bare ESM imports resolve against the node_modules that lives there. Every
    fault -- no node, no build dir, non-zero exit, timeout, empty output -- is a
    reason, never an exception. The caller turns a reason into a NON-ZERO exit
    and writes nothing, so a Node fault fails the command while the last good
    page keeps serving."""
    directory = render_dir()
    if not os.path.isfile(RENDER_SRC):
        return None, "renderer source missing"
    try:
        os.makedirs(directory, exist_ok=True)
    except OSError as exc:
        return None, "build dir unwritable (%s)" % exc.__class__.__name__
    target = os.path.join(directory, "render.mjs")
    try:
        with open(RENDER_SRC, "r", encoding="utf-8") as fh:
            wanted = fh.read()
        current = None
        if os.path.isfile(target):
            with open(target, "r", encoding="utf-8") as fh:
                current = fh.read()
        if current != wanted:
            with open(target, "w", encoding="utf-8") as fh:
                fh.write(wanted)
    except OSError as exc:
        return None, "renderer copy failed (%s)" % exc.__class__.__name__
    try:
        proc = subprocess.run(
            ["node", "render.mjs"],           # ARGV LIST: never shell=True
            input=json.dumps(spec), capture_output=True, text=True,
            cwd=directory,                    # explicit: never the caller's cwd
            timeout=RENDER_TIMEOUT)
    except FileNotFoundError:
        return None, "node not installed"
    except subprocess.TimeoutExpired:
        return None, "renderer timed out"
    except OSError as exc:
        return None, "renderer spawn failed (%s)" % exc.__class__.__name__
    if proc.returncode != 0:
        # The LAST stderr line of a Node fault is its version banner, which says
        # nothing about the cause. Prefer the Error line.
        lines = [l for l in (proc.stderr or "").strip().splitlines() if l.strip()]
        cause = next((l for l in lines if "Error" in l), None)
        if cause is None and lines:
            cause = lines[-1]
        return None, "renderer rc=%d%s" % (proc.returncode,
                                           (": " + cause.strip()) if cause else "")
    if not proc.stdout.strip():
        return None, "renderer produced no output"
    return proc.stdout, None


# The answer form is upgraded to an inline swap by htmx (owner question
# 2026-09-24). It is VENDORED into the token dir and served from our own origin
# rather than pulled from a CDN: the reader is in Russia, and a third-party
# script the reader's browser must fetch is a dependency this page cannot
# verify. Without the file the attributes are inert and the form still submits
# as a normal POST, so the no-JS path degrades rather than breaks.
HTMX_FILE = "htmx.min.js"
HTMX_VERSION = "2.0.4"
HTMX_URL = "https://unpkg.com/htmx.org@%s/dist/htmx.min.js" % HTMX_VERSION

# The radio/text exclusivity affordance (owner report 2026-09-25). The page
# pre-checks the recommended radio, so a reader who TYPES an answer was left
# with a radio still selected -- confusing to the reader and, before the CLI
# fix, destructive: the typed answer was discarded. This file makes the two
# inputs visibly exclusive. It is a form AFFORDANCE, not client-side logic:
# the page still submits and still works with no JS at all.
UI_FILE = "questions.js"
UI_JS = """(function () {
  // htmx swaps only 2xx by default, so a REFUSED submit (400) left the reader
  // with no feedback at all -- reported by the owner 2026-09-25 after tapping
  // Clarify on an empty box. The backend already returns a proper swap
  // fragment for errors; this just puts it on the page.
  document.addEventListener('htmx:responseError', function (evt) {
    var d = evt.detail || {};
    var xhr = d.xhr;
    var el = d.elt || d.target;
    if (!xhr || !el || !xhr.responseText) return;
    var sel = el.getAttribute && el.getAttribute('hx-target');
    var node = sel ? document.querySelector(sel) : el;
    if (node) node.outerHTML = xhr.responseText;
  });

  document.querySelectorAll('form').forEach(function (form) {
    var box = form.querySelector('textarea[name="text"]');
    var radios = form.querySelectorAll('input[name="choice"]');
    if (!box || !radios.length) return;
    box.addEventListener('input', function () {
      if (box.value.trim() === '') return;
      radios.forEach(function (r) { r.checked = false; });
    });
    radios.forEach(function (r) {
      r.addEventListener('change', function () { if (r.checked) box.value = ''; });
    });
  });

  // Per-factory filter (owner order 2026-09-27): the page carries EVERY open
  // factory's questions, and this narrows the view to one WITHOUT touching the
  // URL, so the owner's pinned bookmark keeps working. The factory list comes
  // from each section's own data-set attribute -- already in the DOM, so no
  // spec, renderer or backend change is needed. The control is an ENHANCEMENT:
  // it is built here, so with JS off the page still reads in full.
  // Per-factory OPEN COUNTS (owner order 2026-09-28): the selector names how
  // many questions are waiting on each factory. Counted from each CARD's own
  // set field rather than from its section's data-set, because a lane section
  // can span two sets (lane-hq carries meta-factory,ai-antispam) and its cards
  // belong to different factories -- a section-level tally would credit BOTH
  // with the same cards.
  var counts = {};
  document.querySelectorAll('input[name="set"]').forEach(function (inp) {
    counts[inp.value] = (counts[inp.value] || 0) + 1;
  });

  var setSections = document.querySelectorAll('section.set[data-set]');
  if (setSections.length) {
    var factories = [];
    setSections.forEach(function (s) {
      s.getAttribute('data-set').split(',').forEach(function (f) {
        f = f.trim();
        if (f && factories.indexOf(f) < 0) factories.push(f);
      });
    });
    if (factories.length > 1) {
      var bar = document.createElement('div');
      bar.className = 'filterbar';
      var buttons = [];
      var current = '';
      var apply = function (f) {
        current = f;
        document.querySelectorAll('section.set[data-set]').forEach(function (s) {
          s.hidden = !!f && s.getAttribute('data-set').split(',').indexOf(f) < 0;
        });
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed',
            b.getAttribute('data-f') === f ? 'true' : 'false');
        });
      };
      [''].concat(factories).forEach(function (f) {
        var b = document.createElement('button');
        b.type = 'button';
        b.textContent = f ? f + ' (' + (counts[f] || 0) + ')' : 'All';
        b.setAttribute('data-f', f);
        b.addEventListener('click', function () { apply(f); });
        bar.appendChild(b);
        buttons.push(b);
      });
      setSections[0].parentNode.insertBefore(bar, setSections[0]);
      document.addEventListener('htmx:afterSwap', function () { apply(current); });
      apply('');
    }
  }
})();
"""

