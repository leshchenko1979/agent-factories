def page_wrapper(body, expires_at, title):
    """The page shell. Stays in Python deliberately: the noindex directive, the
    charset, the inline CSS and the TTL line are tested here and must not change
    just because the BODY is now rendered from a spec.

    `title` is the BROWSER TAB's title, and the shell is its ONE home. The
    spec's Page.title is a DIFFERENT surface -- the renderer emits it as the
    <h1> inside the body -- so the two are not two homes for one fact: the tab
    names the page and its open count, the heading names the page.

    The page is PERMANENT (owner order 2026-09-25), so no expiry is printed --
    and NO meta line is printed either (owner report 2026-09-27: the
    "permanent link" line sat above the h1, was the first thing the reader met,
    and carried nothing they need. Permanence is a property of the REGISTER,
    not a line of chrome). expires_at stays in the page meta, which is where
    the answer backend reads it from."""
    return ("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n"
            "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
            "<meta name=\"robots\" content=\"noindex, nofollow\">\n"
            f"<title>{html.escape(title)}</title>\n"
            # defer: the page is readable and submittable before htmx arrives,
            # and the attributes are inert if the file never loads.
            f'<script src="{HTMX_FILE}" defer></script>\n'
            f'<script src="{UI_FILE}" defer></script>\n'
            f"<style>{PAGE_CSS}</style>\n"
            "</head><body>\n"
            + body
            + "\n</body></html>\n")


# The reason from the LAST renderer fault, kept outside the unified log so it
# survives both the SystemExit that die() raises and a tree with no log at all.
# Read by republish() to name the fault on the mutation's own output (#189).
_LAST_RENDER_FAULT = None


def build_page(entries, slug, expires_at, action):
    """The page body from a json-render spec, wrapped in the tested shell.

    A renderer fault FAILS LOUDLY (owner order 2026-09-24). There is exactly one
    builder: a second one emitting near-identical HTML made the artifact unable
    to state its own provenance, so the fallback was deleted rather than kept as
    a safety net. The fault exits non-zero with the reason on stderr and NOTHING
    is written, so the previous page stays serving instead of a 404."""
    global _LAST_RENDER_FAULT
    spec = build_spec(entries, slug, expires_at, action)
    html_body, why = render_via_node(spec)
    if html_body is None:
        _LAST_RENDER_FAULT = why
        oc_log_extra("publish_failed", why)
        die(4, "renderer fault: %s" % why)
    oc_log_extra("renderer", "json-render")
    # The tab title names the page AND how much is waiting on it (owner order
    # 2026-09-26). The subject is the FLEET, never the path: the slug is where
    # the page is SERVED FROM, not what it is, and printing it made the tab
    # read "opencrabs-dev (10)" for a page carrying every factory's questions.
    # The count is the OPEN QUESTIONS count, the same predicate the pointer
    # publishes -- never len(entries), which counts sets.
    title = "Factory Open Questions (%d)" % open_question_count(entries)
    return page_wrapper(html_body, expires_at, title)


# Why the last vendoring attempt ended as it did. Recorded so the selftest can
# report the REASON rather than just the absence -- an unvendored page and a
# failed download look identical from the artifact alone.
_VENDOR_LAST = "not attempted"

def vendor_htmx(directory):
    global _VENDOR_LAST
    """Copy the vendored htmx beside the page. Best-effort BY DESIGN: a failure
    leaves the attributes inert and the form still submits normally, so this
    must never fail a publish. Downloaded once into the build dir, then copied
    from there -- the page never fetches it from a third party at runtime."""
    target = os.path.join(directory, HTMX_FILE)
    cached = os.path.join(render_dir(), HTMX_FILE)
    try:
        if not os.path.isfile(cached) or os.path.getsize(cached) < 10000:
            import urllib.request
            with urllib.request.urlopen(HTMX_URL, timeout=20) as response:
                payload = response.read()
            if len(payload) < 10000:
                raise OSError("suspiciously small htmx payload")
            with open(cached, "wb") as fh:
                fh.write(payload)
        with open(cached, "rb") as fh:
            payload = fh.read()
        if not os.path.isfile(target) or open(target, "rb").read() != payload:
            with open(target, "wb") as fh:
                fh.write(payload)
        _VENDOR_LAST = "ok (%d bytes)" % len(payload)
        return True
    except Exception as exc:  # noqa: BLE001
        _VENDOR_LAST = "%s: %s" % (exc.__class__.__name__, exc)
        oc_log_extra("htmx_vendor_failed", exc.__class__.__name__)
        return False

def vendor_ui(directory):
    """Write the radio/text affordance beside the page. Unlike htmx this is
    OURS, so it needs no download: it is written from the constant, which also
    means a stale copy can never linger (the content is overwritten every
    publish). Best-effort for the same reason as htmx: without it the form
    still submits, the two inputs are just not visually exclusive."""
    target = os.path.join(directory, UI_FILE)
    try:
        with open(target, "w", encoding="utf-8") as fh:
            fh.write(UI_JS)
        return True
    except Exception as exc:  # noqa: BLE001
        oc_log_extra("ui_vendor_failed", exc.__class__.__name__)
        return False

def prune_pages(keeps=None):
    """Remove retired ROTATING-TOKEN directories, and only those.

    The path is a readable slug now, so a token-shaped directory is residue from
    the retired model: nothing can address it and its link is dead. The test is
    the SHAPE (LEGACY_TOKEN_RE), never "anything that is not a current slug", so
    a live page can never be swept by accident.

    `keeps` is the WHOLE live set -- the aggregate plus every factory page -- not
    one slug: there is more than one page now, and protecting only one would let
    a factory whose slug happens to be token-shaped be swept. Live pages are
    NEVER removed: their links are bookmarked and permanent (owner order
    2026-09-25)."""
    import shutil
    removed = []
    root = pages_dir()
    if not os.path.isdir(root):
        return removed
    keeps = set(keeps or ())
    for name in sorted(os.listdir(root)):
        if not os.path.isdir(os.path.join(root, name)):
            continue
        if name in keeps:
            continue
        if not LEGACY_TOKEN_RE.match(name):
            continue
        shutil.rmtree(os.path.join(root, name), ignore_errors=True)
        removed.append(name)
    return removed

def page_is_live(token):
    """(live, reason) — used by the selftest and by anything that needs to know
    whether a token still serves."""
    directory = os.path.join(pages_dir(), token)
    meta_path = os.path.join(directory, "meta.json")
    if not os.path.isfile(meta_path):
        return False, f"no page for token {token!r}"
    try:
        with open(meta_path, "r", encoding="utf-8") as fh:
            meta = json.load(fh)
    except Exception as exc:
        return False, f"meta unreadable: {exc}"
    if not os.path.isfile(os.path.join(directory, "index.html")):
        return False, f"page directory {token!r} carries no index.html"
    # NO expiry check: the slug is a permanent bookmark (owner order
    # 2026-09-25). A 7-day page TTL is incompatible with a constant URL.
    return True, "live at %s" % page_url(token)

def latest_page():
    """The AGGREGATE page as (url, meta), or (None, reason).

    publish records pages/latest.json so render does not have to guess which
    directory is current. The pointer names the AGGREGATE (owner order
    2026-09-28): with a page per factory there is no single "the" page, and the
    union is the address that stays put no matter which factory moved. A pointer
    whose page has been pruned reports the reason rather than omitting the link
    silently: a card with no pointer and a card whose pointer is dead look
    identical otherwise, and only one of them is a defect."""
    path = latest_pointer_path()
    if not os.path.isfile(path):
        return None, "no page published yet (run: %s publish)" % PROG
    try:
        with open(path, encoding="utf-8") as fh:
            meta = json.load(fh)
    except (OSError, ValueError) as exc:
        return None, "pages/latest.json unreadable (%s)" % exc.__class__.__name__
    token = meta.get("slug")
    if not token:
        return None, "pages/latest.json carries no slug"
    live, why = page_is_live(token)
    if not live:
        return None, "the latest page is not live (%s)" % why
    return page_url(token), None


def open_question_count(sets):
    """Open QUESTIONS across `sets` — the ONE predicate the page title, the
    pointer's `questions` field and `open_totals` all read.

    NOT len(sets): that counts question SETS and is a different number. The live
    register holds 3 open sets carrying 5 open questions, so a title built from
    the set count would read (3) while the page renders 5."""
    return sum(1 for s in sets for q in s.get("questions", [])
               if not question_is_closed(q))


def open_totals():
    """(open questions, open sets) across the WHOLE register — the number the
    owner asked ask to return."""
    with RegisterLock():
        data = read_register()
    sets = [s for s in data["sets"] if s.get("status") == "open"]
    return open_question_count(sets), len(sets)


def read_pointer():
    """The current published page's meta, or None. Never raises: a corrupt
    pointer is a condition to report, not a crash."""
    path = latest_pointer_path()
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def republish(flags):
    """C4: refresh the page after a register mutation, BEST-EFFORT.

    A publish fault must never fail the mutation that triggered it — the
    mutation is the caller's work and the page is a convenience — so this
    returns None and the caller exits 0.

    It must NOT swallow the fault in silence (#189). The unified log is not a
    surface the caller reads: `--no-log` and the selftest both disable it, and a
    tree that never set OC_TOOLS_LOG has no log at all — so a fault recorded
    only there is a page that silently stops refreshing. The reason is named on
    the mutation's OWN stderr instead, while the exit code stays 0."""
    if flags.get("--no-publish"):
        return None
    try:
        meta, _, _metas = publish_page(quiet=True)
        return meta
    except SystemExit:
        _note_publish_fault(
            _LAST_RENDER_FAULT or "publish exited without naming a reason")
        return None
    except Exception as exc:
        _note_publish_fault("%s: %s" % (exc.__class__.__name__, exc))
        return None


def _note_publish_fault(why):
    """Name a publish fault on the caller's own output, and never change rc.

    A warning, not an error: the mutation SUCCEEDED and its work is on disk, so
    a non-zero exit would report the caller's own success as a failure. The
    warning goes to stderr so a caller parsing --json on stdout is unaffected."""
    oc_log_extra("publish_failed", why)
    sys.stderr.write(
        "%s: warning: the page was NOT refreshed \u2014 %s\n" % (PROG, why))


def publish_page(action=None, prune=False, quiet=False):
    """Build or refresh the public pages. (meta, pruned, metas).

    TWO ADDRESSES (owner order 2026-09-28): the neutral aggregate /all/ carries
    every factory's open questions, and every factory the register names keeps its
    OWN page carrying only its own. Both paths are readable CONSTANT slugs, never
    a rotating token (owner order 2026-09-25) -- a fresh URL per publish would 404
    the link the owner bookmarked, so re-render-on-change and a stable URL have to
    hold together or the feature is unusable.

    The pages NEVER expire: a 7-day PAGE TTL is incompatible with a permanent
    bookmark. DEFAULT_TTL_DAYS still governs QUESTION staleness -- a different
    thing, and unchanged.

    `meta` is the AGGREGATE page's, and is what the pointer records: with several
    pages live there is no "the" page, and the union is the one address that is
    stable no matter which factory moved.
    """
    with RegisterLock():
        data = read_register()
    targets = page_targets(data["sets"])
    pruned = prune_pages(keeps=[slug for slug, _ in targets])
    # No early return on an empty register (owner order 2026-09-24): the pages
    # must always be deployed, so an empty state is rendered to the SAME slugs
    # rather than leaving the previous page serving stale questions.

    # Render EVERY page BEFORE writing ANY of them: a renderer fault must leave
    # no half-made directory behind and must leave the previous pages serving
    # (owner order 2026-09-24). One bad page must not leave the others half-live.
    built = [(slug, entries,
              build_page(entries, slug, None, action or "/answer"))
             for slug, entries in targets]

    metas = {}
    for slug, entries, page in built:
        directory = os.path.join(pages_dir(), slug)
        os.makedirs(directory, exist_ok=True)
        vendor_htmx(directory)
        vendor_ui(directory)
        with open(os.path.join(directory, "index.html"), "w", encoding="utf-8") as fh:
            fh.write(page)
        # `expires_at` stays PRESENT and null: the live answer backend reads it
        # and fails OPEN on an empty value (backend.py: expired() -> False when
        # unset), so a null is "never expires" rather than "unknown".
        # `sets` is THIS page's own sets, never the register's: the answer
        # backend validates a posted set against the page's own meta, so a card
        # is answerable exactly when its set is listed HERE.
        # `echo` carries the two values the answer backend shows back on its
        # confirmation page -- the SET's lane and each question's title -- so the
        # public host names them without any copy of the register (S1, 2026-10-02).
        # Exactly those two fields, and NEVER a session id: the mirrored register
        # this replaces was the only reason a destination uuid left the agent
        # host. Keyed by set id and drawn from THIS page's entries, so a set is
        # echoable exactly when the page lists it (the answerability property).
        echo = {}
        for e in entries:
            echo[e["id"]] = {
                "lane": e.get("lane") or "",
                "questions": {str(q["qid"]): str(q.get("title") or "")
                              for q in (e.get("questions") or []) if q.get("qid")}}
        meta = {"slug": slug,
                "expires_at": None,
                "action": action or "/answer", "sets": [e["id"] for e in entries],
                "url": page_url(slug),
                "questions": open_question_count(entries),
                "echo": echo}
        with open(os.path.join(directory, "meta.json"), "w", encoding="utf-8") as fh:
            json.dump(meta, fh, indent=2)
        metas[slug] = meta
        oc_log_extra("slug", slug)
        oc_log_extra("questions", str(meta["questions"]))

    meta = metas[AGGREGATE_SLUG]

    # The pointer render reads. Written AFTER the pages and their metas exist, so
    # a reader never resolves a slug whose directory is still incomplete.
    pointer = {"slug": AGGREGATE_SLUG}
    with open(latest_pointer_path(), "w", encoding="utf-8") as fh:
        json.dump(pointer, fh, indent=2)

    if not quiet:
        for slug, m in metas.items():
            print(f"published {m['questions']} question(s) to "
                  f"{os.path.join(pages_dir(), slug)}")
            print(f"  slug {slug} (permanent)")
            print(f"  url {m['url']}")
        print(f"  action {meta['action']}")
        for name in pruned:
            print(f"  pruned retired token dir {name}")
    return meta, pruned, metas

def cmd_publish(argv):
    if "--set" in argv:
        die(2, "publish does not take --set: the page carries every open set. "
               "--set addresses ONE set, and belongs to amend, withdraw and notify")
    _, flags = parse_flags(argv, *flag_spec("publish"))
    action = flags.get("--action") or "/answer"

    meta, pruned, metas = publish_page(action=action,
                                       prune=bool(flags.get("--prune")),
                                       quiet=True)
    if flags.get("--json"):
        print(json.dumps({"slug": meta["slug"],
                          "path": os.path.join(pages_dir(), meta["slug"]),
                          "meta": meta, "pruned": pruned,
                          "pages": [{"slug": s, "questions": m["questions"],
                                     "sets": m["sets"], "url": m["url"]}
                                    for s, m in metas.items()]}, indent=2))
    else:
        for slug, m in metas.items():
            directory = os.path.join(pages_dir(), slug)
            print(f"published {m['questions']} question(s) to {directory}")
            print(f"  slug {slug} (permanent)")
            print(f"  url {m['url']}")
        print(f"  action {meta['action']}")
        for name in pruned:
            print(f"  pruned retired token dir {name}")
    return 0

