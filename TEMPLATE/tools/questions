BUTTON_LABEL_MAX = 28

def button_label(option):
    """Word-boundary truncation, MARKED. A bare slice rendered the recommended
    option "Keep frozen until the fence clears" as "Keep frozen until the fence "
    -- an unfinished instruction rather than a visible abbreviation, because
    nothing said the text had been cut."""
    text = " ".join(str(option).split())
    if len(text) <= BUTTON_LABEL_MAX:
        return text
    cut = text[:BUTTON_LABEL_MAX - 1]        # the ellipsis is part of the budget
    space = cut.rfind(" ")
    if space > 0:
        cut = cut[:space]
    return cut.rstrip() + "\u2026"


def now_iso():
    return datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0).isoformat()


def parse_iso(text):
    try:
        return datetime.datetime.fromisoformat(str(text).replace("Z", "+00:00"))
    except Exception:
        return None


def age_hours(asked_at):
    dt = parse_iso(asked_at)
    if not dt:
        return None
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    delta = datetime.datetime.now(datetime.timezone.utc) - dt
    return round(delta.total_seconds() / 3600.0, 1)


def fmt_age(asked_at):
    hours = age_hours(asked_at)
    if hours is None:
        return "age unknown"
    if hours < 1:
        return f"{int(hours * 60)}m ago"
    if hours < 48:
        return f"{hours:g}h ago"
    return f"{hours / 24:.1f}d ago"


def empty_register():
    return {"sets": []}


def read_register():
    """Read the register. A MISSING store is an empty register; a CORRUPT one is
    an error, never silently replaced — overwriting it would destroy the only
    copy of a parked question."""
    path = store_path()
    if not os.path.exists(path):
        return empty_register()
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
    except Exception as exc:
        die(4, f"register unreadable at {path}: {exc}")
    if not isinstance(data, dict) or not isinstance(data.get("sets"), list):
        die(4, f"register malformed at {path} (expected an object with a sets array)")
    return data


def write_register_atomic(data):
    """tmp -> os.replace, so a reader never observes a half-written register."""
    directory = store_dir()
    os.makedirs(directory, exist_ok=True)
    fd, tmp = tempfile.mkstemp(prefix=".open.", suffix=".tmp", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, ensure_ascii=False)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.replace(tmp, store_path())
    except Exception:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


class RegisterLock(object):
    """Single-writer guard: a read-modify-write must hold this for the WHOLE
    cycle, or two concurrent `ask` calls interleave and one set is lost."""

    def __init__(self, timeout=10.0):
        self.timeout = timeout
        self.fh = None

    def __enter__(self):
        os.makedirs(store_dir(), exist_ok=True)
        path = os.path.join(store_dir(), ".lock")
        self.fh = open(path, "a+")
        deadline = None
        import time as _time
        deadline = _time.time() + self.timeout
        while True:
            try:
                fcntl.flock(self.fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except OSError:
                if _time.time() >= deadline:
                    die(4, f"register lock not acquired within {self.timeout:g}s "
                           f"({path}) — another writer is mid-cycle")
                _time.sleep(0.05)

    def __exit__(self, *exc):
        try:
            fcntl.flock(self.fh.fileno(), fcntl.LOCK_UN)
        finally:
            self.fh.close()
        return False



def die(rc, message):
    sys.stderr.write(f"{PROG}: {message}\n")
    sys.exit(rc)


def open_sets(data):
    return [s for s in data["sets"] if s.get("status") == "open"]


def find_set(data, set_id):
    for entry in data["sets"]:
        if entry.get("id") == set_id:
            return entry
    return None


def find_question(entry, qid):
    for question in entry.get("questions", []):
        if question.get("qid") == qid:
            return question
    return None

def question_return_address(entry, qid):
    """(session, lane, reason) -- the RETURN ADDRESS for one answer.

    PER QUESTION, not per set: one standing factory set holds questions from
    many lanes, and the answer must reach the lane that ASKED it rather than
    whoever created the set. Falls back to the set's own session for questions
    recorded before the factory model."""
    if qid:
        question = find_question(entry, qid)
        if question is None:
            return None, None, "no question %r in set %s" % (qid, entry.get("id"))
        return ((question.get("session") or entry.get("session") or "").strip(),
                question.get("lane") or entry.get("lane") or "", None)
    return ((entry.get("session") or "").strip(),
            entry.get("lane") or "", None)

# PORTED FROM THE INSTRUMENT'S HOME (#182 item 1). This function exists in
# the instrument's home in the contributing skill repo, where fork
# #612 was fixed -- and was ABSENT from this copy, so the template shipped
# without the fix: a `notify` with no `--qid` addressed the SET's session while
# the body named the ASKING lane, so an answer could reach a lane that never
# asked it. Direction: source -> template. The two copies differ in their own
# names by design (PROG, RENDER_SRC, USAGE), so what converges is the union of
# FUNCTIONS and BEHAVIOUR, never a byte-identical copy.
def batch_return_address(entry):
    """(session, reason) for a notify that names NO --qid.

    One body carrying several lanes' answers cannot have one destination, so
    this REFUSES when the answered questions resolve to different sessions
    rather than falling back to the set's own session. The set's session is the
    CREATOR's provenance; a question asked by another lane carries its own, and
    addressing the creator's session while the body names the asking lane sends
    the answer to a lane that did not ask (#612).

    Falls back to the set's session only when every answered question shares it
    -- the pre-factory shape, where questions carry no session of their own.
    """
    answered = [q for q in (entry.get("questions") or [])
                if q.get("answer") is not None
                or q.get("status") in ("clarifying", "clarified")]
    resolved = []
    for question in answered:
        session = (question.get("session") or entry.get("session") or "").strip()
        if session not in resolved:
            resolved.append(session)
    if len(resolved) > 1:
        return None, (
            "set %s holds answers for %d different sessions, so one body has no "
            "single destination; pass --qid <Q> to deliver one answer to the "
            "lane that asked it" % (entry.get("id"), len(resolved)))
    if resolved:
        return resolved[0], None
    # No answers yet: fall back to the set's own session so the caller's UUID
    # guard still refuses a bad address (rc=3) BEFORE the missing-body check
    # (rc=1). Returning early here reordered those two and broke that contract.
    return (entry.get("session") or "").strip(), None


# A question is CLOSED only once it is answered, withdrawn or expired.
# "clarifying" is NOT closed: a Clarify request means the owner asked for more
# context and is still waiting. Counting it as closed archived the WHOLE set and
# silently removed it from the live register — the opposite of the contract
# ("a Clarify request ... never silently closes the question").
CLOSED_STATUSES = ("answered", "withdrawn", "expired")

# What an empty Clarify tap MEANS (#183, 2026-09-26). The owner's click is the
# whole request — no payload is owed — but the transition must still carry
# content the asking lane can act on (the 2026-09-25 defect was answer=None
# behind "CLARIFY REQUESTED"). So the tool authors the click's meaning: a
# statement of what the lane must do. It is TOOL-AUTHORED text, deliberately
# not led by "clarification requested": the STATE is stated once, by the chip on
# the card's own context line, so this text answers the only question left --
# what the lane must DO. Wording deliberately names the ACTION owed (restate,
# widen, re-ask) so the receiving lane can act without guessing.
CLARIFY_EMPTY_TEXT = (
    "this question is unclear as written — restate it with wider context "
    "and plainer language, then re-ask (owner's Clarify tap, no text "
    "supplied)"
)

def question_is_closed(question):
    return question.get("status") in CLOSED_STATUSES


def fork_issue_state(number):
    """('OPEN'|'CLOSED', None) or (None, reason). NEVER guesses: an unreadable
    probe yields a reason, and the caller reports a SKIP rather than closing."""
    try:
        proc = subprocess.run(
            ["gh", "issue", "view", str(number), "--repo", FORK_REPO,
             "--json", "state"],
            capture_output=True, text=True, timeout=PREDICATE_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as exc:
        return None, "gh unavailable (%s)" % exc.__class__.__name__
    if proc.returncode != 0:
        return None, "gh rc=%d" % proc.returncode
    try:
        state = (json.loads(proc.stdout).get("state") or "").upper()
    except ValueError:
        return None, "gh output unparseable"
    return (state or None), None


def mechanical_close(entry, question):
    """(reason, note) — whether a predicate now closes this question.

    C6 (owner order: "why not close the questions mechanically?"). Two arms:
      * default — the question's text (or the set subject) names a fork issue
        that reads CLOSED;
      * explicit — close_when is a shell command whose rc=0 closes.
    An unreadable predicate returns a NOTE, never a close: a question must not
    disappear because a probe failed."""
    when = str(question.get("close_when") or "").strip()
    if when:
        try:
            proc = subprocess.run(["/bin/sh", "-c", when], capture_output=True,
                                  text=True, timeout=PREDICATE_TIMEOUT)
        except (OSError, subprocess.SubprocessError) as exc:
            return None, "close-when SKIPPED (%s)" % exc.__class__.__name__
        if proc.returncode == 0:
            return "close-when predicate returned rc=0", None
        return None, None

    blob = " ".join(str(x) for x in (
        question.get("title"), question.get("description"), entry.get("subject"))
        if x)
    match = ISSUE_RE.search(blob)
    if not match:
        return None, None
    number = match.group(1)
    state, why = fork_issue_state(number)
    if why:
        return None, "issue-state SKIPPED (#%s: %s)" % (number, why)
    if state == "CLOSED":
        return "%s#%s is CLOSED" % (FORK_REPO, number), None
    return None, None


def apply_mechanical_closures(data):
    """Walk every open question, close the ones whose predicate now holds.
    Returns (closed, notes). Caller MUST hold the lock."""
    closed, notes = [], []
    for entry in data["sets"]:
        if entry.get("status") != "open":
            continue
        for question in entry.get("questions", []):
            if question_is_closed(question):
                continue
            reason, note = mechanical_close(entry, question)
            if note:
                notes.append("%s/%s %s" % (entry.get("id"), question.get("qid"), note))
            if reason:
                question["status"] = "resolved_mechanically"
                question["closed_at"] = now_iso()
                question["closed_reason"] = reason
                closed.append("%s/%s -> %s (%s)"
                              % (entry.get("id"), question.get("qid"),
                                 question["status"], reason))
        if entry.get("questions") and all(question_is_closed(q)
                                          for q in entry["questions"]):
            entry["status"] = "answered"
            entry["closed_at"] = now_iso()
    return closed, notes

def set_is_closed(entry):
    questions = entry.get("questions") or []
    return bool(questions) and all(question_is_closed(q) for q in questions)




