def slugify(text):
    """lowercase, non-alnum -> hyphen. ONE home for the page slug AND the lane
    anchors, so a rename cannot make the two disagree about the same lane."""
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-") or "lane"

def lane_anchor(lane):
    """The STABLE per-lane anchor (owner order 2026-09-25). The same lane must
    yield the same id across re-renders and across publishes, so a URL handed
    to the owner for one lane keeps pointing at that lane."""
    return "lane-" + slugify(lane)

def page_slug(factory):
    """The page path is a CONSTANT slug -- never a rotating token. Owner order
    2026-09-25: the link is bookmarked, so a fresh URL per publish 404s it.
    One home: every caller derives the path from here."""
    return slugify(factory)

def _declared_slug():
    """This factory's OWN slug, read from its `registry/fleet.json`.

    The first publish has no set to derive a slug from, and the instrument used to
    fall back to the slug of the factory it was WRITTEN for -- so a new factory's
    very first page was published under another factory's name. A factory's slug is
    already declared in `registry/fleet.json` (the file the lane resolver reads), so
    it is read here rather than restated. Returns "" when the tree carries no
    manifest, and the caller then requires `--factory` explicitly rather than
    guessing.
    """
    try:
        manifest = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "registry", "fleet.json")
        with open(manifest, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return ""
    for record in data.get("factories") or []:
        # A factory's own manifest declares ITS record; when a manifest carries
        # several (this repo is one of the factories it names), the record whose
        # `repo` is this tree is the one that describes us.
        if record.get("repo") and os.path.realpath(record["repo"]) == os.path.realpath(
                os.path.dirname(os.path.dirname(os.path.abspath(__file__)))):
            return str(record.get("slug") or "")
    records = data.get("factories") or []
    return str(records[0].get("slug") or "") if len(records) == 1 else ""


# The slug used when the register holds no set to derive one from -- i.e. the very
# first publish. A factory set is never auto-archived, so once one exists the slug
# always comes from the register. Env override wins, then this factory's own declared
# slug, then EMPTY -- and an empty value makes `ask` require `--factory` rather than
# silently publishing under a name that is not the caller's.
DEFAULT_FACTORY = (os.environ.get("OC_QUESTIONS_FACTORY") or _declared_slug())

# The retired rotating-token shape (secrets.token_urlsafe(24) -> 32 chars).
# Pruning keys on the SHAPE, not on "anything that is not the current slug", so
# a future second factory's readable slug can never be swept by accident.
LEGACY_TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{32}$")

def page_slug_for(entries):
    """The page slug. STABLE by construction.

    A slug derived from the register alone would MOVE when a set is added or
    removed -- the first open set by asked_at changes, the path changes, and the
    owner's bookmark 404s. So the slug is recorded in pages/latest.json on the
    first publish and REUSED from then on; the register only supplies it when
    there is no pointer yet.

    That is the same reuse discipline the retired token had (C7), which is what
    made the URL stable; dropping it here would have reintroduced the churn the
    constant-slug order exists to remove.
    """
    pointer = read_pointer()
    if pointer and pointer.get("slug"):
        return pointer["slug"]
    for entry in entries:
        key = entry.get("factory") or entry.get("id")
        if key:
            return page_slug(key)
    return page_slug(os.environ.get("OC_QUESTIONS_FACTORY") or DEFAULT_FACTORY)

def questions_db_path():
    return (os.environ.get("OC_QUESTIONS_DB")
            or os.path.join(profile_home(), "opencrabs.db"))

def resolve_lane(session):
    """(lane_name, reason) -- the DISPLAY name of the session's OWN topic.

    Resolved from the live binding, never from the caller: a lane that could
    name itself could mislabel where an answer came from (owner order
    2026-09-25: "Session can be derived from the env").

    The name comes from channel_messages.topic_name -- the bot-observed topic
    name. sessions.title is deliberately NOT used: it carries auto-generated
    titles for some lanes (measured: a bound lane titled "Telegram flow card
    metrics telemetry bar #232"), so it is not a topic name.

    An unbound session returns (None, reason). The caller REFUSES, because an
    unbound session can never receive the answer: registering a question
    against it strands the question permanently.
    """
    path = questions_db_path()
    if not os.path.isfile(path):
        return None, "no session DB at %s" % path
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
    except sqlite3.Error as exc:
        return None, "session DB unreadable (%s)" % exc.__class__.__name__
    try:
        row = conn.execute(
            "select chat_id, thread_id from session_bindings "
            "where session_id=? and channel='telegram'", (session,)).fetchone()
        if row is None:
            return None, "session %s has no session_bindings row" % session
        chat_id, thread_id = row
        name = conn.execute(
            "select topic_name from channel_messages "
            "where channel='telegram' and channel_chat_id=? "
            "and cast(thread_id as integer)=? and topic_name is not null "
            "and topic_name<>'' order by created_at desc limit 1",
            (chat_id, thread_id)).fetchone()
    except sqlite3.Error as exc:
        return None, "session DB query failed (%s)" % exc.__class__.__name__
    finally:
        conn.close()
    if name is None or not (name[0] or "").strip():
        return None, ("binding found (chat %s thread %s) but no topic_name "
                      "observed for it yet" % (chat_id, thread_id))
    return name[0].strip(), None


