"""

_VERB_HEAD_RE = re.compile(r"^  ([a-z]+)\s")

def _usage_trailer(lines):
    """The shared tail of USAGE (the Store note and the rc legend), so a
    per-verb usage keeps the exit-code contract in view."""
    for index, line in enumerate(lines):
        if line.startswith("Store:"):
            return ["", *lines[index:]]
    return []

def verb_usage(verb):
    """The USAGE section for ONE verb, plus the shared trailer (#310).

    Every subcommand answers `--help` with its own usage. Pre-fix, `ask --help`
    (and the other five) died rc=2 on "unknown flag --help", so the one flag a
    caller reaches for first was the one that failed. Falls back to the whole
    text when the verb has no section, so a future verb is never worse off."""
    lines = USAGE.splitlines()
    # The TITLE line travels with every verb's section: `ask --help` names the
    # program it belongs to, exactly as the bare `--help` does. Without it the
    # per-verb text is an unattributed block, and a caller cannot tell which
    # tool answered (the selftest asserts the title is present, #310).
    header = [lines[0], ""] if lines else []
    start = None
    for index, line in enumerate(lines):
        head = _VERB_HEAD_RE.match(line)
        if start is not None and head:
            return "\n".join(header + lines[start:index] + _usage_trailer(lines)) + "\n"
        if head and head.group(1) == verb:
            start = index
    if start is not None:
        return "\n".join(header + lines[start:]) + "\n"
    return USAGE

def main(argv):
    oc_log_init()
    if not argv or argv[0] in ("--help", "-h", "help"):
        sys.stdout.write(USAGE)
        return 0
    if "--help" in argv[1:] or "-h" in argv[1:]:
        # #310: `--help` anywhere after the verb prints THAT verb's usage, rc 0.
        sys.stdout.write(verb_usage(argv[0]))
        return 0
    verb, rest = argv[0], argv[1:]
    if verb in ("--selftest", "selftest"):
        return selftest()
    if verb in ("--schema", "schema"):
        # #709: the machine-readable flag schema, consumed by the dynamic-tool
        # bridge (tools/state/oc_questions_tool.py) so it derives its argv from
        # THIS parser instead of a hand-kept mirror that drifts.
        print(json.dumps(schema_payload(), indent=2, ensure_ascii=False))
        return 0
    handlers = {"ask": cmd_ask, "answer": cmd_answer, "amend": cmd_amend,
                "withdraw": cmd_withdraw, "list": cmd_list,
                "publish": cmd_publish, "lint": cmd_lint,
                "gc": cmd_gc, "notify": cmd_notify,
                "redeliver": cmd_redeliver}
    if set(handlers) != set(_VERBS):
        sys.stderr.write("%s: verb set drifted from _VERBS\n" % PROG)
        return 2
    handler = handlers.get(verb)
    if handler is None:
        sys.stderr.write("%s: unknown verb %r\n\n%s" % (PROG, verb, USAGE))
        return 2
    return handler(rest)

if __name__ == "__main__":
    _rc = main(sys.argv[1:])
    oc_log_finish(_rc)
    sys.exit(_rc)
