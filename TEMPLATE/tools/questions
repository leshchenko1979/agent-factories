    # fixture lives in a temp dir only the COPY `env` knows about -- so the
    # direct call must be pointed at the fixture, then the live value restored.
    _saved_qdb = os.environ.get("OC_QUESTIONS_DB")
    os.environ["OC_QUESTIONS_DB"] = fixture_db
    try:
        _rl_name, _rl_why = resolve_lane(session_r)
    finally:
        if _saved_qdb is None:
            os.environ.pop("OC_QUESTIONS_DB", None)
        else:
            os.environ["OC_QUESTIONS_DB"] = _saved_qdb
    ck(_rl_name == "New Name",
       "resolve_lane prefers the topic_edited rename over a newer stale echo "
       "(#762): got %r (%s)" % (_rl_name, _rl_why))
    # The DECLARED expectation side, as a fixture: the override is authoritative
    # so the live tree can never leak into the selftest's verdict.
    _fleet = os.path.join(root, "fleet.json")
    with open(_fleet, "w", encoding="utf-8") as _fh:
        json.dump({"factories": [
            {"slug": "opencrabs-dev", "display_name": "OpenCrabs Dev",
             "chat_id": int(home_chat)},
            {"slug": "ai-antispam", "display_name": "AI AntiSpam",
             "chat_id": int(foreign_chat)},
            {"slug": "meta-factory", "display_name": "Meta-Factory",
             "chat_id": int(mf_chat)},
        ]}, _fh)
    env["OC_FLEET_MANIFEST"] = _fleet
    # The Node renderer resolves its bare imports against node_modules BESIDE
    # the render file, so the fixture links the real installed tree into its own
    # render dir. A symlink keeps the test from writing the live store while
    # still exercising the json-render path rather than silently falling back.
    fixture_render = os.path.join(root, "render")
    real_modules = os.path.join(profile_home(), "questions", "build", "node_modules")
    try:
        os.makedirs(fixture_render, exist_ok=True)
        link = os.path.join(fixture_render, "node_modules")
        if os.path.isdir(real_modules) and not os.path.exists(link):
            os.symlink(real_modules, link)
    except OSError:
        pass
    env["OC_QUESTIONS_RENDER_DIR"] = fixture_render

    def run(*args):
        proc = subprocess.run([tool] + list(args), env=env, capture_output=True,
                              text=True, timeout=90)
        return proc.returncode, proc.stdout, proc.stderr

    def store_json():
        with open(os.path.join(env["OC_QUESTIONS_DIR"], "open.json"),
                  encoding="utf-8") as fh:
            return json.load(fh)

    def get_set(sid):
        """None instead of an exception: a missing set is a FAIL row, not a
        traceback. A selftest that dies mid-way reports nothing at all."""
        for item in store_json()["sets"]:
            if item.get("id") == sid:
                return item
        return None

    try:
        # -- 1. ask -> list -------------------------------------------------
        rc, out, _ = run("ask", "--factory", "f-cron-lane",
                         "--questions-json", json.dumps([
                             {"title": "Ship the second half?",
                              "description": "**Context:** measured.",
                              "options": ["Ship", "Hold"], "recommended": 1},
                             {"title": "Which cadence?",
                              "description": "Two options.",
                              "options": ["6h", "12h"], "recommended": 0},
                         ]))
        ck(rc == 0, "ask registers a set (rc=%d)" % rc)
        rc, out, _ = run("list")
        ck(rc == 0 and "Ship the second half?" in out and "Which cadence?" in out,
           "list shows the registered questions")

        # -- 2. ORDER + PER-QUESTION RECOMMENDATIONS (owner criterion) ------
        sets = store_json()["sets"]
        ck(len(sets) == 1, "exactly one set registered (%d)" % len(sets))
        entry = sets[0] if sets else {}
        set_id = entry.get("id", "")
        questions = entry.get("questions", [])
        ck([q.get("qid") for q in questions] == ["q1", "q2"],
           "question order is CALL order (q1, q2)")
        ck(len(questions) == 2 and questions[0].get("recommended") == 1
           and questions[1].get("recommended") == 0,
           "per-question recommendations preserved (1 then 0, not shared)")

        # -- 2b. --recommended RESOLUTION (#652, 2026-09-28) ---------------
        # These arms ASK, so they get their OWN store: the main fixture's set
        # population is asserted by later arms (an exact set count, and the
        # recommendation text found in the rendered DOM), so residue here would
        # silently re-subject THEIR fixtures. Isolation, not tidiness.
        _rec_store = os.path.join(root, "rec-store")
        os.makedirs(_rec_store, exist_ok=True)
        _saved_rec_dir = env["OC_QUESTIONS_DIR"]
        env["OC_QUESTIONS_DIR"] = _rec_store
        # A caller must not have to count array positions (fleet-directives.md
        # LLM Ergonomics item 1). Measured cost of the bare index: lane 6630dc9a
        # read "1" as "the FIRST option" while its own prose said
        # "RECOMMENDED: A", so the owner's page pre-checked the radio OPPOSING
        # the question for 4h26m. The round-trip arm above cannot catch that --
        # the raw index round-trips correctly, which is the whole problem.
        # THE RECORDED VALUE STAYS AN INDEX in every form, so no existing
        # question is reinterpreted; only the INPUT is widened.
        rc, out, _ = run("ask", "--factory", "f-rec-letter",
                         "--title", "Letter form", "--description", "d",
                         "--option", "A", "--option", "B",
                         "--recommended", "A", "--no-publish")
        ck(rc == 0, "ask accepts a LABEL/letter for --recommended (rc=%d)" % rc)
        ck("[0] 'A'" in out,
           "\u2026and ECHOES what it resolved, read back from the record (%r)"
           % (out.strip().splitlines()[-2:] if out.strip() else ""))
        _rl = get_set("f-rec-letter")["questions"][0]
        ck(_rl.get("recommended") == 0,
           "\u2026storing the INDEX, so a reader of the register is unchanged "
           "(%r)" % (_rl.get("recommended"),))
        # The letter is matched against the OPTIONS' OWN leading letters, not
        # the alphabet position: ord('Y')-65 = 24 would refuse valid input.
        rc, out, _ = run("ask", "--factory", "f-rec-y",
                         "--title", "Y form", "--description", "d",
                         "--option", "X - first", "--option", "Y - second",
                         "--recommended", "Y", "--no-publish")
        ck(rc == 0 and get_set("f-rec-y")["questions"][0].get("recommended") == 1,
           "a bare letter matches the option's OWN leading letter, not its "
           "alphabet position (rc=%d, recommended=%r)"
           % (rc, (get_set("f-rec-y") or {}).get("questions", [{}])[0]
              .get("recommended")))
        rc, out, _ = run("ask", "--factory", "f-rec-label",
                         "--title", "Label form", "--description", "d",
                         "--option", "X - first", "--option", "Y - second",
                         "--recommended", "Y - second", "--no-publish")
        ck(rc == 0 and get_set("f-rec-label")["questions"][0].get("recommended") == 1,
           "a FULL option label resolves too (rc=%d)" % rc)
        # An all-digit value stays an INDEX, so an option literally named "1"
        # remains reachable.
        rc, out, _ = run("ask", "--factory", "f-rec-digit",
                         "--title", "digit", "--description", "d",
                         "--option", "1", "--option", "2",
                         "--recommended", "1", "--no-publish")
        ck(rc == 0 and get_set("f-rec-digit")["questions"][0].get("recommended") == 1,
           "an all-digit value is still an INDEX, so an option named '1' stays "
           "reachable (rc=%d)" % rc)
        # REFUSED, naming the options -- never silently fallen back to an
        # index, which is how the original wrong-base landed.
        rc, _, err = run("ask", "--factory", "f-rec-bad",
                         "--title", "bad", "--description", "d",
                         "--option", "a", "--option", "b",
                         "--recommended", "zebra", "--no-publish")
        ck(rc == 2 and "matches no option" in (err or ""),
           "an unmatched label is REFUSED naming the options (rc=%d, err=%r)"
           % (rc, (err or "").strip()[:70]))
        rc, _, err = run("ask", "--factory", "f-rec-range",
                         "--title", "range", "--description", "d",
                         "--option", "a", "--option", "b",
                         "--recommended", "9", "--no-publish")
        ck(rc == 2 and "outside options" in (err or ""),
           "an out-of-range index is refused naming the options (rc=%d)" % rc)
        ck(get_set("f-rec-bad") is None and get_set("f-rec-range") is None,
           "\u2026and a refused ask registers NOTHING")
        # The amend leg resolves the same way and echoes the label.
        rc, out, _ = run("amend", "--set", "f-rec-letter", "--qid", "q1",
                         "--recommended", "B")
        ck(rc == 0 and "recommended=1 (B)" in out,
           "amend resolves and ECHOES the label it stored (rc=%d, out=%r)"
           % (rc, out.strip()[-60:]))
        # Close the isolation opened for these arms.
        env["OC_QUESTIONS_DIR"] = _saved_rec_dir
        ck(set_id == "f-cron-lane",
           "the FACTORY KEY IS the set id (%r)" % set_id)

        # -- 3. CONCURRENT ASK: two writers lose NEITHER (owner criterion) --
        procs = [subprocess.Popen(
            [tool, "ask", "--factory", "f-race-%d" % i,
             "--title", "Race question %d" % i, "--description", "concurrent"],
            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            for i in (1, 2)]
        codes = [p.wait(timeout=90) for p in procs]
        ck(codes == [0, 0], "two concurrent ask calls both exit 0 (%s)" % codes)
        racers = [s for s in store_json()["sets"] if s["id"].startswith("f-race-")]
        ck(len(racers) == 2,
           "NEITHER concurrent set was lost (%d of 2 present)" % len(racers))
        ck(len({s["id"] for s in store_json()["sets"]}) == 3,
           "…and the ids are distinct (3 sets, 3 ids)")
        ck(os.path.isfile(os.path.join(env["OC_QUESTIONS_DIR"], "open.json")),
           "the atomic replace left a complete register, not a .tmp")

        # -- 4. C1/C2/C3: the session comes from the ENV, ask returns the
        # TOTAL, and the card/button leg is GONE (owner order 2026-09-24:
        # "the calling lane should not get a card with buttons. delete that leg
        # - the user decisions are collected via the page").
        # #709: FLAG_SPEC is the ONE declaration of what each verb accepts, and
        # it must cover the verb set exactly. A verb wired into a handler but
        # missing from FLAG_SPEC (or the reverse) is the same drift class that
        # let the bridge's hand-kept map fall behind this parser.
        ck(set(FLAG_SPEC) == set(_VERBS),
           "FLAG_SPEC covers _VERBS exactly (%s vs %s)"
           % (sorted(FLAG_SPEC), sorted(_VERBS)))
        for _verb, _spec in FLAG_SPEC.items():
            ck(isinstance(_spec.get("valued"), dict)
               and isinstance(_spec.get("boolean"), dict)
               and bool(_spec.get("positional")),
               "FLAG_SPEC[%r] declares valued/boolean param->flag maps + positional"
               % _verb)
            ck(not (set(_spec["valued"]) & set(_spec["boolean"])),
               "FLAG_SPEC[%r]: no param is both valued and boolean" % _verb)
            ck(all(isinstance(f, str) and f.startswith("--")
                   for f in list(_spec["valued"].values())
                   + list(_spec["boolean"].values())),
               "FLAG_SPEC[%r]: every mapped flag is a --long-flag" % _verb)
        # The parser each handler uses must be the published one: a handler
        # that hand-declared its flags again would re-open the drift (#709).
        for _verb, _spec in FLAG_SPEC.items():
            ck(flag_spec(_verb) == (list(_spec["valued"].values()),
                                    list(_spec["boolean"].values())),
               "flag_spec(%r) is the flat view of FLAG_SPEC" % _verb)
        _src = open(os.path.abspath(__file__), encoding="utf-8").read()
        for _verb in sorted(_VERBS):
            ck('*flag_spec("%s")' % _verb in _src,
               "cmd_%s parses with flag_spec(%r), not an inline flag list (#709)"
               % (_verb, _verb))
        _pay = schema_payload()
        ck(set(_pay["verbs"]) == set(_VERBS)
           and _pay["store"].endswith("open.json"),
           "--schema publishes every verb and the store path (#709)")
        ck("set_id" not in _pay["verbs"]["publish"]["valued"]
           and "--set" not in _pay["verbs"]["publish"]["valued"].values(),
           "publish declares NO set_id/--set -- cmd_publish refuses it by name "
           "(#709)")
        ck(_pay["verbs"]["list"]["valued"].get("factory") == "--factory",
           "list publishes factory -> --factory -- the param the bridge dropped "
           "(#709)")
        ck(_pay["verbs"]["amend"]["valued"].get("set_id") == "--set",
           "the published map resolves set_id -> --set, which no dash rule can "
           "recover (#709)")
        ck(_pay["verbs"]["answer"]["positional_params"] == [
               {"name": "set_id", "required": True},
               {"name": "qid", "required": True},
               {"name": "choice", "required": False}]
           and _pay["verbs"]["notify"]["positional_params"] == [
               {"name": "set_id", "required": False}]
           and _pay["verbs"]["list"]["positional_params"] == [],
           "--schema publishes positional_params with required-ness, so the "
           "bridge need not parse the human `positional` string (#709)")
        ck("render" not in _VERBS,
           "the card leg is DELETED -- render is not a verb any more")
        gone = "def cmd_" + "render"
        ck(gone not in open(os.path.abspath(__file__), encoding="utf-8").read(),
           "\u2026and the function is gone from the source, not merely unrouted")
        envask = dict(env)
        envask["OPENCRABS_SESSION_ID"] = session_a
        proc = subprocess.run([tool, "ask", "--factory", "f-env-lane",
                               "--title", "t", "--description", "d",
                               "--option", "a", "--option", "b",
                               "--recommended", "0", "--no-publish", "--json"],
                              env=envask, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 0,
           "ask needs NO --session when OPENCRABS_SESSION_ID is set (rc=%d)"
           % proc.returncode)
        envset = {}
        try:
            envset = json.loads(proc.stdout)
        except ValueError:
            pass
        ck(envset.get("entry", {}).get("session") == session_a,
           "\u2026and it records the ENV session as the return address (%r)"
           % envset.get("entry", {}).get("session"))
        ck(isinstance(envset.get("open_questions"), int)
           and envset["open_questions"] >= 1,
           "ask returns the OPEN-QUESTION TOTAL, not a card payload (%r)"
           % envset.get("open_questions"))
        ck("cards" not in envset and "buttons" not in envset,
           "\u2026and the payload carries no card and no buttons")
        # The owner reads the TEXT, so the total must be there too -- asserting
        # only the JSON field let the human-readable half be removed silently.
        proc = subprocess.run([tool, "ask", "--factory", "f-text-lane",
                               "--title", "t", "--description", "d"],
                              env=envask, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 0 and "open question(s) across" in proc.stdout,
           "ask PRINTS the open-question total, not only a json field (%r)"
           % proc.stdout.strip().splitlines()[-2:])

        # an env var that is not a UUID is refused: the register must hold a
        # REAL return address, not a guess.
        envbad = dict(env)
        envbad["OPENCRABS_SESSION_ID"] = "not-a-uuid"
        proc = subprocess.run([tool, "ask", "--factory", "f-bad-env",
                               "--title", "t", "--description", "d"],
                              env=envbad, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 2,
           "a non-UUID OPENCRABS_SESSION_ID is refused rc=2 (rc=%d)"
           % proc.returncode)
        envnone = dict(env)
        envnone.pop("OPENCRABS_SESSION_ID", None)
        proc = subprocess.run([tool, "ask", "--factory", "f-no-addr",
                               "--title", "t", "--description", "d"],
                              env=envnone, capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 2,
           "with no session anywhere, ask refuses rather than registering a "
           "question whose answer has nowhere to go (rc=%d)" % proc.returncode)

        # -- 5. answer, idempotence, clarify -------------------------------
        rc, out, _ = run("answer", set_id, "q1", "1", "--via", "card")
        ck(rc == 0 and "Hold" in out,
           "answer records the OPTION TEXT, not the index (%r)" % out.strip()[:40])
        rc, out, _ = run("answer", set_id, "q1", "1", "--via", "card")
        ck(rc == 3, "re-submit on a closed question is rc=3, idempotent (rc=%d)" % rc)
        rc, out, _ = run("answer", set_id, "q2", "clarify", "--text", "explain 12h")
        ck(rc == 0, "clarify is recorded (rc=%d)" % rc)
        current = get_set(set_id)
        q2 = (current or {}).get("questions", [{}, {}])
        q2 = q2[1] if len(q2) > 1 else {}
        ck(q2.get("status") == "clarifying" and q2.get("answer") == "explain 12h",
           "clarify does NOT close the question (status=%r)" % q2.get("status"))
        ck(set_id in {s["id"] for s in store_json()["sets"]},
           "…and the SET stays live while a question is merely clarifying")
        rc, _, _ = run("answer", set_id, "q2", "0")
        ck(rc == 0, "a later real answer closes the clarifying question")
        # Owner order 2026-09-25: a factory set is NEVER auto-archived. It
        # stays open at 0..N questions, so the page and its address are
        # permanent -- the lane SECTION is not (owner order 2026-09-28).
        live = get_set(set_id)
        ck(live is not None and live.get("status") == "open",
           "a fully answered factory set STAYS OPEN (status=%r)"
           % (live or {}).get("status"))
        ck(sum(1 for q in (live or {}).get("questions", [])
               if not question_is_closed(q)) == 0,
           "…with 0 open questions, asserted on the RECORD")

        # -- 5b. a TYPED answer is NEVER discarded (owner report 2026-09-25) -
        # The page pre-checks the recommended radio, so the browser always
        # posts a choice index; a filled text box therefore arrives with BOTH
        # fields set. The old code took the index and dropped the text
        # silently, so the recorded answer became the radio label. Text wins,
        # and the selected index is kept as context rather than lost.
        rc, out, _ = run("ask", "--factory", set_id, "--title", "typed",
                         "--description", "d", "--option", "A", "--option", "B")
        ck(rc == 0, "a further question joins the SAME standing set (rc=%d)" % rc)
        rc, out, _ = run("answer", set_id, "q3", "1",
                         "--text", "  the typed answer  ")
        ck(rc == 0, "answer accepts a choice index AND text together (rc=%d)" % rc)
        cur = get_set(set_id) or {}
        q3 = next((q for q in cur.get("questions", [])
                   if q.get("qid") == "q3"), {})
        ck(q3.get("answer") == "the typed answer",
           "a TYPED answer WINS over the pre-checked radio (%r)"
           % q3.get("answer"))
        ck(q3.get("answer_kind") == "text",
           "\u2026and the record says which it was: answer_kind=%r"
           % q3.get("answer_kind"))
        ck(q3.get("selected_option") == 1,
           "\u2026with the selected index KEPT as context (%r)"
           % q3.get("selected_option"))
        # The discriminator: an index with NO text must still record the option.
        rc, out, _ = run("ask", "--factory", set_id, "--title", "index only",
                         "--description", "d", "--option", "A", "--option", "B")
        rc, out, _ = run("answer", set_id, "q4", "0")
        cur = get_set(set_id) or {}
        q4 = next((q for q in cur.get("questions", [])
                   if q.get("qid") == "q4"), {})
        ck(q4.get("answer") == "A" and q4.get("answer_kind") == "option",
           "an index with NO text still records the OPTION (%r/%r)"
           % (q4.get("answer"), q4.get("answer_kind")))

        # -- 5b-2. an EMPTY clarify is a COMPLETE request (#183, 2026-09-26,
        # superseding this probe's same-titled 2026-09-25 predecessor, which
        # asserted the refusal rc=2). The property protected — unchanged in
        # kind, changed in mechanism: a Clarify transition must carry CONTENT
        # the asking lane can act on. The 2026-09-25 defect was answer=None
        # behind "CLARIFY REQUESTED"; the remedy then was to refuse the tap.
        # #183 ruled the remedy wrong: the owner owes no payload — the click
        # IS the request — so the tool now supplies the click's meaning
        # (CLARIFY_EMPTY_TEXT) when no --text comes. Owner text, when
        # supplied, is the request verbatim and wins. Half (ii) of the same
        # 2026-09-25 report stays: the clarifying state must be VISIBLE on
        # the page, not rendered identically to an open one.
        rc, out, _ = run("ask", "--factory", set_id, "--title", "clarify guard",
                         "--description", "d", "--option", "A")
        ck(rc == 0, "a question is registered to test the clarify guard (rc=%d)" % rc)
        _cq = (get_set(set_id) or {}).get("questions", [{}])[-1].get("qid")
        rc, out, err = run("answer", set_id, _cq, "clarify")
        ck(rc == 0, "an EMPTY clarify is ACCEPTED rc=0 (rc=%d, err=%r)"
           % (rc, (err or "").strip()[:70]))
        _gq = (get_set(set_id) or {}).get("questions", [{}])[-1]
        ck(_gq.get("status") == "clarifying",
           "\u2026the tap alone transitions the question to clarifying "
           "(status=%r)" % (_gq.get("status"),))
        ck(bool((_gq.get("answer") or "").strip()),
           "\u2026and the transition CARRIES content, never answer=None "
           "(answer=%r)" % (_gq.get("answer"),))
        ck(_gq.get("answer") == CLARIFY_EMPTY_TEXT,
           "\u2026naming the click's meaning via the tool default")
        ck(_gq.get("answer_kind") == "clarify",
           "\u2026with answer_kind=clarify")
        rc, out, _ = run("answer", set_id, _cq, "clarify", "--text", "which option?")
        ck(rc == 0, "a clarify WITH text is still accepted (rc=%d)" % rc)
        _gq2 = (get_set(set_id) or {}).get("questions", [{}])[-1]
        ck(_gq2.get("answer") == "which option?",
           "\u2026and OWNER text WINS over the tool default when supplied "
           "(answer=%r)" % (_gq2.get("answer"),))
        ck(_gq2.get("status")
           == "clarifying", "\u2026and records the clarifying state")
        rc, out, _ = run("publish", "--json")
        _uidir = json.loads(out)["path"]
        _body = open(os.path.join(_uidir, "index.html"), encoding="utf-8").read()
        ck('class="chip clarifying"' in _body,
           "the page RENDERS the clarifying state, so a reload shows the change")
        ck(">clarifying<" in _body,
           "\u2026as a chip on the card's own context line, not a band")
        # The band carried the reader's own request. Removing it must not put
        # those words out of reach: the chip carries them as its native tooltip,
        # so clarifyText stays a READ field rather than a dead write.
        ck('title="you requested: which option?"' in _body,
           "\u2026carrying the reader's own request as its tooltip, so the words "
           "the band used to print stay reachable from the page")
        # Owner order 2026-09-27: a clarifying question waits on the LANE, so
        # it must not occupy the space of an actionable one. It renders compact
        # and its form collapses behind a native <details> -- while staying in
        # the DOM, so the question is still answerable when opened.
        ck('class="q clarifying"' in _body,
           "a clarifying question renders COMPACT, not as an actionable one")
        ck('<details class="clarifybox">' in _body,
           "\u2026with its form collapsed behind a native <details>")
        ck('<summary' in _body,
           "\u2026and a summary toggle that opens it (native HTML, no JS)")
        ck('name="qid" value="%s"' % _cq in _body,
           "\u2026and the form is STILL in the DOM, so it stays answerable "
           "(qid=%s)" % _cq)
        # Owner order 2026-09-27: the recommendation band folds the same way --
        # a compact label, the lane's counsel one tap away -- so the card opens
        # on the QUESTION. The counsel stays in the DOM: folding is visual only.
        rc, out, _ = run("ask", "--factory", "f-rec-lane", "--title", "r",
                         "--description", "d", "--option", "a", "--option", "b",
                         "--recommended", "0", "--json")
        ck(rc == 0, "a question WITH a recommendation registers (rc=%d)" % rc)
        rc, out, _ = run("publish", "--json")
        _rdir = json.loads(out)["path"]
        _rbody = open(os.path.join(_rdir, "index.html"), encoding="utf-8").read()
        ck('<details class="recbox">' not in _rbody,
           "the recommendation band does NOT fold (owner order 2026-09-30)")
        ck('<p class="rec">' in _rbody and ".rec::before" in _rbody,
           "\u2026and its label is generated content, since the summary that "
           "carried it is gone")
        _rm = re.search(r'<p class="rec">(.*?)</p>', _rbody, re.S)
        ck(_rm is not None and _rm.group(1).strip() == "a",
           "\u2026and the counsel renders as the option string itself, under a "
           "label the stylesheet generates (got %r)"
           % (_rm.group(1).strip() if _rm else None))
        _uijs = open(os.path.join(_uidir, "questions.js"), encoding="utf-8").read()
        ck("htmx:responseError" in _uijs,
           "the vendored UI surfaces a REFUSED submit -- htmx swaps only 2xx, "
           "so a 400 was previously invisible to the reader")
        # (iii) amend must clear answer_kind WITH the answer. Found live: q14
        # read status=open, answer=None, answer_kind="clarify" after a clarify
        # was amended back open -- a durable record asserting something untrue.
        rc, out, _ = run("amend", "--set", set_id, "--qid", _cq,
                         "--description", "d2")
        ck(rc == 0, "a clarified question can be amended back open (rc=%d)" % rc)
        _aq = (get_set(set_id) or {}).get("questions", [{}])[-1]
        ck(_aq.get("status") == "open" and not _aq.get("answer")
           and not _aq.get("answer_kind"),
           "\u2026and amend clears answer AND answer_kind together "
           "(status=%r answer=%r kind=%r)"
           % (_aq.get("status"), _aq.get("answer"), _aq.get("answer_kind")))

        # -- 5c. withdraw — the moot-question exit (HQ 2026-09-25) -----------
        # "withdrawn" was in CLOSED_STATUSES and named by the law, but nothing
        # wrote it: a lane whose question went moot had no way to retract it.
        rc, out, _ = run("ask", "--factory", set_id, "--title", "moot",
                         "--description", "d")
        ck(rc == 0, "a question to withdraw registers (rc=%d)" % rc)
        rc, out, _ = run("withdraw", "--set", set_id, "--qid", "q5",
                         "--text", "became moot")
        ck(rc == 0, "withdraw closes a moot question (rc=%d)" % rc)
        cur = get_set(set_id) or {}
        q5 = next((q for q in cur.get("questions", [])
                   if q.get("qid") == "q5"), {})
        ck(q5.get("status") == "withdrawn",
           "\u2026status is withdrawn (%r)" % q5.get("status"))
        ck(q5.get("withdrawn_reason") == "became moot",
           "\u2026the reason is recorded (%r)" % q5.get("withdrawn_reason"))
        ck(question_is_closed(q5),
           "\u2026and it counts as CLOSED, so it leaves the open total")
        rc, out, _ = run("withdraw", "--set", set_id, "--qid", "q5")
        ck(rc == 3, "a re-withdraw is idempotent rc=3 (rc=%d)" % rc)
        rc, out, _ = run("withdraw", "--set", set_id)
        ck(rc == 2, "withdraw without --qid is a usage error (rc=%d)" % rc)

        # -- 5d. the help text documents the flags that EXIST (HQ 2026-09-25)
        # The help opened with `ask --lane <NAME>` -- a flag that now exits 2 --
        # and never mentioned --factory, the one flag you cannot call without.
        rc, out, _ = run("--help")
        ck(rc == 0, "help exits 0 (rc=%d)" % rc)
        ck("--factory" in out,
           "help documents --factory (the required flag)")
        synopsis = [ln for ln in out.splitlines()
                    if ln.strip().startswith("ask ")][0]
        ck("--factory" in synopsis and "--lane" not in synopsis,
           "the ask SYNOPSIS is --factory and carries no --lane (%r)"
           % synopsis.strip())
        ck("withdraw" in out, "help lists the withdraw verb")
        ck("pages/<slug>/" in out,
           "help names the constant-slug page path, not pages/<token>/")

        # -- 6. lint --------------------------------------------------------
        # --lane was REMOVED (owner order 2026-09-25): the lane is resolved
        # from the asking session's own binding, so a caller cannot label
        # itself and cannot mislabel where an answer came from.
        rc, _, err = run("ask", "--lane", "Cron lane", "--title", "t",
                         "--description", "d")
        ck(rc == 2 and "--lane" in err,
           "ask REJECTS the removed --lane flag (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-leaky-lane",
                       "--questions-json", json.dumps([
                           {"title": "Leak", "description": "key at /root/x"}]))
        ck(rc == 0, "a name lane with leaky text still registers (lint, not ask, judges it)")
        rc, out, _ = run("lint", "--json")
        findings = json.loads(out)["findings"]
        ck(rc == 1 and any("secret" in f["why"] for f in findings),
           "lint finds the secret pattern and returns rc=1")

        # -- 7. gc: TTL expiry ---------------------------------------------
        path = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        data = store_json()
        for item in data["sets"]:
            if item["id"] == "f-leaky-lane":
                for _q in item["questions"]:
                    _q["asked_at"] = "2020-01-01T00:00:00+00:00"
        with open(path, "w", encoding="utf-8") as fh:
            json.dump(data, fh)
        rc, out, _ = run("gc", "--dry-run", "--json")
        dry = json.loads(out)
        ck(dry["expired"] >= 1 and dry["archived"] == 0,
           "gc --dry-run reports the expiry without writing (expired=%d)" % dry["expired"])
        rc, out, _ = run("gc", "--json")
        result = json.loads(out)
        ck(result["expired"] >= 1,
           "gc expires the QUESTION (expired=%d)" % result["expired"])
        ck(result["archived"] == 0,
           "…and archives NOTHING without --archive-closed (%d)"
           % result["archived"])
        leaked = get_set("f-leaky-lane")
        ck(leaked is not None and leaked.get("status") == "open",
           "…so the factory set is STILL in the live register")
        ck(any(q.get("status") == "expired"
               for q in (leaked or {}).get("questions", [])),
           "…while its question is expired")
        rc, out, _ = run("gc", "--archive-closed", "--json")
        ck(json.loads(out)["archived"] >= 1,
           "gc --archive-closed archives it on EXPLICIT request (archived=%d)"
           % json.loads(out)["archived"])

        # -- 8. publish: token, noindex, TTL, prune ------------------------
        rc, _, _ = run("ask", "--factory", "f-page-lane",
                       "--questions-json", json.dumps([
                           {"title": "Rendered?",
                            "description": "| option | cost |\n|---|---|\n"
                                           "| 6h | 4/day |\n| 12h | 2/day |\n\n"
                                           "```mermaid\nflowchart TD\n  A --> B\n```",
                            "options": ["6h", "12h"], "recommended": 0}]))
        ck(rc == 0, "a description with a table and a mermaid fence registers")
        rc, out, _ = run("publish", "--json")
        page = json.loads(out)
        ck(rc == 0 and page["slug"] == page_slug(page["slug"]),
           "the page path is a SLUG, not a rotating token (%r)" % page["slug"])
        ck("token" not in page and "token" not in page["meta"],
           "…and there is no second name for it (the retired token key is gone)")
        body = open(os.path.join(page["path"], "index.html"), encoding="utf-8").read()
        ck("noindex" in body, "the page carries the noindex directive")
        ck("<table>" in body, "a Markdown table in a description renders as a <table>")
        ck("mermaid.ink" in body, "a ```mermaid fence renders through mermaid.ink")
        ck('class="tblwrap"' in body,
           "\u2026and the table is wrapped in a scroll container (renderer-side, "
           "so a wide table cannot blow the viewport open)")
        # owner report 2026-09-24 21:05Z: "not mobile friendly". Root cause: the
        # shell declared NO viewport at all, so a phone laid the page out at a
        # ~980px virtual width and zoomed out to fit -- tiny text, desktop
        # geometry. The stylesheet was desktop-only besides.
        ck('name="viewport"' in body and "width=device-width" in body,
           "the page declares a viewport (absent it a phone renders at ~980px "
           "and zooms out -- the owner-visible 'not mobile friendly')")
        ck("@media (max-width:40rem)" in body,
           "\u2026and the stylesheet carries a narrow-screen breakpoint")
        ck("*{box-sizing:border-box}" in body,
           "\u2026and a box-sizing reset so padding cannot overflow the viewport")
        ck(".tblwrap{overflow-x:auto" in body,
           "\u2026and the scroll wrapper has a rule to go with it")
        # owner-visible misrender: the emitted form had NO stylesheet rule at
        # all, so a bare <textarea> (inline, ~20 columns by default) collapsed
        # the free-text field and both buttons onto one line.
        for _rule in ("form{", "textarea{"):
            ck(_rule in body, "the stylesheet carries the %s rule" % _rule)
        # The button rule moved from the descendant selector `form button{` to a
        # single `button{` when the page was restyled. Assert the PROPERTY that
        # fixed the owner-visible collapse -- a button rule carrying padding --
        # not the spelling of the selector, or a restyle passes on an unstyled
        # control.
        _btn = re.search(r"\nbutton\{([^}]*)\}", body)
        ck(_btn is not None and "padding" in _btn.group(1),
           "a button rule sizes the control (padding present)")
        # the age helper already ended in a unit word, so the call sites'
        # "asked " prefix rendered the double-worded "asked 1.7h old".
        _ages = set(re.findall(r"asked [0-9a-z.]* (ago|old)", body))
        ck(_ages == {"ago"},
           "the age paragraph is not double-worded (%r)" % (sorted(_ages),))
        # owner report 2026-09-24 22:24Z: "Why two expiration lines?" Two
        # emitters carried the same expiry -- the shell (page_wrapper) and the
        # Page catalog component. The shell then owned ONE visible line. The
        # owner removed even that (2026-09-27): the line said "permanent link",
        # carried nothing the reader needs, and sat above the h1 as the first
        # thing they met. The page carries NO meta line now -- permanence is
        # asserted on the page META (expires_at null, below), not in chrome.
        _ttl = body.count('class="meta">')
        ck(_ttl == 0,
           "the page carries NO meta line -- the 'permanent link' accretion "
           "above the h1 is gone (%d found)" % _ttl)
        ck("permanent link" not in body,
           "\u2026and no 'permanent link' text survives anywhere on the page")
        meta = json.load(open(os.path.join(page["path"], "meta.json"), encoding="utf-8"))
        ck(meta.get("expires_at") is None,
           "meta carries expires_at as null -- the backend fails OPEN on it "
           "(%r)" % (meta.get("expires_at"),))
        rc, _, _ = run("render", "--set", set_id, "--json")
        ck(rc == 2, "the DELETED render verb is unknown -> rc=2 (rc=%d)" % rc)

        # Prune is SHAPE-keyed now: a retired rotating-token directory is
        # residue nothing can address. The LIVE slug must survive, because its
        # link is the owner's permanent bookmark.
        legacy = os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                              "A" * 32)
        os.makedirs(legacy, exist_ok=True)
        open(os.path.join(legacy, "index.html"), "w").write("stale")
        rc, out, _ = run("publish", "--prune", "--json")
        pruned = json.loads(out).get("pruned", [])
        ck(not os.path.exists(legacy),
           "a retired rotating-token dir is pruned by publish --prune")
        ck("A" * 32 in pruned,
           "…and the pruned dir is reported, not removed silently")
        ck(os.path.isfile(os.path.join(page["path"], "index.html")),
           "…while the PERMANENT slug page is never pruned")

        # -- 8b. C7: the page URL is STABLE across re-renders, and C4:
        # a register mutation re-publishes the page. Owner: "I want the page to
        # be rerendered after each question list set of changes". Implemented
        # against a mint-per-publish token, that 404s the link he bookmarked --
        # so re-render-on-change and a stable URL have to hold together.
        ck(page_url("tok") == base_url() + "/tok/",
           "page_url joins the base origin and the token")
        saved_base = os.environ.pop("OC_QUESTIONS_BASE_URL", None)
        ck(base_url() == PRODUCTION_BASE_URL,
           "with no override the base origin is the production host (%s)" % base_url())
        if saved_base is not None:
            os.environ["OC_QUESTIONS_BASE_URL"] = saved_base

        rc, out, _ = run("publish", "--json")
        first = json.loads(out)
        pointer = os.path.join(env["OC_QUESTIONS_DIR"], "pages", "latest.json")
        ck(os.path.isfile(pointer),
           "publish records pages/latest.json -- the pointer the tool reads")
        # -- the ontology collapse (owner order 2026-09-27) ---------------
        # The pointer used to be a byte-identical COPY of the page meta, two
        # names stood for one value (token/slug, factory/id), and five fields
        # were written that NOTHING read. A write-only field is not idle
        # bytes: `answered_at` was the same class and it disagreed with
        # `status` on amended rows, which is what made a reader report healthy
        # rows as contradictory. Asserted on the ARTIFACTS so a later edit
        # that reintroduces one is caught here rather than in the register.
        _oq_ptr = json.load(open(pointer, encoding="utf-8"))
        ck(list(_oq_ptr) == ["slug"],
           "the pointer is the slug and NOTHING else -- not a copy of the "
           "page meta (%r)" % (list(_oq_ptr),))
        _oq_top = json.load(open(os.path.join(env["OC_QUESTIONS_DIR"],
                                             "open.json"), encoding="utf-8"))
        ck("version" not in _oq_top,
           "\u2026and the register carries no top-level version (write-only)")
        _oq_set = _oq_top["sets"][0]
        ck("factory" not in _oq_set and _oq_set.get("id"),
           "\u2026the set names itself ONCE, as id, never also as factory "
           "(%r)" % (sorted(_oq_set),))
        ck("updated_at" not in _oq_set,
           "\u2026and carries no set-level updated_at (write-only)")
        _oq_q = (_oq_set.get("questions") or [{}])[0]
        ck("amended_at" not in _oq_q and "withdrawn_at" not in _oq_q,
           "\u2026nor per-question amended_at / withdrawn_at (write-only) "
           "(%r)" % (sorted(_oq_q),))
        _oq_meta = json.load(open(os.path.join(os.path.dirname(pointer),
                                              _oq_ptr["slug"], "meta.json"),
                                 encoding="utf-8"))
        ck("token" not in _oq_meta and "created_at" not in _oq_meta
           and "rotated_at" not in _oq_meta,
           "\u2026and the page meta drops token / created_at / rotated_at "
           "(%r)" % (sorted(_oq_meta),))
        _oq_rc, _oq_out, _oq_err = run("publish", "--set", first["slug"])
        ck(_oq_rc == 2 and "--set" in _oq_err,
           "publish REFUSES --set, naming where it belongs -- it addresses "
           "ONE set, and the page carries every open set (rc=%d)" % _oq_rc)
        rc, out, _ = run("publish", "--json")
        second = json.loads(out)
        ck(second["slug"] == first["slug"],
           "two consecutive publishes REUSE one slug -- the URL does not churn "
           "(%r vs %r)" % (first["slug"][:8], second["slug"][:8]))
        page_dirs = sorted(d for d in os.listdir(os.path.join(env["OC_QUESTIONS_DIR"], "pages"))
                           if d != "latest.json")
        _want_pages = sorted(p["slug"] for p in second["pages"])
        # Every TARGET has a directory -- but not set equality. A factory whose
        # set LEAVES the register (only via an explicit `gc --archive-closed`;
        # factory sets are never auto-archived, owner order 2026-09-25) keeps its
        # page directory, because the address is a permanent anchor. Nothing
        # removes a readable slug, so the directory outlives the target.
        ck(set(_want_pages) <= set(page_dirs),
           "\u2026and every published target HAS a directory -- the aggregate "
           "plus one per factory the register names, never one per publish "
           "(missing %r)" % (sorted(set(_want_pages) - set(page_dirs)),))
        ck("all" in page_dirs,
           "\u2026including the neutral aggregate /all/, the one address that is "
           "not a factory name (%r)" % (page_dirs,))

        # -- the TWO-ADDRESS model (owner order 2026-09-28) ----------------
        # The page used to carry every factory's questions while being served
        # from ONE factory's name, so the path named a factory and the content
        # was the fleet -- and the union had no address at all. Asserted on the
        # ARTIFACTS: the published metas, and each page's own HTML.
        _reg = store_json()
        _open_ids = sorted(s["id"] for s in _reg["sets"] if s.get("status") == "open")
        _agg = json.load(open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                          "all", "meta.json"), encoding="utf-8"))
        ck(_agg["slug"] == "all",
           "the aggregate is published at the NEUTRAL slug /all/ -- not under a "
           "factory's name (%r)" % _agg["slug"])
        ck(sorted(_agg["sets"]) == _open_ids,
           "\u2026and it carries EVERY open set in the register, so the union has "
           "an address of its own (%r vs %r)" % (sorted(_agg["sets"]), _open_ids))

        _factory_pages = [p for p in second["pages"] if p["slug"] != "all"]
        ck(len(_factory_pages) >= 2,
           "\u2026while every factory the register names gets its OWN page "
           "(%d factory page(s))" % len(_factory_pages))
        _bad = []
        for _p in _factory_pages:
            _m = json.load(open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                             _p["slug"], "meta.json"),
                                encoding="utf-8"))
            # ONLY its own: every set it lists must be one that slugifies to it.
            if any(page_slug(_sid) != _p["slug"] for _sid in _m["sets"]):
                _bad.append((_p["slug"], _m["sets"]))
        ck(not _bad,
           "\u2026each of which carries ONLY its own sets, never another "
           "factory's (%r)" % (_bad,))
        _mine = {p["slug"]: p["sets"] for p in _factory_pages}
        ck(all(_s in _mine.get(page_slug(_s), []) for _s in _open_ids),
           "\u2026and every open set is reachable on its OWN factory page "
           "(missing %r)" % (sorted(s for s in _open_ids
                                    if s not in _mine.get(page_slug(s), [])),))

        # The answerability property, from the RENDERED side: the answer backend
        # accepts a posted set iff it is listed in that page's meta.sets, so a
        # card that renders under a set the page does not list is unanswerable.
        _unanswerable = []
        for _slug in ["all"] + [p["slug"] for p in _factory_pages]:
            _dir = os.path.join(env["OC_QUESTIONS_DIR"], "pages", _slug)
            _h = open(os.path.join(_dir, "index.html"), encoding="utf-8").read()
            _m = json.load(open(os.path.join(_dir, "meta.json"), encoding="utf-8"))
            listed = set(_m["sets"])
            rendered = set()
            for _grp in re.findall(r'data-set="([^"]+)"', _h):
                rendered.update(x for x in _grp.split(",") if x)
            posted = set(re.findall(r'name="set" value="([^"]+)"', _h))
            if not (rendered <= listed) or not (posted <= listed):
                _unanswerable.append((_slug, sorted(rendered - listed),
                                      sorted(posted - listed)))
        ck(not _unanswerable,
           "\u2026and every set a page RENDERS is listed in that page's own "
           "meta.sets, so no card is rendered unanswerable (slug, rendered-vs-"
           "meta, posted-vs-meta: %r)" % (_unanswerable,))

        # The ECHO the answer backend reads (S1, 2026-10-02). The confirmation
        # page's lane + question title used to come from a mirror of the whole
        # register on the public host; they now come from the page's OWN meta, so
        # every set a page lists must carry its echo and every value must be a
        # plain string. The reader lives OUTSIDE this repo (the vpn backend), so
        # this assertion is the declared consumer's proxy -- a page without an
        # echo would name every lane "the asking lane" and print the qid as the
        # title, silently. A session id must never appear here.
        _echo_bad = []
        for _slug in ["all"] + [p["slug"] for p in _factory_pages]:
            _m = json.load(open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                             _slug, "meta.json"), encoding="utf-8"))
            _e = _m.get("echo")
            if not isinstance(_e, dict) or sorted(_e) != sorted(_m["sets"]):
                _echo_bad.append((_slug, "sets", sorted(_m["sets"]),
                                  sorted(_e or {})))
                continue
            for _sid, _info in _e.items():
                if (not isinstance(_info, dict)
                        or not isinstance(_info.get("lane"), str)
                        or not isinstance(_info.get("questions"), dict)
                        or not all(isinstance(k, str) and isinstance(v, str)
                                   for k, v in _info["questions"].items())):
                    _echo_bad.append((_slug, "shape", _sid, _info))
        ck(not _echo_bad,
           "\u2026and every set a page lists carries its ECHO -- lane + per-qid "
           "title, keyed by set id, strings only -- so the answer backend names "
           "the lane without any mirrored register (%r)" % (_echo_bad,))

        # The address outlives the set: f-leaky-lane was archived by
        # `gc --archive-closed` and is no longer a target, yet its page dir --
        # and so its bookmark -- is still there. Nothing removes a readable slug.
        _archived_dir = os.path.join(env["OC_QUESTIONS_DIR"], "pages", "f-leaky-lane")
        ck(os.path.isdir(_archived_dir) and "f-leaky-lane" not in _want_pages,
           "\u2026and a page whose set LEFT the register keeps its directory, "
           "because the address is a permanent anchor (%s, target=%s)"
           % (os.path.isdir(_archived_dir), "f-leaky-lane" in _want_pages))
        rc, out, _ = run("publish", "--json")
        rotated = json.loads(out)
        ck(rotated["slug"] == first["slug"],
           "a re-publish re-renders IN PLACE: the slug cannot churn, because the "
           "link is permanent (%r)" % rotated["slug"])
        ck("rotated_at" not in rotated["meta"],
           "…and no rotation timestamp is recorded (the field was write-only)")
        rc, out, _ = run("publish", "--json")
        ck(json.loads(out)["slug"] == rotated["slug"],
           "\u2026and the slug is the one subsequently reused")

        # Owner report 2026-09-24: "it seems to fail when there are no
        # questions, but must deploy a no-open-questions page". Asserted on the
        # ARTIFACT (the page bytes), not on the message. A PRISTINE store is
        # used because the shared fixture store still holds open sets here --
        # running against it would measure those, not the empty state.
        empty_root = os.path.join(root, "empty-store")
        empty_env = dict(env)
        empty_env["OC_QUESTIONS_DIR"] = empty_root

        def run_empty(*args):
            proc = subprocess.run([tool] + list(args), env=empty_env,
                                  capture_output=True, text=True, timeout=90)
            return proc.returncode, proc.stdout, proc.stderr

        rc, out, err = run_empty("publish", "--json")
        ck(rc == 0, "publish with NOTHING open still exits 0 (rc=%d)" % rc)
        # Crash-free on purpose: json.loads on a pre-fix empty output raises,
        # and a selftest that dies mid-way reports NOTHING -- which reads as a
        # pass. Every step below degrades to a FAIL row instead.
        try:
            empty_meta = json.loads(out)
        except ValueError:
            empty_meta = {}
        empty_dir = os.path.join(empty_root, "pages", empty_meta.get("slug", "?"))
        ck(os.path.isfile(os.path.join(empty_dir, "index.html")),
           "\u2026and still writes index.html -- the page is always deployed")
        empty_body = ""
        try:
            with open(os.path.join(empty_dir, "index.html"),
                      encoding="utf-8") as fh:
                empty_body = fh.read()
        except OSError:
            pass
        ck("No open questions" in empty_body,
           "the empty page carries the empty state, not a stale question")
        ck('name="qid"' not in empty_body,
           "\u2026and names no question, so no tap can read as a failure")
        ck((empty_meta.get("meta") or {}).get("questions") == 0,
           "\u2026and reports 0 open questions, not a stale count")
        rc, out, _ = run_empty("publish", "--json")
        try:
            again = json.loads(out).get("meta", {}).get("slug")
        except ValueError:
            again = None
        ck(again is not None and again == empty_meta.get("slug"),
           "\u2026on the SAME slug -- an empty publish does not churn the URL")

        # C4: a mutation re-publishes, so the page is never hours stale.
        before = json.load(open(pointer, encoding="utf-8"))
        rc, out, _ = run("ask", "--factory", "f-republish-lane",
                         "--title", "t", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        ck(rc == 0, "ask with auto-republish exits 0 (rc=%d)" % rc)
        asked = json.loads(out)
        ck(asked.get("page", "").endswith(before["slug"] + "/"),
           "ask returns the page url (%r)" % asked.get("page"))
        after = json.load(open(pointer, encoding="utf-8"))
        ck(after.get("slug") == before["slug"],
           "the auto-republish did NOT move the URL (slug unchanged)")
        body = open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                 after["slug"], "index.html"), encoding="utf-8").read()
        ck("f-republish-lane" in body,
           "\u2026and the re-rendered page actually carries the new set")
        rc, out, _ = run("ask", "--factory", "f-no-publish-lane",
                         "--title", "t", "--description", "d", "--no-publish", "--json")
        ck(rc == 0 and json.loads(out).get("page") is None,
           "--no-publish suppresses the refresh (rc=%d)" % rc)

        # #189: the SAME renderer fault, on a MUTATION path. republish() is
        # best-effort by design, so the exit code must stay 0 AND the fault must
        # be named on the mutation's OWN output. The PUBLISH verb's four-half
        # probe below is unchanged: there the fault MUST fail the command.
        faulty = dict(env)
        faulty["OC_QUESTIONS_RENDER_DIR"] = "/proc/nonexistent/build"
        proc = subprocess.run(
            [tool, "ask", "--factory", "f-mutation-fault-lane",
             "--title", "t", "--description", "d",
             "--option", "a", "--option", "b", "--recommended", "0", "--json"],
            env=faulty, capture_output=True, text=True, timeout=120)
        ck(proc.returncode == 0,
           "a mutation whose auto-republish faults STILL exits 0 (rc=%d)"
           % proc.returncode)
        ck("NOT refreshed" in proc.stderr and "renderer fault" in proc.stderr,
           "\u2026and the fault is NAMED on the mutation's own output (%r)"
           % proc.stderr.strip()[-110:])
        ck("f-mutation-fault-lane" in [s.get("id") for s in store_json()["sets"]],
           "\u2026and the mutation's OWN work is on disk, not lost with the page")
        ck("f-mutation-fault-lane" in proc.stdout,
           "\u2026and the mutation still reports what it registered")

        # A publish fault must never fail the mutation that triggered it.
        rc, out, err = run("ask", "--factory", "f-broken-page-lane",
                           "--title", "t", "--description", "d", "--json",
                           "--no-publish")
        ck(rc == 0, "the mutation succeeds regardless of the page (rc=%d)" % rc)

        # -- 8b2. the json-render page (owner order 2026-09-24: "rewrite for
        # json-render"). The page BODY is now a typed SPEC rendered by a Node
        # process; the shell stays in Python. These are the four legs HQ asked
        # for, plus the two properties that would break the live endpoint.
        rc, out, _ = run("publish", "--json")
        page = json.loads(out)
        body = open(os.path.join(page["path"], "index.html"), encoding="utf-8").read()
        # The BROWSER TAB title names the page and how much is waiting on it
        # (owner order 2026-09-26). The subject is the FLEET, never the slug --
        # the slug is the path the page is SERVED FROM, not what it is. Read
        # from the RENDERED page, not the source: the title is emitted by the
        # shell, and only the artifact shows whether the derivation reached it.
        _t = re.search(r"<title>([^<]*)</title>", body)
        ck(_t is not None, "the page carries a <title>")
        ck(_t.group(1) == "Factory Open Questions (%d)"
           % page["meta"]["questions"],
           "the tab title names the page and the open count (%r)"
           % (_t.group(1),))
        ck(page["slug"] not in _t.group(1),
           "the tab does NOT print the slug as the page's subject (%r)"
           % (_t.group(1),))
        # NON-VACUITY, in a fixture BUILT to distinguish the two counts: ONE
        # open set holding TWO open questions. The assertion above cannot see
        # the difference, because the main fixture happens to hold exactly one
        # question per set -- sets and questions are both 9 there, so a title
        # built from the set count would satisfy it. len(sets) is the tempting
        # wrong answer: it is the count build_page already holds.
        _count_store = os.path.join(root, "count-store")
        os.makedirs(_count_store, exist_ok=True)
        with open(os.path.join(_count_store, "open.json"), "w",
                  encoding="utf-8") as fh:
            json.dump({"sets": [{
                "id": "f-count-lane", "status": "open", "lane": "Count Lane",
                "asked_at": None,
                "questions": [
                    {"qid": "c1", "title": "one", "status": "open",
                     "lane": "Count Lane", "asked_at": None},
                    {"qid": "c2", "title": "two", "status": "open",
                     "lane": "Count Lane", "asked_at": None}]}]}, fh)
        _saved_dir = env["OC_QUESTIONS_DIR"]
        env["OC_QUESTIONS_DIR"] = _count_store
        try:
            rc, out, err = run("publish", "--json")
            ck(rc == 0, "a one-set/two-question register publishes (rc=%d)" % rc)
            _p = json.loads(out)
            ck(len(_p["meta"]["sets"]) == 1 and _p["meta"]["questions"] == 2,
               "\u2026and the fixture distinguishes them (sets=%d questions=%d)"
               % (len(_p["meta"]["sets"]), _p["meta"]["questions"]))
            _html = open(os.path.join(_p["path"], "index.html"),
                         encoding="utf-8").read()
            _t2 = re.search(r"<title>([^<]*)</title>", _html)
            ck(_t2 is not None
               and _t2.group(1) == "Factory Open Questions (2)",
               "the tab counts OPEN QUESTIONS, never sets (%r)"
               % (_t2.group(1) if _t2 else None,))
            # -- the per-factory filter (owner order 2026-09-27) ----------
            # The page carries EVERY open factory's questions; the filter
            # narrows the view to one. Asserted on the DELIVERED files: the
            # control must be an ENHANCEMENT (built by the script, absent
            # from the markup) and the sections must carry the data-set the
            # script reads. Lose either half and the filter silently does
            # nothing while every other arm stays green.
            _oq_js = open(os.path.join(_p["path"], "questions.js"),
                          encoding="utf-8").read()
            ck("filterbar" in _oq_js and "data-set" in _oq_js,
               "\u2026and the vendored UI carries the per-factory filter")
            _oq_body = _html.split("<body", 1)[-1]
            ck("filterbar" not in _oq_body,
               "\u2026which the SCRIPT builds, so the page reads in full "
               "with JS disabled -- a control in the markup would be a dead "
               "one")
            ck(".filterbar" in _html,
               "\u2026with the CSS the bar needs shipped on the page")
            ck('class="set"' in _oq_body and 'data-set="' in _oq_body,
               "\u2026over sections that carry the data-set it reads -- "
               "without either half the filter silently does nothing")
            # Owner order 2026-09-28 (14:32): the factory name sits in the
            # SECTION heading, not beside each question's own title -- the card
            # already carries its context on a bottom line. Asserted as a COUNT
            # against the sections, so the arm cannot go green on one page-level
            # tag, and the card-heading arm below pins the OTHER half: the chip
            # must not come back beside a question title.
            _sections = _html.count('class="set"')
            _sectags = _html.count('class="qset"')
            ck(_sectags == _sections and _sections > 0,
               "every lane SECTION heading names its OWN factory/ies "
               "(%d tag(s), %d section(s))" % (_sectags, _sections))
            # The negative half: no question heading may carry the chip. This is
            # what makes the move a MOVE rather than an addition -- without it a
            # page carrying both placements would pass the count above.
            _qheads = re.findall(r'<h3 class="qt">(.*?)</h3>', _oq_body, re.S)
            ck(bool(_qheads)
               and all('qset' not in head for head in _qheads),
               "no question heading carries the factory chip any more "
               "(%d heading(s) checked)" % len(_qheads))
            # Owner order 2026-09-28 (15:5x): the card's own CONTEXT LINE --
            # "asked .. / lane .. / set qid" -- OPENS the card, before the
            # title. It is the context a reader needs in order to read the
            # question, so it belongs above it, not as a footnote under the
            # form. Asserted POSITIONALLY over the card's own body, because a
            # page-level count cannot tell a line at the top from one at the
            # bottom -- the failure this arm exists to catch.
            _cards = re.findall(r'<section id="[^"]*" class="q[^"]*">(.*?)</section>',
                                _oq_body, re.S)
            _ordered = [c for c in _cards
                        if c.find('class="age"') >= 0 and c.find('class="qt"') >= 0]
            ck(bool(_ordered)
               and all(c.find('class="age"') < c.find('class="qt"')
                       for c in _ordered),
               "the card's context line opens the card, above its own title "
               "(%d card(s) checked)" % len(_ordered))
            # Owner order 2026-09-30: that line carries the CARD's own facts
            # only -- its age and its qid, one separator. The lane and the
            # factory moved to the section heading and the selector, so a card
            # repeating them said the same thing twice. Asserted on the
            # separator COUNT, because a page-level check cannot tell which
            # facts a line carries.
            _ctx = re.findall(r'<p class="age">(.*?)</p>', _oq_body, re.S)
            ck(bool(_ctx) and all(c.count(" / ") == 1 for c in _ctx),
               "the context line drops the lane and the factory name "
               "(%d line(s) checked)" % len(_ctx))
            # Owner order 2026-09-28: the selector names each factory's OPEN
            # COUNT. A lane section can span two sets, so the count is derived
            # from each CARD's own set field -- both halves must ship, or the
            # bar silently shows a bare name again.
            ck('input[name="set"]' in _oq_js and "counts[" in _oq_js,
               "\u2026and the selector derives each factory's open count from "
               "the cards' own set fields")
            ck("counts[f]" in _oq_js,
               "\u2026naming it on the button, not a bare factory name")
            # The section's data-set must name only factories it HOLDS a card
            # for: a lane also carries CLOSED questions, and naming their
            # factory here put a control on the selector for a block with none
            # of that factory's cards in it.
            _leaks = []
            for _chunk in _oq_body.split('<section id="lane-')[1:]:
                _names = re.search(r'data-set="([^"]*)"', _chunk)
                _names = set(x for x in (_names.group(1).split(",") if _names else []) if x)
                _held = set(re.findall(r'name="set" value="([^"]+)"', _chunk))
                if not _names <= _held:
                    _leaks.append((sorted(_names - _held), sorted(_held)))
            ck(not _leaks,
               "\u2026and a section names only the factories whose cards it "
               "holds, so no selector control scopes another factory's question "
               "(leaked, held: %r)" % (_leaks,))
        finally:
            env["OC_QUESTIONS_DIR"] = _saved_dir
        # Owner question 2026-09-24: the answer form should swap inline instead
        # of navigating. htmx breaks "no <script> at all", but the property that
        # mattered was NO CLIENT-SIDE LOGIC OF OUR OWN -- so the assertion
        # narrows instead of being deleted: at most ONE script, it must be the
        # vendored htmx from our own origin, and it must have a src (an INLINE
        # body is the thing the original leg actually guarded against).
        scripts = re.findall(r"<script\b[^>]*>", body, re.I)
        # TWO vendored files now: htmx, and our own questions.js affordance
        # (owner report 2026-09-25 -- the pre-checked radio was still selected
        # while the reader typed, and the typed answer used to be discarded).
        # The property the original leg guarded was NO CLIENT-SIDE LOGIC OF
        # OURS, so it is restated rather than deleted: every script must have a
        # src, every src must be a file VENDORED beside the page, and no script
        # may carry an inline body. An exact count is kept -- a ceiling is not
        # a presence test, and an unbounded count would accept an injected tag.
        ck(len(scripts) == 2,
           "1. exactly two <script> tags on the page (found %d)" % len(scripts))
        srcs = re.findall(r'<script\b[^>]*src="([^"]+)"', body, re.I)
        ck(sorted(srcs) == sorted([HTMX_FILE, UI_FILE]),
           "\u2026both VENDORED by name, from our own origin (%r)" % srcs)
        ck(not re.search(r"<script(?![^>]*\bsrc=)[^>]*>", body, re.I),
           "\u2026with no INLINE script body anywhere (the real guard)")

        # #562: the form swaps its own block in place instead of navigating.
        # Asserted on the FORM, and the target must name the section the
        # renderer actually emits -- a target that matches nothing swaps
        # nothing, which looks identical to htmx not loading.
        form_tag = re.search(r"<form\b[^>]*>", body)
        ck(form_tag is not None, "the page renders a <form>")
        form_html = form_tag.group(0) if form_tag else ""
        ck('hx-post="/answer"' in form_html,
           "the form carries hx-post=/answer (the inline swap)")
        # The target is an ATTRIBUTE selector: a CSS selector may not start
        # with a digit, so '#19f2d7-q1' made htmx throw on querySelectorAll
        # (owner report 2026-09-25). The selector is HTML-escaped in the
        # attribute, so its quotes arrive as &#x27;.
        target = re.search(r"hx-target=\"\[id=(?:&#x27;|')([^&']+)(?:&#x27;|')\]\"",
                           form_html)
        ck(target is not None, "\u2026and an hx-target (%r)" % form_html[:160])
        section_ids = re.findall(r'<section id="([^"]+)"', body)
        ck(target is not None and target.group(1) in section_ids,
           "\u2026naming a section the page actually renders (%r in %r)"
           % (target.group(1) if target else None, section_ids))
        ck(target is not None and not target.group(1)[:1].isdigit(),
           "\u2026and the target is valid for ANY id: a selector may not start "
           "with a digit, which is why it is an attribute selector")
        ck('hx-swap="outerHTML"' in form_html,
           "\u2026with outerHTML, so the answered block replaces the question")
        # The vendored file must sit BESIDE the page: a same-origin script is
        # the whole reason this is vendored rather than pulled from a CDN.
        # page["path"] IS the token dir -- dirname() of it is the pages ROOT,
        # which is what an earlier version of this leg checked, so it looked
        # for htmx beside the wrong thing.
        vendored = os.path.join(page["path"], HTMX_FILE)
        ck(os.path.isfile(vendored),
           "htmx is VENDORED beside the page (same origin, no CDN dependency)")
        ck(os.path.isfile(vendored) and os.path.getsize(vendored) > 10000,
           "\u2026and is a real payload, not a stub or an error page")
        ui = os.path.join(page["path"], UI_FILE)
        ck(os.path.isfile(ui),
           "questions.js is VENDORED beside the page too (same origin)")
        ui_body = open(ui, encoding="utf-8").read() if os.path.isfile(ui) else ""
        ck("textarea" in ui_body and "radio" in ui_body,
           "\u2026and it wires the text box to the radios (the exclusivity)")
        ck('name="token"' in body and 'name="set"' in body and 'name="qid"' in body,
           "2. the form carries token + set + qid as hidden inputs -- the submit "
           "contract the answer backend reads")
        ck('action="/answer"' in body,
           "\u2026and the action is the absolute /answer path")
        ck("noindex" in body, "\u2026and the noindex directive survives the rewrite")
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation.
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation. The
        # assertion is attribute-ORDER agnostic on purpose: React emits
        # checked="" BEFORE value, the Python fallback emits value="N" checked,
        # and a leg that assumes one order tests the renderer's ordering rather
        # than the recommendation.
        radios = re.findall(r"<input[^>]*type=\"radio\"[^>]*>", body)
        ck(bool(radios), "3. the page renders radio inputs")
        checked = [r for r in radios if "checked" in r]
        ck(len(checked) >= 1, "\u2026and a recommended option renders checked")
        ck(len(checked) < len(radios),
           "\u2026while a NON-recommended option does not (%d of %d checked)"
           % (len(checked), len(radios)))
        ck("<table>" in body and "mermaid.ink" in body,
           "4. a Markdown table and a ```mermaid fence still reach the page "
           "through RichText")

        # The spec is DATA, so its structure is assertable without parsing HTML
        # -- which is the whole reason for the rewrite.
        spec = build_spec([{"id": "abc123", "lane": "L", "asked_at": None,
                            "questions": [{"qid": "q1", "title": "T",
                                           "description": "d",
                                           "options": ["A", "B"],
                                           "recommended": 1,
                                           "lane": "L"}]}],
                          "tok", None, "/answer")
        ck(spec["root"] == "page" and spec["elements"]["page"]["type"] == "Page",
           "the spec has a named root element")
        ck(spec["elements"]["abc123-q1-o1"]["props"]["recommended"] is True
           and spec["elements"]["abc123-q1-o0"]["props"]["recommended"] is False,
           "\u2026and the recommended option is marked in the SPEC, not in a string")
        ck(all(isinstance(spec["elements"][k].get("children"), list)
               for k in spec["elements"]),
           "\u2026and every element carries a children LIST (the flat contract)")
        ck(set(spec["elements"]) >= {"page", "lane-l", "abc123-q1"},
           "the spec nests page -> LANE ANCHOR -> question by KEY")

        # --- the CONTENT is typed DATA too (owner: use json-render FULLY) -----
        rich = build_spec([{"id": "abc123", "lane": "L", "asked_at": None,
                            "questions": [{"qid": "q1", "title": "T", "lane": "L",
                                           "description":
                                               "## Head\n\nPara **b** *i* `c`.\n\n"
                                               "| a | b |\n|---|---|\n| 1 | 2 |\n\n"
                                               "```mermaid\nflowchart TD\n  A --> B\n```\n\n"
                                               "- x\n- y\n\n```py\nprint(1)\n```",
                                           "options": ["A"], "recommended": 0}]}],
                          "tok", "2026-01-01T00:00:00+00:00", "/answer")
        block_keys = [k for k in rich["elements"]["abc123-q1"]["children"]
                      if re.match(r"abc123-q1-b\d+$", k)]
        block_types = [rich["elements"][k]["type"] for k in block_keys]
        ck(block_types == ["Heading", "Paragraph", "Table", "Mermaid", "List",
                           "CodeBlock"],
           "3. a rich description emits SEPARATE typed block elements in document "
           "order, asserted on the SPEC and not on the HTML (%r)" % (block_types,))
        for _t in ("Heading", "Paragraph", "Table", "Mermaid", "List", "CodeBlock"):
            ck(_t in block_types, "5. the %s block is exercised by the spec" % _t)
        def _props_of(spec, wanted):
            """The first block's props of a given type, or None.

            next() without a default raises StopIteration, which ABORTS the
            selftest -- so a pre-port artifact that lacks the block reported no
            FAIL row and every leg after it silently never ran."""
            for _k in spec["elements"]:
                if spec["elements"][_k]["type"] == wanted:
                    return spec["elements"][_k]["props"]
            return None

        _tbl = _props_of(rich, "Table") or {}
        ck(bool(_tbl) and _tbl["headers"][0][0] == {"kind": "Text", "text": "a"}
           and _tbl["rows"][0][1][0]["text"] == "2",
           "\u2026and a table is structured DATA (headers + rows of typed spans), "
           "not an HTML string (%r)" % (_tbl,))
        _mer = _props_of(rich, "Mermaid") or {}
        ck("flowchart TD" in _mer.get("code", "")
           and "mermaid.ink" not in _mer.get("code", ""),
           "\u2026and Mermaid carries the CODE, so the component owns the URL "
           "(%r)" % (_mer,))
        _par = _props_of(rich, "Paragraph") or {}
        _kinds = [s["kind"] for s in _par.get("spans", [])]
        ck(_kinds == ["Text", "Strong", "Text", "Emphasis", "Text", "InlineCode",
                      "Text"],
           "\u2026and inline emphasis is typed SPANS, never an HTML fragment (%r)"
           % (_kinds,))
        ck(bool(_kinds) and not any("<" in s["text"]
                                    for s in _par.get("spans", [])),
           "\u2026and no span carries raw markup")

        # 6. the catalog is a GUARDRAIL: an unregistered type must be REJECTED,
        # not rendered as nothing.
        _bad = {"root": "page",
                "elements": {"page": {"type": "Page",
                                      "props": {"title": "t", "expires_at": "e"},
                                      "children": ["x"]},
                             "x": {"type": "Nope", "props": {}, "children": []}}}
        _html, _why = render_via_node(_bad)
        ck(_html is None and "rejected by the catalog" in (_why or ""),
           "6. an UNREGISTERED block type is REJECTED by the catalog's own "
           "validate(), not rendered as nothing and not merely thrown (%r)"
           % (_why,))

        # Owner order 2026-09-24: a renderer fault must fail the COMMAND, not
        # the page. Point the build dir at an impossible path and assert all
        # four halves: non-zero, reason on stderr, nothing written, last good
        # page byte-identical.
        before_dirs = sorted(os.listdir(pages_dir()))
        good_path = os.path.join(page["path"], "index.html")
        good_body = open(good_path, encoding="utf-8").read()
        broke = dict(env)
        broke["OC_QUESTIONS_RENDER_DIR"] = "/proc/nonexistent/build"
        proc = subprocess.run([tool, "publish"], env=broke,
                              capture_output=True, text=True, timeout=120)
        ck(proc.returncode != 0,
           "a renderer fault exits NON-ZERO (rc=%d)" % proc.returncode)
        ck("renderer fault" in proc.stderr,
           "\u2026and names the fault on stderr (%r)" % proc.stderr.strip()[-80:])
        ck(sorted(os.listdir(pages_dir())) == before_dirs,
           "\u2026and writes no page and creates no token dir (%r)"
           % (sorted(os.listdir(pages_dir())),))
        ck(open(good_path, encoding="utf-8").read() == good_body,
           "\u2026and the previous page is byte-identical, so the last good URL "
           "still serves instead of a 404")
        ck(render_via_node({"root": "page", "elements": {}})[1] is not None,
           "render_via_node reports a REASON on failure, never raises")

        # -- 8c. C5: amend -- the CLARIFY return leg. A Clarify click used to
        # dead-end: status=clarifying and the question could never be answered
        # again, so the loop never closed and the owner never saw the answer.
        rc, out, _ = run("ask", "--factory", "f-amend-lane",
                         "--title", "Original?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "clarify records status=clarifying")
        rc, out, _ = run("answer", am_set, "q1", "0")
        ck(rc == 0, "a clarifying question is still ANSWERABLE (rc=%d)" % rc)
        # amend on a set whose only question is answered: the set archived, so
        # amend must REPORT that rather than silently doing nothing.
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1", "--title", "x")
        ck(rc in (0, 1),
           "amend on a set with no open questions is handled explicitly "
           "(rc=%d)" % rc)
        # the real clarify loop, in order: ask -> clarify -> amend -> answer
        rc, out, _ = run("ask", "--factory", "f-clarify-lane",
                         "--title", "Clarify me?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "the clarify loop starts from a clarifying question")
        rc, out, _ = run("amend", "--set", am_set, "--qid", "q1",
                         "--title", "Rewritten?", "--description", "d2",
                         "--option", "x", "--option", "y", "--recommended", "1",
                         "--json")
        ck(rc == 0, "amend exits 0 (rc=%d)" % rc)
        amended = json.loads(out)
        ck(amended["status"] == "open" and amended["was"] == "clarifying",
           "amend returns the question to OPEN (%r -> %r)"
           % (amended["was"], amended["status"]))
        ck(amended["amend_count"] == 1, "amend records an amend count")
        question = get_set(am_set)["questions"][0]
        ck(question["title"] == "Rewritten?" and question["options"] == ["x", "y"]
           and question["recommended"] == 1,
           "amend applied title, options and recommendation together")
        ck("answer" not in question,
           "amend CLEARS the stale answer, so the reopened question is clean")
        rc, out, _ = run("answer", am_set, "q1", "1")
        ck(rc == 0 and "y" in out,
           "the amended question is answerable and records the new option")
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1")
        ck(rc == 2, "amend with no field to change is rc=2 (rc=%d)" % rc)
        rc, _, _ = run("amend", "--set", am_set, "--qid", "nope", "--title", "t")
        ck(rc == 1, "amend on an unknown qid is rc=1 (rc=%d)" % rc)

        # -- 8c-bis. MULTI-SELECT (owner order 2026-09-28). Questions may take
        # several options at once. The kind is QUESTION-LEVEL and FIXED AT ASK
        # TIME, and an absent kind means single -- so the register's pre-existing
        # questions keep rendering radios and no stored answer is reinterpreted.
        rc, out, _ = run("ask", "--factory", "f-multi-lane",
                         "--title", "Pick several", "--description", "d",
                         "--option", "A", "--option", "B", "--option", "C",
                         "--multi", "--json")
        ck(rc == 0, "a multi question registers (rc=%d)" % rc)
        multi_set = json.loads(out)["set"]
        mq = get_set(multi_set)["questions"][0]
        ck(mq.get("kind") == "multi",
           "the register RECORDS the kind rather than leaving a reader to infer "
           "it (kind=%r)" % (mq.get("kind"),))
        # The spec is what the renderer reads, so the control type is asserted
        # where it is decided -- and on BOTH the question and each option, since
        # a flat spec gives a component only its own props.
        _spec = build_spec([get_set(multi_set)], "t", None, "answer")
        _opts = [e for e in _spec["elements"].values() if e["type"] == "Option"]
        _qs = [e for e in _spec["elements"].values() if e["type"] == "Question"]
        ck(_qs and all(e["props"].get("multi") is True for e in _qs),
           "a multi question's spec carries multi=True on the Question")
        ck(_opts and all(e["props"].get("multi") is True for e in _opts),
           "\u2026and on EVERY option, so the renderer needs no parent context "
           "to pick the control (%d options)" % len(_opts))
        rc, out, _ = run("answer", multi_set, "q1", "0", "2", "--json")
        ck(rc == 0, "several choices are accepted on a multi question (rc=%d)" % rc)
        answered = get_set(multi_set)["questions"][0]
        ck(answered.get("answer") == ["A", "C"],
           "the answer records EVERY chosen option, in order (%r)"
           % (answered.get("answer"),))
        ck(answered.get("answer_kind") == "options",
           "\u2026and answer_kind says it is several, so a reader can tell one "
           "label from many without inspecting the option set (%r)"
           % (answered.get("answer_kind"),))
        # The comma-joined spelling is the SAME act: the answer backend posts one
        # `choice` field per checked box, and joining is how several reach the
        # CLI as one value. A FRESH factory, because the factory key IS the
        # standing set: asking into f-multi-lane again appends q2 and the arm
        # would address q1, which is already answered.
        rc, out, _ = run("ask", "--factory", "f-multi-comma-lane",
                         "--title", "Comma form", "--description", "d",
                         "--option", "P", "--option", "Q", "--multi", "--json")
        c2 = json.loads(out)["set"]
        ck(c2 == "f-multi-comma-lane", "\u2026the factory key is the set id (%r)" % c2)
        rc, _, err = run("answer", c2, "q1", "0,1")
        ck(rc == 0 and get_set(c2)["questions"][0].get("answer") == ["P", "Q"],
           "the comma-joined form is the same act as separate positionals "
           "(rc=%d, err=%r)" % (rc, (err or "").strip()[:60]))

        # -- 8c-quater. RECOMMENDATIONS ACCOMMODATE THE CHECKBOXES (owner order
        # 2026-09-30). A multi question can pre-check SEVERAL boxes, so
        # `recommended` stores `null | int | list[int]`. The INT shape is what
        # every pre-multi question already carries and is never widened to a
        # one-element list, so no existing question is reinterpreted.
        rc, out, _ = run("ask", "--factory", "f-rec-multi-lane",
                         "--title", "Several", "--description", "d",
                         "--option", "A", "--option", "B", "--option", "C",
                         "--multi", "--recommended", "0", "--recommended", "2",
                         "--no-publish", "--json")
        _rm = json.loads(out)["set"]
        ck(rc == 0 and get_set(_rm)["questions"][0].get("recommended") == [0, 2],
           "a multi question takes SEVERAL recommendations and stores a list "
           "(rc=%d, recommended=%r)"
           % (rc, get_set(_rm)["questions"][0].get("recommended")))

        rc, out, _ = run("ask", "--factory", "f-rec-comma-lane",
                         "--title", "Several", "--description", "d",
                         "--option", "A", "--option", "B", "--option", "C",
                         "--multi", "--recommended", "0,2", "--no-publish", "--json")
        _rc2 = json.loads(out)["set"]
        ck(rc == 0 and get_set(_rc2)["questions"][0].get("recommended") == [0, 2],
           "\u2026and the comma form is the same act as the repeated flag "
           "(rc=%d, recommended=%r)"
           % (rc, get_set(_rc2)["questions"][0].get("recommended")))

        # The split is unambiguous ONLY on an all-digit value: an option LABEL
        # may legally contain a comma, and splitting one would make that label
        # unreachable. This arm is the control for the arm above.
        rc, out, _ = run("ask", "--factory", "f-rec-labelcomma-lane",
                         "--title", "t", "--description", "d",
                         "--option", "Ship, now", "--option", "Hold",
                         "--recommended", "Ship, now", "--no-publish", "--json")
        _rl2 = json.loads(out)["set"]
        ck(rc == 0 and get_set(_rl2)["questions"][0].get("recommended") == 0,
           "a comma-bearing LABEL is NOT split, so it stays reachable "
           "(rc=%d, recommended=%r)"
           % (rc, get_set(_rl2)["questions"][0].get("recommended")))

        rc, out, _ = run("ask", "--factory", "f-rec-int-lane",
                         "--title", "t", "--description", "d",
                         "--option", "A", "--option", "B",
                         "--recommended", "B", "--no-publish", "--json")
        _ri = json.loads(out)["set"]
        ck(get_set(_ri)["questions"][0].get("recommended") == 1,
           "a single-select recommendation stays an INT, never a one-element "
           "list (%r)" % (get_set(_ri)["questions"][0].get("recommended"),))

        # Two pre-checked RADIOS are not a state a browser can render, so the
        # refusal must be at ask time rather than a page that silently drops one.
        rc, out, err = run("ask", "--factory", "f-rec-single-two-lane",
                           "--title", "t", "--description", "d",
                           "--option", "A", "--option", "B",
                           "--recommended", "0", "--recommended", "1", "--no-publish")
        ck(rc == 2 and "single-select" in (err or ""),
           "two recommendations on a SINGLE-select question are REFUSED "
           "(rc=%d, err=%r)" % (rc, (err or "").strip()[:70]))
        ck(get_set("f-rec-single-two-lane") is None,
           "\u2026and the refused ask registered NOTHING")

        # The page is the surface that must actually show both boxes checked.
        rc, out, _ = run("publish", "--json")
        _page = os.path.join(env["OC_QUESTIONS_DIR"], "pages", _rm, "index.html")
        _html = open(_page, encoding="utf-8").read() if os.path.isfile(_page) else ""
        ck(_html.count('type="checkbox" name="choice" checked') == 2,
           "\u2026and the page pre-checks BOTH recommended boxes (%d of 2)"
           % _html.count('type="checkbox" name="choice" checked'))

        # -- 8c-ter. The KIND IS FIXED AT ASK TIME, so an answer cannot widen it.
        # Silently taking the first of several would record an answer the reader
        # did not give -- the class this instrument exists to remove.
        rc, out, _ = run("ask", "--factory", "f-single-lane",
                         "--title", "Pick one", "--description", "d",
                         "--option", "Yes", "--option", "No", "--json")
        single_set = json.loads(out)["set"]
        ck(get_set(single_set)["questions"][0].get("kind") == "single",
           "an ask with no kind records single, not absent-and-guessed")
        rc, out, err = run("answer", single_set, "q1", "0", "1")
        ck(rc == 2, "several choices on a SINGLE-select question are REFUSED "
                   "(rc=%d)" % rc)
        ck("single-select" in (err or ""),
           "\u2026and the refusal names the reason (%r)" % ((err or "").strip()[:80],))
        ck(get_set(single_set)["questions"][0]["status"] == "open",
           "\u2026and nothing was recorded by the refused answer")
        rc, _, _ = run("answer", single_set, "q1", "1")
        ck(rc == 0 and get_set(single_set)["questions"][0].get("answer") == "No",
           "one choice on a single-select question still works (rc=%d)" % rc)
        # kind=multi with nothing to choose between is refused at ASK time: a
        # check box set with no boxes is a question nobody can answer.
        rc, _, err = run("ask", "--factory", "f-multi-bad-lane",
                         "--title", "No options", "--description", "d", "--multi")
        ck(rc == 2, "kind=multi with no options is refused (rc=%d)" % rc)
        # The register read says which kind, so a lane sees that a question takes
        # several answers BEFORE it tries to answer it.
        rc, out, _ = run("list", "--all")
        ck("[multi-select]" in out,
           "list marks a multi question as such, so a reader sees the kind "
           "before answering")

        # -- 8d. C6: mechanical closure. The register used to close only on an
        # explicit answer or TTL, so questions outlived the thing they asked
        # about. "Never guess" is the contract: an unreadable predicate SKIPS.
        rc, out, _ = run("ask", "--factory", "f-mech-lane",
                         "--title", "Closed by predicate?", "--description", "d",
                         "--close-when", "true", "--json")
        mech_set = json.loads(out)["set"]
        ck(get_set(mech_set)["questions"][0]["status"] == "open",
           "a close_when predicate does not fire at register time")
        rc, out, _ = run("gc", "--json")
        ck("resolved_mechanically" in out,
           "gc reports the mechanical closure by STATUS (rc=%d)" % rc)
        ck(get_set(mech_set)["questions"][0]["status"] == "resolved_mechanically",
           "\u2026and the question is closed as resolved_mechanically")
        ck("closed_reason" in get_set(mech_set)["questions"][0],
           "\u2026with the REASON recorded, never a bare disappearance")

        rc, out, _ = run("ask", "--factory", "f-mech-no-lane",
                         "--title", "Must stay open?", "--description", "d",
                         "--close-when", "false", "--json")
        keep_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(keep_set)["questions"][0]["status"] == "open",
           "a predicate returning non-zero does NOT close the question")

        # A question whose subject names no fork issue and carries no predicate
        # must never be closed by the default arm -- the arm cannot guess.
        rc, out, _ = run("ask", "--factory", "f-mech-bare-lane",
                         "--title", "No issue named", "--description", "nothing here",
                         "--json")
        bare_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(bare_set)["questions"][0]["status"] == "open",
           "the default arm closes NOTHING when no fork issue is named")

        # -- 9. the LOGGING path, unsuppressed -----------------------------
        # This leg exists because every other leg suppresses the unified log, so
        # oc_log_init returned BEFORE time.time(). A missing `import time`
        # therefore left the tool green in fixtures while it crashed on every
        # real invocation. A suppressed-log selftest cannot see that class.
        logfile = os.path.join(root, "tools.log")
        logenv = dict(env)
        logenv.pop("OC_TOOLS_NOLOG", None)
        logenv["OC_TOOLS_LOG"] = logfile
        proc = subprocess.run([tool, "list"], env=logenv, capture_output=True,
                              text=True, timeout=90)
        ck(proc.returncode == 0,
           "the UNSUPPRESSED logging path exits 0 (rc=%d %s)"
           % (proc.returncode, proc.stderr.strip().splitlines()[-1:]))
        rows = []
        if os.path.isfile(logfile):
            with open(logfile, encoding="utf-8") as fh:
                rows = [json.loads(line) for line in fh if line.strip()]
        ck(len(rows) == 1, "…and appends exactly one JSONL row (%d)" % len(rows))
        ck(bool(rows) and rows[0].get("tool") == PROG
           and "secs" in rows[0] and rows[0].get("exit") == 0,
           "…carrying tool/secs/exit per the unified-log schema")

        # WHICH renderer ran is observable ONLY in the log. The contract legs
        # above pass on the Python fallback too -- MEASURED: forcing the fallback
        # left all 114 legs green -- so without this leg nothing proves
        # json-render is actually in use, which is the owner's directive.
        pub_log = os.path.join(root, "publish.log")
        if os.path.isfile(pub_log):
            os.remove(pub_log)
        pubenv = dict(logenv)
        pubenv["OC_TOOLS_LOG"] = pub_log
        proc = subprocess.run([tool, "publish"], env=pubenv, capture_output=True,
                              text=True, timeout=120)
        ck(proc.returncode == 0,
           "publish under the unsuppressed log exits 0 (rc=%d)" % proc.returncode)
        fields = []
        if os.path.isfile(pub_log):
            with open(pub_log, encoding="utf-8") as fh:
                for line in fh:
                    if line.strip():
                        fields.append((json.loads(line).get("extra") or {}))
        ck(any(f.get("renderer") == "json-render" for f in fields),
           "publish records renderer=json-render -- there is exactly ONE "
           "builder, so the artifact states its own provenance (%r)"
           % (fields[-1:] if fields else None,))
        ck(not any("publish_failed" in f for f in fields),
           "…and a SUCCESSFUL publish records no fault, so a degradation cannot "
           "hide behind a green run")

        # -- 10. usage contract (the battery's edge cases) -----------------
        rc, _, _ = run("--help")
        ck(rc == 0, "--help exits 0 (rc=%d)" % rc)
        rc, _, _ = run("--bogus")
        ck(rc == 2, "unknown verb exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x", "--nope")
        ck(rc == 2, "unknown flag exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x",
                       "--title", "t", "--description", "d", "--recommended", "3")
        ck(rc == 2, "a recommendation with NO options is refused (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x",
                       "--title", "t", "--description", "d",
                       "--option", "a", "--option", "b", "--recommended", "3")
        ck(rc == 2, "a recommendation outside the option range is refused (rc=%d)" % rc)

        # -- 10. --subject is CREATION-ONLY (defect reported 2026-09-28) -----
        # On an EXISTING set the flag parsed, was never read, and the command
        # exited 0 -- the caller's unit key went nowhere, and only a read of the
        # stored set showed it. A field that cannot be updated must not read as
        # one that can, so the add REFUSES rather than discarding.
        rc, _, _ = run("ask", "--factory", "f-subject-probe",
                       "--subject", "unit-A", "--title", "t", "--description",
                       "d", "--option", "a", "--no-publish")
        ck(rc == 0, "ask creates a set WITH --subject (rc=%d)" % rc)
        ck((get_set("f-subject-probe") or {}).get("subject") == "unit-A",
           "\u2026and the subject IS recorded at creation (%r)"
           % ((get_set("f-subject-probe") or {}).get("subject"),))
        before = len((get_set("f-subject-probe") or {}).get("questions") or [])
        rc, _, err = run("ask", "--factory", "f-subject-probe",
                         "--subject", "unit-B", "--title", "t2", "--description",
                         "d2", "--option", "a", "--no-publish")
        ck(rc == 2, "\u2026and a LATER --subject is REFUSED, not silently "
                    "discarded (rc=%d)" % rc)
        ck("CREATION-ONLY" in err,
           "\u2026and the refusal NAMES the contract, not only the failure (%r)"
           % (err.strip()[-80:],))
        ck(len((get_set("f-subject-probe") or {}).get("questions") or []) == before,
           "\u2026and nothing was written: the refused add left the set "
           "unchanged (%d questions)" % before)
        ck((get_set("f-subject-probe") or {}).get("subject") == "unit-A",
           "\u2026and the stored subject is untouched (%r)"
           % ((get_set("f-subject-probe") or {}).get("subject"),))
        rc, _, _ = run("ask", "--factory", "f-subject-probe",
                       "--title", "t3", "--description", "d3", "--option", "a",
                       "--no-publish")
        ck(rc == 0, "\u2026and an add WITHOUT --subject still succeeds (rc=%d)" % rc)

        # -- 10. a CORRUPT register is an error, never a silent reset --------
        store = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        good = open(store, encoding="utf-8").read()
        with open(store, "w", encoding="utf-8") as fh:
            fh.write("{ not json")
        rc, out, err = run("list")
        ck(rc == 4, "a corrupt register is rc=4, not a silent reset (rc=%d)" % rc)
        with open(store, encoding="utf-8") as fh:
            survived = fh.read()
        ck(survived == "{ not json",
           "…and the tool did NOT overwrite it (the only copy of a parked question)")
        with open(store, "w", encoding="utf-8") as fh:
            fh.write(good)
        rc, _, _ = run("list")
        ck(rc == 0, "…and the restored register reads clean again")

        # -- 11. notify — the RETURN PATH (#547) ---------------------------
        # Delivery is a SEPARATE verb: `answer` holds RegisterLock, so a
        # network call inside it would block every other lane's ask/list for
        # the whole timeout, on a store whose point is concurrent safety.
        rc, _, err = run("notify")
        ck(rc == 2, "notify with no --set/--lane is usage rc=2 (rc=%d)" % rc)
        ck("requires --set" in err,
           "…and the usage error names the required flag, not an unknown verb")

        rc, out, _ = run("ask", "--factory", "f-return-lane",
                         "--questions-json", json.dumps([
                             {"title": "Ship it?", "description": "d",
                              "options": ["Yes", "No"], "recommended": 0}]),
                         "--json")
        ck(rc == 0, "ask registers the return-path set (rc=%d)" % rc)
        rset = json.loads(out)["set"]
        rc, _, _ = run("notify", "--set", rset)
        ck(rc == 1, "notify on an UNANSWERED set is rc=1, not a delivery (rc=%d)"
           % rc)

        rc, _, _ = run("answer", rset, "q1", "0")
        ck(rc == 0, "answer the return-path set (rc=%d)" % rc)
        # A factory set is NEVER auto-archived (owner order 2026-09-25): it
        # stays open at 0..N so its page and lane anchors are permanent. The
        # question is what closes; the SET does not.
        _live = get_set(rset)
        ck(_live is not None and _live.get("status") == "open",
           "…and the fully-answered factory set STAYS in the live register")

        # An answered set is normally ARCHIVED, so a reader that opens only
        # open.json cannot deliver the one answer that matters.
        rc, out, _ = run("notify", "--set", rset, "--dry-run", "--json")
        ck(rc == 0, "notify resolves an ARCHIVED set (rc=%d)" % rc)
        try:
            payload = json.loads(out)
        except Exception:  # noqa: BLE001
            # A leg that CRASHES reports nothing about the legs AFTER it, so a
            # missing payload is a FAIL row, never a traceback (see get_set).
            payload = {}
            ck(False, "notify --json emitted no JSON (the verb did not run)")
        ck(payload.get("session") == session_a,
           "…destination is the session recorded in the REGISTER")
        ck("Yes" in (payload.get("body") or ""),
           "…and the body carries the recorded answer")
        ck(len(payload.get("body") or "") <= 3020, "…and the body is bounded")

        rc, _, _ = run("notify", "--set", rset, "--dry-run",
                       "--session", "99999999-9999-9999-9999-999999999999")
        ck(rc == 2,
           "a caller-supplied destination is REFUSED rc=2 — no redirect (rc=%d)"
           % rc)

        rc, _, _ = run("notify", "--set", rset, "--mode", "bogus", "--dry-run")
        ck(rc == 2, "an unknown --mode is usage rc=2 (rc=%d)" % rc)

        rc, _, _ = run("notify", "--set", "nosuch", "--dry-run")
        ck(rc == 1, "an unknown set is rc=1 (rc=%d)" % rc)

        # A session that is not a session id must be REFUSED at REGISTER time
        # (C1): delivering to a guessed destination leaks an answer to a
        # stranger, and a register that holds a bad address can never deliver.
        rc, _, _ = run("ask", "--factory", "f-no-session-lane",
                       "--session", "not-a-uuid", "--title", "t",
                       "--description", "d", "--option", "a", "--option", "b")
        ck(rc == 2, "ask REFUSES a non-UUID session (rc=%d)" % rc)
        # …and the notify verb still refuses one that somehow got in, so the
        # guard exists at BOTH ends.
        nsid = json.loads(run("ask", "--factory", "f-guard-lane",
                              "--title", "t",
                              "--description", "d", "--json")[1])["set"]
        store_file = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        raw = json.load(open(store_file, encoding="utf-8"))
        for entry in raw["sets"]:
            if entry["id"] == nsid:
                entry["session"] = "not-a-uuid"
        json.dump(raw, open(store_file, "w", encoding="utf-8"))
        rc, _, _ = run("notify", "--set", nsid, "--dry-run")
        ck(rc == 3, "a non-uuid destination is refused rc=3 at the return end "
                    "too (rc=%d)" % rc)


        # =====================================================================
        # FACTORY-SET MODEL (owner orders 2026-09-25). Every leg below asserts a
        # criterion from the order, on the RECORD or the ARTIFACT rather than on
        # a message.
        # =====================================================================
        _fac = "f-acceptance"
        rc, out, _ = run("ask", "--factory", _fac, "--title", "A1",
                         "--description", "d1", "--option", "x", "--option", "y",
                         "--recommended", "0", "--json")
        ck(rc == 0, "ask --factory works with NO --lane and NO --session (rc=%d)"
           % rc)
        first_entry = json.loads(out).get("entry", {})
        ck(first_entry.get("id") == _fac and "factory" not in first_entry,
           "\u2026the factory key IS the set id, and there is no second name for it (%r)" % first_entry.get("id"))
        ck(first_entry.get("lane") == "Carrier tools",
           "\u2026and the lane is DERIVED from the session's own binding, never "
           "supplied by the caller (%r)" % first_entry.get("lane"))
        ck(json.loads(out).get("created") is True,
           "\u2026the first ask CREATES the standing set")

        # A SECOND session, different lane, into the SAME factory.
        env_b = dict(env)
        env_b["OPENCRABS_SESSION_ID"] = session_b
        proc_b = subprocess.run([tool, "ask", "--factory", _fac,
                                 "--title", "B1", "--description", "d2",
                                 "--option", "z", "--recommended", "0", "--json"],
                                env=env_b, capture_output=True, text=True,
                                timeout=90)
        ck(proc_b.returncode == 0,
           "a second session asks into the SAME factory (rc=%d)"
           % proc_b.returncode)
        try:
            second = json.loads(proc_b.stdout)
        except ValueError:
            second = {}
        ck(second.get("created") is False,
           "\u2026and the standing set is REUSED, not re-created")
        ck(second.get("set") == _fac and second.get("lane")
           == "Governance: Ontology & RSI",
           "\u2026recording the SECOND session's own lane (%r)"
           % second.get("lane"))

        # ONE set, two questions, each with its own lane + session.
        acc = get_set(_fac)
        ck(acc is not None and len(acc.get("questions", [])) == 2,
           "ONE standing set holds BOTH questions (%d)"
           % len((acc or {}).get("questions", [])))
        _qs = (acc or {}).get("questions", [])
        ck([q.get("qid") for q in _qs] == ["q1", "q2"],
           "\u2026numbered q1..qN in call order (%r)"
           % [q.get("qid") for q in _qs])
        ck(len({q.get("session") for q in _qs}) == 2,
           "\u2026each question carrying its OWN asking session")
        ck({q.get("lane") for q in _qs} == {"Carrier tools",
                                           "Governance: Ontology & RSI"},
           "\u2026and its own lane (%r)" % sorted({q.get("lane") for q in _qs}))

        # Derived from the fixture's OWN output: a leg naming a live lane goes
        # stale the moment that lane changes.
        rc, _all, _ = run("list")
        _fleet = int(re.match(r"(\d+) open", _all.strip().splitlines()[0]).group(1))
        _lanes = re.findall(r"^(\S.*?) \u2014 (\d+) open", _all, re.M)
        ck(len(_lanes) >= 2 and _fleet > 0,
           "list fixture has >= 2 lanes and a non-zero fleet total (fleet=%d)"
           % _fleet)
        _probe_lane, _probe_open = _lanes[0][0], int(_lanes[0][1])
        rc, out, _ = run("list", "--lane", _probe_lane)
        _hdr = out.strip().splitlines()[0] if out.strip() else ""
        ck(rc == 0 and _hdr.startswith("%d open question(s) across 1 lane(s)" % _probe_open),
           "list --lane counts within the FILTER, not the fleet (want %d, got %r)"
           % (_probe_open, _hdr))
        ck(re.search(r"^%s \u2014 %d open(, \d+ closed \(history\))?$"
                     % (re.escape(_probe_lane), _probe_open), out, re.M) is not None,
           "\u2026and the lane subtotal names the history it lists beneath it")
        rc, out, _ = run("list", "--lane", _probe_lane, "--json")
        _fj = json.loads(out)
        ck(_fj.get("open_questions") == sum(r["open"] for r in _fj.get("lanes", [])),
           "list --lane --json: open_questions agrees with the lanes it shows "
           "(pre-fix it carried the fleet total beside a filtered lanes[])")

        # --session is the RETURN ADDRESS, so it must select QUESTIONS, not
        # SETS (#632, 2026-09-28). The fixture above is exactly the case that
        # broke: ONE standing set, created by session_a, that session_b asked
        # into. A set-level comparison compares the CREATOR against the caller,
        # so the second lane sees ZERO of its own questions -- and the first
        # lane sees the WHOLE set, including questions it never asked. Both
        # directions are asserted, because either alone passes a wrong filter.
        # WHO appears is asserted, not merely how many: a count-only arm
        # measures the fixture rather than the filter.
        def _pairs(js):
            """(set, qid) for every question a list --json call returned."""
            return [(q.get("set"), q.get("qid")) for r in js.get("lanes", [])
                    for q in r.get("questions", [])]
        # The DISCRIMINATOR is the cross-lane pair, not a count: the fixture's
        # set holds q1 (asked by session_a, who CREATED it) and q2 (asked by
        # session_b into it). Pre-fix the set-level comparison showed the
        # creator the WHOLE set -- q2 included -- and showed session_b nothing
        # at all. Either half alone passes a wrong filter, so both are asserted.
        rc, out, _ = run("list", "--session", session_b, "--json")
        _jb = json.loads(out)
        _pb = _pairs(_jb)
        ck(rc == 0 and (_fac, "q2") in _pb,
           "list --session returns the question asked BY a lane into a set "
           "created by ANOTHER (%r)" % (_pb,))
        ck((_fac, "q1") not in _pb,
           "\u2026and NOT the creator's question in the same set (%r)" % (_pb,))
        rc, out, _ = run("list", "--session", session_a, "--json")
        _ja = json.loads(out)
        _pa = _pairs(_ja)
        ck(rc == 0 and (_fac, "q1") in _pa,
           "\u2026the OTHER direction: the creator sees its OWN question (%r)"
           % (_pa,))
        ck((_fac, "q2") not in _pa,
           "\u2026and NOT the second lane's, so it no longer sees the whole set "
           "(%r)" % (_pa,))
        # A lane that asked nothing gets nothing -- the zero that the pre-fix
        # code returned for EVERYONE, which is why the bug read as an empty
        # register rather than as a broken filter.
        rc, out, _ = run("list", "--session", "99999999-8888-7777-6666-555555555555",
                         "--json")
        _jz = json.loads(out)
        ck(rc == 0 and _jz.get("open_questions") == 0 and not _jz.get("lanes"),
           "list --session for a lane that asked NOTHING returns zero (%r/%r)"
           % (_jz.get("open_questions"), len(_jz.get("lanes", []))))

        # The page: ONE section per LANE, each with a STABLE anchor.
        rc, out, _ = run("publish", "--json")
        acc_page = json.loads(out)
        acc_body = open(os.path.join(acc_page["path"], "index.html"),
                        encoding="utf-8").read()
        _anchors = re.findall(r'<section id="(lane-[^"]+)"', acc_body)
        ck("lane-carrier-tools" in _anchors
           and "lane-governance-ontology-rsi" in _anchors,
           "the page carries one section per LANE with a stable anchor (%r)"
           % sorted(set(_anchors)))
        ck(len(_anchors) == len(set(_anchors)),
           "\u2026and every lane anchor is UNIQUE -- a duplicate id would make "
           "the handed-out URL ambiguous (%r)" % sorted(_anchors))
        ck(acc_body.count('id="lane-carrier-tools"') == 1,
           "\u2026one section per lane across the WHOLE page, not one per set")

        # A re-publish reproduces the anchors BYTE-IDENTICALLY.
        rc, out, _ = run("publish", "--json")
        again_body = open(os.path.join(json.loads(out)["path"], "index.html"),
                          encoding="utf-8").read()
        ck(re.findall(r'<section id="(lane-[^"]+)"', again_body) == _anchors,
           "a re-publish reproduces the lane anchors byte-identically")
        ck(json.loads(out)["slug"] == acc_page["slug"],
           "\u2026at the IDENTICAL page path (asserted twice, per the order)")

        # Owner order 2026-09-28 SUPERSEDES the property this block pinned. An
        # all-answered lane no longer renders its section: the page showed a
        # wall of blocks reporting "0 open", and the reader meets the PAGE, not
        # the anchors. The page still ALWAYS deploys, and a lane with OPEN
        # questions still renders.
        rc, _, _ = run("answer", _fac, "q1", "0")
        rc, _, _ = run("answer", _fac, "q2", "0")
        rc, out, _ = run("publish", "--json")
        zero_body = open(os.path.join(json.loads(out)["path"], "index.html"),
                         encoding="utf-8").read()
        ck("0 open" not in zero_body,
           "an empty lane renders NO section -- no lane block reports 0 open "
           "(owner order 2026-09-28)")
        ck("<main>" in zero_body and "<h1>" in zero_body,
           "\u2026and the page still deploys the lanes that ARE open, rather "
           "than vanishing with the empty ones")
        _rec = get_set(_fac)
        ck(_rec is not None and _rec.get("status") == "open",
           "answering the last question leaves the set OPEN (status=%r)"
           % (_rec or {}).get("status"))
        ck(all(question_is_closed(q) for q in (_rec or {}).get("questions", [])),
           "\u2026with 0 open questions, asserted on the RECORD")

        # list: the OPEN COUNT is the primary output, grouped by lane.
        rc, out, _ = run("list")
        ck(rc == 0 and out.strip().splitlines()[0].endswith("lane(s)"),
           "list prints the OPEN COUNT as its primary output (%r)"
           % out.strip().splitlines()[:1])
        ck(re.search(r"^Carrier tools \u2014 \d+ open(, \d+ closed \(history\))?$",
                     out, re.M) is not None,
           "\u2026and groups by lane with a per-lane open count")
        # The header must describe what is SHOWN. Pre-fix the count was taken
        # BEFORE the --lane filter, so a filtered view printed the FLEET total
        # against the filtered lane count ("7 open ... across 1 lane(s)" for a
        # lane holding zero) -- and the owner reads that header to decide what
        # to answer. MUTATION KILL: move the total_open computation back above
        # the --lane filter and leg (i) reddens.
        rc, out, _ = run("list", "--json")
        _lj = json.loads(out)
        ck(isinstance(_lj.get("open_questions"), int)
           and all("open" in row and "lane" in row for row in _lj.get("lanes", [])),
           "list --json carries one entry per lane with its open count")

        # An UNBOUND session is refused: it could never receive the answer.
        env_un = dict(env)
        env_un["OPENCRABS_SESSION_ID"] = session_unbound
        proc_un = subprocess.run([tool, "ask", "--factory", _fac,
                                  "--title", "x", "--description", "d"],
                                 env=env_un, capture_output=True, text=True,
                                 timeout=90)
        ck(proc_un.returncode != 0,
           "ask from an UNBOUND session exits non-zero (rc=%d)"
           % proc_un.returncode)
        ck("unbound" in (proc_un.stderr or "").lower()
           or "no session_bindings" in (proc_un.stderr or ""),
           "\u2026with a clear message naming why (%r)"
           % (proc_un.stderr or "").strip()[:90])

        # The return address is PER QUESTION: the answer reaches the lane that
        # ASKED it, not whoever created the standing set.
        rc, out, _ = run("ask", "--factory", _fac, "--title", "B2",
                         "--description", "d3", "--json")
        rc, out, _ = run("notify", "--set", _fac, "--qid", "q2", "--dry-run")
        ck(rc == 0 and "Governance: Ontology & RSI" in out,
           "notify --qid q2 resolves q2's OWN lane, not the set's (%r)"
           % out.strip()[:110])

        # PORTED WITH batch_return_address (#182 item 1, direction source ->
        # template): the function above had no probe here, and a gate that has
        # only ever seen good input has not been shown to reject bad input.
        #
        # NO --qid: one body carrying several lanes' answers cannot have ONE
        # destination. Pre-fix the destination fell back to the SET's session
        # while the body named the ASKING lane, so the answer reached a lane
        # that did not ask it (#612). MUTATION KILL: restore
        # question_return_address(entry, None) in the no-qid branch of
        # cmd_notify and both refusal legs redden.
        _reg = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        with open(_reg, encoding="utf-8") as fh:
            _saved = json.load(fh)
        _SET_S = "11111111-1111-1111-1111-111111111111"
        _Q_S = "22222222-2222-2222-2222-222222222222"

        def _plant(questions):
            with open(_reg, "w", encoding="utf-8") as fh:
                json.dump({"sets": [{"id": "mixfac", "session": _SET_S,
                                     "lane": "Creator Lane", "ttl_days": 7,
                                     "status": "open", "questions": questions}]}, fh)

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "session": _SET_S, "lane": "Creator Lane"},
                {"qid": "q2", "title": "t2", "status": "answered", "answer": "a2",
                 "session": _Q_S, "lane": "Second Lane"}])
        rc, out, err = run("notify", "--set", "mixfac", "--dry-run", "--json")
        ck(rc == 1 and "--qid" in (out + err),
           "notify with NO --qid REFUSES when the answers span sessions, naming "
           "--qid (rc=%d, %r)" % (rc, (out + err).strip()[:100]))

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "session": _Q_S, "lane": "Second Lane"},
                {"qid": "q2", "title": "t2", "status": "answered", "answer": "a2",
                 "session": _Q_S, "lane": "Second Lane"}])
        rc, out, _ = run("notify", "--set", "mixfac", "--dry-run", "--json")
        try:
            _dest = json.loads(out).get("session")
        except Exception:
            _dest = None
        ck(rc == 0 and _dest == _Q_S,
           "notify with no --qid uses the questions' SHARED session, not the "
           "set's (%r, rc=%d)" % (_dest, rc))

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "lane": "Creator Lane"}])
        rc, out, _ = run("notify", "--set", "mixfac", "--dry-run", "--json")
        try:
            _dest = json.loads(out).get("session")
        except Exception:
            _dest = None
        ck(rc == 0 and _dest == _SET_S,
           "a question with no session of its own still falls back to the set's "
           "(%r, rc=%d)" % (_dest, rc))

        with open(_reg, "w", encoding="utf-8") as fh:
            json.dump(_saved, fh)

        # A real delivery that cannot reach the lane must be a FAULT, never a
        # silent success — otherwise a parked answer looks delivered.
        dead = dict(env)
        dead["OC_QUESTIONS_A2A"] = "http://127.0.0.1:1/a2a/v1"
        proc = subprocess.run([tool, "notify", "--set", rset], env=dead,
                              capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 4,
           "an unreachable A2A endpoint is rc=4, never a false success (rc=%d)"
           % proc.returncode)

        # -- 12. DELIVERY STAMP ------------------------------------------
        # A consequence is not a receipt: "answered" says the register closed the
        # question, NOT that the lane ever received the answer. `answer` does not
        # notify, so before this the register read "answered" while a lane could
        # still be blocked, and no surface could tell the two apart.
        #
        # The FAILED case is free: the "unreachable A2A endpoint" arm above is a
        # real delivery attempt that returned 4. Its stamp is what the exit code
        # cannot carry to anyone but the caller.
        _dq = (get_set(rset) or {}).get("questions", [{}])[0]
        _dd = _dq.get("delivery") or {}
        ck(_dd.get("outcome") in ("unreachable", "refused"),
           "a FAILED delivery is STAMPED on the question (outcome=%r)"
           % (_dd.get("outcome"),))
        ck(bool(_dd.get("attempted_at")),
           "\u2026and the stamp carries its instant (%r)" % (_dd.get("attempted_at"),))
        ck(_dd.get("http") == 0,
           "\u2026and the transport failure is recorded as http 0, not a code "
           "that could be read as an HTTP answer (%r)" % (_dd.get("http"),))

        # A delivery that SUCCEEDS is stamped delivered. The endpoint is local, so
        # the arm is deterministic and needs no daemon.
        import http.server
        import threading

        class _Ok(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                length = int(self.headers.get("Content-Length") or 0)
                self.rfile.read(length)
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"jsonrpc":"2.0","id":"1","result":{}}')
            def log_message(self, *args):
                pass

        _srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _Ok)
        threading.Thread(target=_srv.serve_forever, daemon=True).start()
        ok_env = dict(env)
        ok_env["OC_QUESTIONS_A2A"] = ("http://127.0.0.1:%d/a2a/v1"
                                      % _srv.server_address[1])
        try:
            # MUTATION KILL: skip the stamp write in cmd_notify and the delivered
            # leg below reddens (the stamp still reads the EARLIER failure).
            proc = subprocess.run([tool, "notify", "--set", rset], env=ok_env,
                                  capture_output=True, text=True, timeout=90)
            ck(proc.returncode == 0,
               "a REACHABLE endpoint delivers (rc=%d)" % proc.returncode)
            ck("stamped 1 question(s) as delivered" in (proc.stdout or ""),
               "\u2026and the verb SAYS what it stamped (%r)"
               % ((proc.stdout or "").strip()[:90],))

            # S2 (2026-10-02): `answer --notify` folds the delivery into the
            # answer verb for a caller that does NOT already run `notify` (the
            # answer backend, which cannot afford a second round trip). Three
            # properties are load-bearing and each is pinned here, because a
            # selftest that passes WITHOUT covering the new path is the green
            # receipt over an unverifiable check: the fold is OPT-IN, it runs
            # OUTSIDE the register lock, and the exit code stays the MUTATION's
            # -- a failed delivery is DATA, never an rc.
            rc, out, _ = run("ask", "--factory", "f-notify-fold",
                             "--title", "Fold the delivery in?",
                             "--description", "d",
                             "--option", "yes", "--option", "no", "--json")
            _fset = json.loads(out)["set"]
            _fold = subprocess.run(
                [tool, "answer", _fset, "q1", "0", "--notify", "--json",
                 "--no-publish"], env=ok_env, capture_output=True, text=True,
                timeout=90)
            try:
                _fj = json.loads(_fold.stdout)
            except Exception:
                _fj = {}
            ck(_fold.returncode == 0 and _fj.get("delivery") == "delivered"
               and _fj.get("delivered") is True,
               "answer --notify folds a REACHABLE delivery in: rc=0, "
               "delivered=true (delivery=%r, rc=%d)"
               % (_fj.get("delivery"), _fold.returncode))

            rc, out, _ = run("ask", "--factory", "f-notify-fold2",
                             "--title", "Fold the delivery in?",
                             "--description", "d",
                             "--option", "yes", "--option", "no", "--json")
            _fset2 = json.loads(out)["set"]
            _fold2 = subprocess.run(
                [tool, "answer", _fset2, "q1", "0", "--notify", "--json",
                 "--no-publish"], env=dead, capture_output=True, text=True,
                timeout=90)
            try:
                _fj2 = json.loads(_fold2.stdout)
            except Exception:
                _fj2 = {}
            ck(_fold2.returncode == 0 and _fj2.get("delivery") == "unreachable"
               and _fj2.get("delivered") is False,
               "answer --notify: an UNREACHABLE delivery is DATA and the exit "
               "code stays the answer's (delivery=%r, rc=%d)"
               % (_fj2.get("delivery"), _fold2.returncode))

            rc, out, _ = run("ask", "--factory", "f-notify-fold3",
                             "--title", "Fold the delivery in?",
                             "--description", "d",
                             "--option", "yes", "--option", "no", "--json")
            _fset3 = json.loads(out)["set"]
            _fold3 = subprocess.run(
                [tool, "answer", _fset3, "q1", "0", "--json", "--no-publish"],
                env=dead, capture_output=True, text=True, timeout=90)
            try:
                _fj3 = json.loads(_fold3.stdout)
            except Exception:
                _fj3 = {}
            ck(_fold3.returncode == 0 and "delivery" not in _fj3,
               "answer WITHOUT --notify is unchanged: no delivery key in --json "
               "(%r, rc=%d)" % (sorted(_fj3), _fold3.returncode))
        finally:
            _srv.shutdown()
            _srv.server_close()
        _dq = (get_set(rset) or {}).get("questions", [{}])[0]
        _dd = _dq.get("delivery") or {}
        ck(_dd.get("outcome") == "delivered",
           "a SUCCESSFUL delivery is STAMPED delivered (outcome=%r, http=%r)"
           % (_dd.get("outcome"), _dd.get("http")))

        # --dry-run delivers nothing, so it must stamp nothing: a dry run that
        # wrote a stamp would make the register claim a delivery nobody made.
        _before = ((get_set(rset) or {}).get("questions", [{}])[0]
                   .get("delivery") or {}).get("attempted_at")
        rc, _, _ = run("notify", "--set", rset, "--dry-run")
        ck(rc == 0, "dry-run still succeeds (rc=%d)" % rc)
        _after = ((get_set(rset) or {}).get("questions", [{}])[0]
                  .get("delivery") or {}).get("attempted_at")
        ck(_before == _after,
           "a DRY RUN stamps nothing (attempted_at %r -> %r)"
           % (_before, _after))

        # An answered question that was NEVER notified must read as NOT RECORDED
        # rather than as delivered -- the absence is the finding, so it prints.
        rc, out, _ = run("ask", "--factory", "f-delivery-arm",
                         "--title", "Never notified?", "--description", "d",
                         "--option", "yes", "--json")
        nset = json.loads(out)["set"]
        run("answer", nset, "q1", "0")
        rc, out, _ = run("list", "--all")
        ck("[delivery: NOT RECORDED]" in out,
           "list prints NOT RECORDED for an answer nobody delivered")
        ck("[delivered " in out,
           "list prints the DELIVERED state beside the answer")
        rc, out, _ = run("list", "--all", "--json")
        try:
            _rows = [q for r in json.loads(out)["lanes"] for q in r["questions"]]
        except Exception:
            _rows = []
        ck(any(q.get("delivery", {}).get("outcome") == "delivered"
               for q in _rows if q.get("delivery")),
           "list --json carries the delivery object")
        ck(any(q.get("delivery") is None for q in _rows),
           "\u2026and an undelivered question carries no object, so a machine "
           "reader sees the gap too")

        # -- 13. REDELIVER -------------------------------------------------
        # The RETRY leg, and its whole risk is #251: the notify path is NOT
        # idempotent, so a sweep built on the OBVIOUS predicate ("absent or
        # unreachable") re-delivers answers that already landed -- 56
        # notifications against the live register instead of 6, and one answer
        # body already reached its lane 8x that way. These arms pin the
        # predicate to the MEASURED classes and pin the guard that reads the
        # stamp back before firing.
        rd_dir = os.path.join(root, "rd-store")
        os.makedirs(rd_dir, exist_ok=True)
        rd_reg = os.path.join(rd_dir, "open.json")
        rd_env = dict(env)
        rd_env["OC_QUESTIONS_DIR"] = rd_dir
        _RL = "Redeliver Lane"

        def _rd_plant(questions):
            with open(rd_reg, "w", encoding="utf-8") as fh:
                json.dump({"sets": [{"id": "rdfac", "session": session_a,
                                     "lane": _RL, "ttl_days": 7,
                                     "status": "open",
                                     "questions": questions}]}, fh)

        def _rd_read():
            with open(rd_reg, encoding="utf-8") as fh:
                return {q["qid"]: q for q in json.load(fh)["sets"][0]["questions"]}

        _STAMP = {"attempted_at": "2026-09-30T00:00:00+00:00", "http": 0,
                  "mode": "turn-end"}
        # One question per class the predicate must discriminate, so an arm that
        # widens or narrows the population reddens against a named row.
        _rd_plant([
            dict(qid="q1", title="unreachable", status="answered", answer="a1",
                 session=session_a, lane=_RL,
                 delivery=dict(_STAMP, outcome="unreachable")),
            dict(qid="q2", title="delivered", status="answered", answer="a2",
                 session=session_a, lane=_RL,
                 delivery=dict(_STAMP, outcome="delivered", http=200)),
            dict(qid="q3", title="refused", status="answered", answer="a3",
                 session=session_a, lane=_RL,
                 delivery=dict(_STAMP, outcome="refused", http=400)),
            dict(qid="q4", title="post-epoch unattempted", status="answered",
                 answer="a4", session=session_a, lane=_RL,
                 answered_at="2026-09-29T09:29:01+00:00"),
            dict(qid="q5", title="pre-epoch unstamped", status="answered",
                 answer="a5", session=session_a, lane=_RL,
                 answered_at="2026-09-01T00:00:00+00:00"),
        ])
        proc = subprocess.run([tool, "redeliver", "--pending", "--dry-run",
                               "--json"], env=rd_env, capture_output=True,
                              text=True, timeout=90)
        try:
            _rep = json.loads(proc.stdout)
        except Exception:
            _rep = {}
        _ready = sorted(i["qid"] for i in (_rep.get("ready") or []))
        ck(proc.returncode == 0 and _ready == ["q1", "q4"],
           "redeliver selects exactly the unreachable + post-epoch unattempted "
           "questions (%r, rc=%d)" % (_ready, proc.returncode))
        ck(_rep.get("not_retried_pre_epoch") == 1,
           "\u2026and NAMES the pre-epoch unstamped it did not retry (%r) -- a "
           "silent filter and an empty population print the same thing"
           % (_rep.get("not_retried_pre_epoch"),))

        # A dry run must stamp nothing: a stamp written without a delivery makes
        # the register claim something nobody did.
        with open(rd_reg, "rb") as fh:
            _rd_before = fh.read()
        subprocess.run([tool, "redeliver", "--pending", "--dry-run"], env=rd_env,
                       capture_output=True, text=True, timeout=90)
        with open(rd_reg, "rb") as fh:
            _rd_after = fh.read()
        ck(_rd_before == _rd_after,
           "a redeliver DRY RUN stamps nothing (register byte-identical)")

        _hits = []

        class _RdOk(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                length = int(self.headers.get("Content-Length") or 0)
                self.rfile.read(length)
                _hits.append(self.path)
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"jsonrpc":"2.0","id":"1","result":{}}')

            def log_message(self, *args):
                pass

        _rdsrv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _RdOk)
        threading.Thread(target=_rdsrv.serve_forever, daemon=True).start()
        rd_ok = dict(rd_env)
        rd_ok["OC_QUESTIONS_A2A"] = ("http://127.0.0.1:%d/a2a/v1"
                                     % _rdsrv.server_address[1])
        try:
            proc = subprocess.run([tool, "redeliver", "--pending"], env=rd_ok,
                                  capture_output=True, text=True, timeout=90)
            ck(proc.returncode == 0,
               "redeliver against a reachable endpoint is rc=0 (rc=%d)"
               % proc.returncode)
            ck(len(_hits) == 2,
               "\u2026and POSTs EXACTLY the pending population, once each "
               "(%d POSTs)" % len(_hits))
            # MUTATION KILL: drop the `outcome in ("delivered","refused")`
            # filter from pending_deliveries and the second sweep re-fires q1.
            proc = subprocess.run([tool, "redeliver", "--pending"], env=rd_ok,
                                  capture_output=True, text=True, timeout=90)
            ck(proc.returncode == 0 and len(_hits) == 2,
               "a DELIVERED question is NEVER re-delivered (#251): the second "
               "sweep POSTs nothing (%d POSTs total)" % len(_hits))
        finally:
            _rdsrv.shutdown()
            _rdsrv.server_close()
        _qs = _rd_read()
        ck((_qs["q1"].get("delivery") or {}).get("outcome") == "delivered",
           "a retried question is stamped delivered (%r)"
           % ((_qs["q1"].get("delivery") or {}).get("outcome"),))
        ck((_qs["q1"].get("delivery") or {}).get("attempts") == 2,
           "\u2026and its attempt counter advanced past the counterless stamp "
           "(%r)" % ((_qs["q1"].get("delivery") or {}).get("attempts"),))
        ck((_qs["q4"].get("delivery") or {}).get("attempts") == 1,
           "\u2026while a first attempt counts 1 (%r)"
           % ((_qs["q4"].get("delivery") or {}).get("attempts"),))
        ck(_qs["q5"].get("delivery") is None,
           "the pre-epoch question is never touched (delivery=%r)"
           % (_qs["q5"].get("delivery"),))

        # The BOUND. A sweep that stops trying without saying so turns a live
        # blockage into a quiet one, so exhaustion is a reported state.
        _rd_plant([dict(qid="q1", title="exhausted", status="answered",
                        answer="a1", session=session_a, lane=_RL,
                        delivery=dict(_STAMP, outcome="unreachable", attempts=3))])
        proc = subprocess.run([tool, "redeliver", "--pending", "--dry-run",
                               "--json"], env=rd_env, capture_output=True,
                              text=True, timeout=90)
        try:
            _rep = json.loads(proc.stdout)
        except Exception:
            _rep = {}
        ck(proc.returncode == 1 and not (_rep.get("ready") or [])
           and len(_rep.get("exhausted") or []) == 1,
           "a question at --max-attempts is reported EXHAUSTED, never retried "
           "(rc=%d, ready=%r)" % (proc.returncode, _rep.get("ready")))

        # rc semantics, each against the transport that produces it.
        _rd_plant([dict(qid="q1", title="u", status="answered", answer="a1",
                        session=session_a, lane=_RL,
                        delivery=dict(_STAMP, outcome="unreachable"))])
        _dead = dict(rd_env)
        _dead["OC_QUESTIONS_A2A"] = "http://127.0.0.1:1/a2a/v1"
        proc = subprocess.run([tool, "redeliver", "--pending"], env=_dead,
                              capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 4,
           "a sweep that reaches nothing is rc=4 (rc=%d)" % proc.returncode)

        class _RdDown(http.server.BaseHTTPRequestHandler):
            def do_POST(self):
                length = int(self.headers.get("Content-Length") or 0)
                self.rfile.read(length)
                self.send_response(503)
                self.end_headers()

            def log_message(self, *args):
                pass

        _dnsrv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), _RdDown)
        threading.Thread(target=_dnsrv.serve_forever, daemon=True).start()
        _rd_down = dict(rd_env)
        _rd_down["OC_QUESTIONS_A2A"] = ("http://127.0.0.1:%d/a2a/v1"
                                        % _dnsrv.server_address[1])
        try:
            _rd_plant([dict(qid="q1", title="u", status="answered", answer="a1",
                            session=session_a, lane=_RL,
                            delivery=dict(_STAMP, outcome="unreachable"))])
            proc = subprocess.run([tool, "redeliver", "--pending"], env=_rd_down,
                                  capture_output=True, text=True, timeout=90)
            ck(proc.returncode == 3,
               "an endpoint that ANSWERS and refuses is rc=3, distinct from an "
               "unreachable one (rc=%d)" % proc.returncode)
        finally:
            _dnsrv.shutdown()
            _dnsrv.server_close()

        proc = subprocess.run([tool, "redeliver", "--max-attempts", "zero"],
                              env=rd_env, capture_output=True, text=True,
                              timeout=90)
        ck(proc.returncode == 2,
           "--max-attempts refuses a non-integer (rc=%d)" % proc.returncode)

        # -- #309: the cross-factory registration gate ----------------------
        rc, out, err = run("ask", "--factory", "ai-antispam", "--no-publish",
                           "--session", session_a,
                           "--title", "foreign?", "--description", "d")
        ck(rc == 2 and "belongs to factory" in (err or "")
           and "opencrabs-dev" in (err or "") and "ai-antispam" in (err or ""),
           "ask REFUSES a session bound to another factory, naming both (rc=%d)"
           % rc)
        ck(get_set("ai-antispam") is None,
           "a refused cross-factory ask writes nothing")

        # The gate's BLIND SPOT, asserted rather than left to be discovered: a
        # set name the fleet does not declare has no declared chat to compare
        # against, so the gate is INERT there -- and it must SAY so, because an
        # inert gate that is silent is indistinguishable from one that passed.
        rc, out, err = run("ask", "--factory", "f-undeclared-set", "--no-publish",
                           "--session", session_a,
                           "--title", "ad hoc", "--description", "d")
        ck(rc == 0 and "not a factory declared in the fleet manifest" in (err or ""),
           "an UNDECLARED set name is INERT and says so, not refused (rc=%d)" % rc)
        ck(get_set("f-undeclared-set") is not None,
           "…and the ad-hoc set was minted")

        rc, out, _ = run("ask", "--factory", "opencrabs-dev", "--no-publish",
                         "--session", session_a,
                         "--title", "mine", "--description", "d")
        ck(rc == 0, "ask accepts a same-factory session (rc=%d)" % rc)

        rc, out, _ = run("ask", "--factory", "opencrabs-dev", "--no-publish",
                         "--allow-foreign", "S2/S5 probe from the meta lane",
                         "--session", session_foreign,
                         "--title", "cross", "--description", "d")
        ck(rc == 0,
           "ask accepts a cross-factory ask WITH --allow-foreign (rc=%d)" % rc)
        _cf = None
        for _q in (get_set("opencrabs-dev") or {}).get("questions", []):
            if _q.get("title") == "cross":
                _cf = _q
        ck(_cf is not None and _cf.get("cross_factory") is True
           and _cf.get("cross_factory_from") == "ai-antispam"
           and _cf.get("cross_factory_reason"),
           "an allowed cross-factory question is STAMPED cross_factory + reason")

        # A same-factory ask into a DIFFERENT factory mints the colliding lane
        # #309 is about: two factories, each with a "Triage" set.
        rc, out, _ = run("ask", "--factory", "ai-antispam", "--no-publish",
                         "--session", session_foreign,
                         "--title", "triage-q", "--description", "d",
                         "--option", "A", "--option", "B")
        ck(rc == 0, "ask accepts a session in its OWN factory (rc=%d)" % rc)
        rc, out, _ = run("ask", "--factory", "meta-factory", "--no-publish",
                         "--session", session_mf,
                         "--title", "triage-mf", "--description", "d",
                         "--option", "A", "--option", "B")
        ck(rc == 0, "ask accepts a second factory's Triage lane (rc=%d)" % rc)
        rc, out, _ = run("answer", "ai-antispam", "q1", "0", "--no-publish")
        ck(rc == 0, "an answer lands for the qualified-notify leg (rc=%d)" % rc)

        # -- #310: list --factory, non-silent zero-match ---------------------
        rc, out, _ = run("list", "--factory", "opencrabs-dev", "--json")
        ck(rc == 0, "list --factory <known> is rc=0 (rc=%d)" % rc)
        _j = json.loads(out)
        ck(bool(_j["lanes"]) and all(q.get("set") == "opencrabs-dev"
                                     for r in _j["lanes"]
                                     for q in r["questions"]),
           "list --factory shows that factory's sets only")

        rc, out, err = run("list", "--factory", "nope")
        ck(rc != 0 and "no-such-factory: nope" in (err or ""),
           "list --factory <unknown> refuses, naming it (rc=%d)" % rc)

        rc, out, err = run("list", "--lane", "no-such-lane")
        ck(rc != 0 and "no-such-lane: no-such-lane" in (err or ""),
           "list --lane <unknown> refuses, naming it (rc=%d)" % rc)

        # -- #309: notify --lane refuses an ambiguous bare name --------------
        rc, out, err = run("notify", "--lane", "Triage", "--dry-run")
        ck(rc == 2 and "qualified lane" in (err or "")
           and "ai-antispam/Triage" in (err or "")
           and "meta-factory/Triage" in (err or ""),
           "notify --lane <ambiguous> refuses and lists the qualified candidates "
           "(rc=%d)" % rc)
        rc, out, _ = run("notify", "--lane", "ai-antispam/Triage", "--dry-run")
        ck(rc == 0,
           "notify --lane <factory>/<lane> resolves exactly one set (rc=%d)" % rc)

        # -- #310: --help on every subcommand --------------------------------
        for _verb in ("ask", "list", "notify", "answer", "amend", "withdraw",
                      "publish", "lint", "gc", "redeliver"):
            rc, out, _ = run(_verb, "--help")
            ck(rc == 0 and "the Open Questions register" in (out or ""),
               "%s --help prints usage, rc=0 (rc=%d)" % (_verb, rc))

        if fails:
            print("  %d FAILED" % len(fails))
            return 1
        print("  all checks passed")
        return 0
    finally:
        shutil.rmtree(root, ignore_errors=True)

USAGE = """questions — the Open Questions register (#547)

  ask      --factory <KEY> [--session <id>]
           [--questions-file F | --questions-json J |
            --title T --description D [--option O]... [--recommended <0-based-index|LABEL|LETTER>]...]
           [--ttl-days N] [--subject S] [--no-clarify] [--close-when CMD]
           [--allow-foreign "<reason>"]
           --recommended takes ONE value on a single-select question and may be
           repeated (or comma-joined, `0,2`) on a --kind multi one, because a
           multi question can pre-check SEVERAL boxes. Two values on a single
           question are REFUSED (rc=2): two pre-checked radios are not a state
           a browser can render. Each value is a 0-based index or an option
           label/letter, and what it resolved to is echoed back.
           --subject is CREATION-ONLY: it is recorded when the set is minted,
           and a set names ONE unit. Passing it on an add to an existing set is
           REFUSED (rc=2) rather than silently discarded.
           [--no-publish] [--json]
           --factory is REQUIRED: the factory key IS the standing set id,
           reused on every ask. There is no --lane: the asking session is read
           from OPENCRABS_SESSION_ID and its display name is resolved from that
           session's own binding, so a caller cannot mislabel itself. --session
           is an override for callers outside a turn. Prints the open-question
           TOTAL and the page URL -- there is no card.
           CROSS-FACTORY GATE: the asking session's binding is resolved to its
           factory in registry/fleet.json, and an ask naming a DIFFERENT
           DECLARED factory is REFUSED (rc=2) -- a lane display name is not
           unique across the fleet, so it would file the question under another
           factory's lane and deliver the answer to the wrong chat.
           --allow-foreign "<reason>" registers it deliberately and stamps
           cross_factory + the reason on each question. Two cases stay INERT and
           say so on stderr: no fleet manifest resolved at all, and a set name
           the fleet does not declare (a set is minted on demand, so an
           undeclared name is a NEW set, not another factory's). A session whose
           chat is not a declared factory is refused.
  answer   <set-id> <qid> <choice-index|clarify> [--text T] [--via card|page|cli]
           [--notify]
           recording an answer does NOT notify the asker BY DEFAULT: delivery is
           the separate `notify` verb, and an answer whose asker never received
           it reads as closed on every surface. `--notify` folds that delivery
           into THIS call for a caller that does not already run `notify` --
           opt-in, so nothing is delivered twice. The delivery runs OUTSIDE the
           register lock and its outcome lands in --json as delivery / http /
           delivered; the exit code stays the ANSWER's, so a delivery failure is
           data, never an rc. `notify` stamps each question it carried with the
           outcome and instant (delivery: delivered | refused | unreachable), and
           `list` prints that beside the answer.
           [--no-publish]
           clarify with NO --text is a COMPLETE request (#183): the owner's
           click alone asks the lane to restate the question in wider context
           and clearer language — the tool supplies that meaning; --text adds
           the owner's own wording and wins when present
  withdraw --set <id> --qid <qid> [--text REASON] [--no-publish] [--json]
           retracts a question that has become moot; the set stays open
  amend    --set <id> --qid <qid> [--title T] [--description D]
           [--option O]... [--recommended <0-based-index|LABEL|LETTER>]... [--clear-options]
           the CLARIFY return leg: edits the question and reopens it
  notify   --set <id> | --lane <NAME> [--qid Q] [--mode turn-end|interrupt|quiet]
           [--dry-run] [--json]        the RETURN PATH: delivers the answer to
                                       the session recorded in the register.
                                       --lane accepts a bare display name OR the
                                       qualified `<factory>/<lane>`; a bare name
                                       matching more than one set REFUSES and
                                       lists the candidates (a name is not unique
                                       across the fleet), rather than routing by
                                       load order.
                                       With no --qid the destination is the
                                       session every answered question SHARES;
                                       if they differ it refuses and names
                                       --qid, because one body cannot have one
                                       destination. A factory set records its
                                       CREATOR's session; each question carries
                                       its own, and that is what routes.
                                       Every attempt stamps `attempts` beside
                                       the outcome; that counter is what bounds
                                       `redeliver`.
  redeliver [--pending] [--max-attempts N] [--mode M] [--dry-run] [--json]
           RETRY leg: re-notifies the deliveries the register RECORDS as
           failed, and NOTHING else. Two classes qualify:
             unreachable  an attempt was made and the transport failed
             unattempted  no stamp at all on a question answered AFTER the
                          stamp existed (2026-09-28T22:35:34+00:00)
           A question answered BEFORE that instant with no stamp is NOT
           retried: the register had nowhere to write, so absence there is not
