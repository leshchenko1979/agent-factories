def slugify(text):
    """lowercase, non-alnum -> hyphen. ONE home for the page slug AND the lane
    anchors, so a rename cannot make the two disagree about the same lane."""
    return re.sub(r"[^a-z0-9]+", "-", (text or "").lower()).strip("-") or "lane"

def lane_anchor(lane):
    """The STABLE per-lane anchor (owner order 2026-09-25). The same lane must
    yield the same id across re-renders and across publishes, so a URL handed
    to the owner for one lane keeps pointing at that lane."""
    return "lane-" + slugify(lane)

def page_slug(factory):
    """The page path is a CONSTANT slug -- never a rotating token. Owner order
    2026-09-25: the link is bookmarked, so a fresh URL per publish 404s it.
    One home: every caller derives the path from here."""
    return slugify(factory)

def _declared_slug():
    """This factory's OWN slug, read from its `registry/fleet.json`.

    The first publish has no set to derive a slug from, and the instrument used to
    fall back to the slug of the factory it was WRITTEN for -- so a new factory's
    very first page was published under another factory's name. A factory's slug is
    already declared in `registry/fleet.json` (the file the lane resolver reads), so
    it is read here rather than restated. Returns "" when the tree carries no
    manifest, and the caller then requires `--factory` explicitly rather than
    guessing.
    """
    try:
        manifest = os.path.join(
            os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
            "registry", "fleet.json")
        with open(manifest, encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return ""
    for record in data.get("factories") or []:
        # A factory's own manifest declares ITS record; when a manifest carries
        # several (this repo is one of the factories it names), the record whose
        # `repo` is this tree is the one that describes us.
        if record.get("repo") and os.path.realpath(record["repo"]) == os.path.realpath(
                os.path.dirname(os.path.dirname(os.path.abspath(__file__)))):
            return str(record.get("slug") or "")
    records = data.get("factories") or []
    return str(records[0].get("slug") or "") if len(records) == 1 else ""


# The slug used when the register holds no set to derive one from -- i.e. the very
# first publish. A factory set is never auto-archived, so once one exists the slug
# always comes from the register. Env override wins, then this factory's own declared
# slug, then EMPTY -- and an empty value makes `ask` require `--factory` rather than
# silently publishing under a name that is not the caller's.
DEFAULT_FACTORY = (os.environ.get("OC_QUESTIONS_FACTORY") or _declared_slug())

# The retired rotating-token shape (secrets.token_urlsafe(24) -> 32 chars).
# Pruning keys on the SHAPE, not on "anything that is not the current slug", so
# a future second factory's readable slug can never be swept by accident.
LEGACY_TOKEN_RE = re.compile(r"^[A-Za-z0-9_-]{32}$")

# The aggregate page's slug: the neutral address carrying EVERY factory's open
# questions (owner order 2026-09-28). RESERVED -- a factory whose slug collides
# with it is REFUSED rather than allowed to overwrite the aggregate, because the
# two are different objects that would otherwise share one directory.
AGGREGATE_SLUG = "all"

def page_targets(sets):
    """[(slug, entries)] -- the aggregate, plus one page per factory.

    TWO ADDRESSES, ONE OBJECT EACH (owner order 2026-09-28). The single page used
    to carry every factory's questions while being served from ONE factory's name
    (`/opencrabs-dev/`), so the path named a factory and the content was the
    fleet -- and there was no address for the union at all. Now:

      /all/          every factory's open questions
      /<factory>/    that factory's OWN open questions

    The slug is DERIVED from the factory name, never recorded and reused, so it
    cannot churn when a set is added or removed: adding a question to
    inferhub-watch cannot move opencrabs-dev's path. That is the stability the
    retired mint-per-publish token and the single reuse-pointer both existed to
    provide, held here by construction instead of by a stored value.

    A factory page is minted even when the factory has NOTHING open, because the
    address is a permanent anchor: a page that existed only while questions did
    would 404 the moment they were answered. Such a page renders its empty state.
    Names come from EVERY set the register holds, not only the open ones, so a
    factory that answered its last question keeps its address.

    `entries` is always drawn from the OPEN sets -- an answered question is not on
    any page, and that predicate is shared with the title and the pointer through
    open_question_count().
    """
    open_entries = sorted([s for s in sets if s.get("status") == "open"],
                          key=lambda s: s.get("asked_at") or "")
    names = []
    for entry in sets:
        key = entry.get("factory") or entry.get("id")
        if key and key not in names:
            names.append(key)
    takes = {AGGREGATE_SLUG: "the aggregate page"}
    targets = [(AGGREGATE_SLUG, open_entries)]
    for name in names:
        slug = page_slug(name)
        if slug in takes:
            die(2, "page address collision: factory %r needs /%s/, which is "
                   "already taken by %s. Two different objects must not share "
                   "one directory -- one would overwrite the other, so this is "
                   "refused rather than published." % (name, slug, takes[slug]))
        takes[slug] = "factory %r" % name
        targets.append((slug, [e for e in open_entries
                               if (e.get("factory") or e.get("id")) == name]))
    return targets

def questions_db_path():
    return (os.environ.get("OC_QUESTIONS_DB")
            or os.path.join(profile_home(), "opencrabs.db"))

# --- Fleet identity: which factory a session's chat belongs to (#309) --------
# The register stores a lane as a bare DISPLAY NAME, and a display name is not
# unique across the fleet -- four factories each have a "Triage" topic. A lane's
# identity is the PAIR (factory, lane), and the factory half is DERIVED from the
# session's own binding, never taken from the caller -- the same reason the lane
# name itself is resolved rather than passed (owner order 2026-09-25).
#
# The expectation half comes from the DECLARED fleet manifest, never from the
# register: a gate that re-derives its expectation from the object under test is
# self-consistent and therefore worthless. `tools/registry.py` already reads the
# same file by the same convention (`<tree>/registry/fleet.json`, overridable
# with OC_FLEET_MANIFEST); this reuses that convention rather than inventing a
# second one.
FLEET_ENV = "OC_FLEET_MANIFEST"

def _fleet_manifest_candidates():
    """Where the fleet declaration may live, in order. First hit wins.

    <tree>/registry/fleet.json  the convention `tools/registry.py` uses: a member
                                factory's own manifest sits at its repo root.
    walk up                     the TEMPLATE lives INSIDE the fleet repo, so its
                                own manifest is ABOVE it, not beside it.
    <profile home>/fleet.json   a deployment whose tree carries no manifest (the
                                vendored twin) points at the fleet's copy here.
    """
    override = os.environ.get(FLEET_ENV)
    if override:
        # The override is AUTHORITATIVE, not merely first: a fixture must be able
        # to say "the fleet is exactly this" without the live tree leaking in.
        yield override
        return
    here = os.path.dirname(os.path.abspath(__file__))
    yield os.path.join(os.path.dirname(here), "registry", "fleet.json")
    d = here
    for _ in range(6):
        parent = os.path.dirname(d)
        if not parent or parent == d:
            break
        d = parent
        yield os.path.join(d, "registry", "fleet.json")
    yield os.path.join(profile_home(), "fleet.json")

def load_fleet():
    """[(slug, chat_id_str, display_name)] from the first manifest that parses
    with a non-empty `factories` list, else [].

    Both sides are str(): sqlite returns chat_id as TEXT while the manifest
    carries an int, and an un-normalised comparator flags EVERY row as foreign
    (measured -- this was the instrument bug that shaped the design)."""
    for path in _fleet_manifest_candidates():
        try:
            with open(path, encoding="utf-8") as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        records = data.get("factories") if isinstance(data, dict) else None
        if not isinstance(records, list):
            continue
        fleet = []
        for record in records:
            if not isinstance(record, dict):
                continue
            slug = str(record.get("slug") or "").strip()
            chat_id = record.get("chat_id")
            if slug and chat_id is not None:
                fleet.append((slug, str(chat_id),
                              str(record.get("display_name") or slug)))
        if fleet:
            return fleet
    return []

def session_chat_id(session):
    """The chat this session's binding sits in, as a string, or None."""
    path = questions_db_path()
    if not os.path.isfile(path):
        return None
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
    except sqlite3.Error:
        return None
    try:
        row = conn.execute(
            "select chat_id from session_bindings "
            "where session_id=? and channel='telegram'", (session,)).fetchone()
    except sqlite3.Error:
        return None
    finally:
        conn.close()
    return str(row[0]) if row and row[0] is not None else None

def factory_of_session(session):
    """(slug, display_name, fleet_known) for the session's own binding.

    `fleet_known` is False when NO manifest resolved at all, which the caller
    must be able to tell apart from "the manifest is known and this chat is not
    in it": the first means the gate cannot observe the failure class and must
    stay INERT, the second is a positive finding. A slug of None with
    fleet_known True is therefore NOT "unknown" -- it is "not a declared
    factory"."""
    fleet = load_fleet()
    chat_id = session_chat_id(session)
    if chat_id is not None:
        for slug, declared_chat, display in fleet:
            if declared_chat == chat_id:
                return slug, display, True
    return None, None, bool(fleet)

def qualified_lane(entry, lane):
    """The pair spelled `<factory>/<lane>` -- DERIVED at read, never stored, so
    the 133 rows already in the register need no destructive migration."""
    return "%s/%s" % (entry.get("id"), lane)

def resolve_lane_target(lane):
    """(entry, (rc, message)) -- the ONE set a `--lane` names.

    A lane is identified by the PAIR (factory, lane): the display name alone is
    not unique (four factories each have a "Triage"), and the old code took the
    LAST match, so an answer was routed to whichever set happened to load last
    -- load-order luck, not a decision. A bare name matching more than one set
    now REFUSES and lists the qualified candidates; a qualified
    `<factory>/<lane>` names exactly one."""
    lane = (lane or "").strip()
    sets = load_all_sets()
    if "/" in lane:
        factory, _, bare = lane.partition("/")
        hits = [s for s in sets
                if s.get("id") == factory and s.get("lane") == bare]
        if len(hits) == 1:
            return hits[0], None
        if not hits:
            return None, (1, "no question set for lane %r" % lane)
        return None, (2, "lane %r names %d sets: %s. A qualified lane must name "
                         "exactly one."
                         % (lane, len(hits),
                            ", ".join(sorted(qualified_lane(s, bare)
                                             for s in hits))))
    hits = [s for s in sets if s.get("lane") == lane]
    if len(hits) == 1:
        return hits[0], None
    if not hits:
        return None, (1, "no question set for lane %r" % lane)
    return None, (2, "lane %r names %d sets across the fleet: %s. Pass the "
                     "qualified lane (<factory>/<lane>)."
                     % (lane, len(hits),
                        ", ".join(sorted(qualified_lane(s, lane)
                                         for s in hits))))

def resolve_lane(session):
    """(lane_name, reason) -- the DISPLAY name of the session's OWN topic.

    Resolved from the live binding, never from the caller: a lane that could
    name itself could mislabel where an answer came from (owner order
    2026-09-25: "Session can be derived from the env").

    The name comes from channel_messages.topic_name -- the bot-observed topic
    name. sessions.title is deliberately NOT used: it carries auto-generated
    titles for some lanes (measured: a bound lane titled "Telegram flow card
    metrics telemetry bar #232"), so it is not a topic name.

    RENAME PREFERENCE (#762): a `topic_edited` row OUTRANKS a regular message's
    `topic_name`, because the column is an ECHO that re-teaches the ORIGINAL
    creation name forever (a reply carries the name it was sent under), so
    "newest non-null name" alone re-stales after every rename. This mirrors
    src/db/repository/channel_message.rs `latest_topic_name`, the repo's own
    resolver for the same column. Measured live: 14 bound threads disagreed
    between the two orders (e.g. "Flood Throttling" -> "Telegram: Throttling").

    An unbound session returns (None, reason). The caller REFUSES, because an
    unbound session can never receive the answer: registering a question
    against it strands the question permanently.
    """
    path = questions_db_path()
    if not os.path.isfile(path):
        return None, "no session DB at %s" % path
    try:
        conn = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
    except sqlite3.Error as exc:
        return None, "session DB unreadable (%s)" % exc.__class__.__name__
    try:
        row = conn.execute(
            "select chat_id, thread_id from session_bindings "
            "where session_id=? and channel='telegram'", (session,)).fetchone()
        if row is None:
            return None, "session %s has no session_bindings row" % session
        chat_id, thread_id = row
        name = conn.execute(
            "select topic_name from channel_messages "
            "where channel='telegram' and channel_chat_id=? "
            "and cast(thread_id as integer)=? and topic_name is not null "
            "and topic_name<>'' "
            "order by (message_type = 'topic_edited') desc, created_at desc "
            "limit 1",
            (chat_id, thread_id)).fetchone()
    except sqlite3.Error as exc:
        return None, "session DB query failed (%s)" % exc.__class__.__name__
    finally:
        conn.close()
    if name is None or not (name[0] or "").strip():
        return None, ("binding found (chat %s thread %s) but no topic_name "
                      "observed for it yet" % (chat_id, thread_id))
    return name[0].strip(), None


