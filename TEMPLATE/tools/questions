           "(%r vs %r)" % (first["token"][:8], second["token"][:8]))
        page_dirs = [d for d in os.listdir(os.path.join(env["OC_QUESTIONS_DIR"], "pages"))
                     if d != "latest.json"]
        ck(len(page_dirs) == 1,
           "\u2026so exactly ONE live page directory exists, not one per publish "
           "(%r)" % (page_dirs,))
        rc, out, _ = run("publish", "--rotate", "--json")
        rotated = json.loads(out)
        ck(rotated["slug"] == first["slug"],
           "--rotate re-renders IN PLACE: the slug cannot churn, because the "
           "link is permanent (%r)" % rotated["slug"])
        ck(rotated["meta"].get("rotated_at"),
           "…and the forced re-render is recorded, not silent")
        rc, out, _ = run("publish", "--json")
        ck(json.loads(out)["slug"] == rotated["slug"],
           "\u2026and the slug is the one subsequently reused")

        # Owner report 2026-09-24: "it seems to fail when there are no
        # questions, but must deploy a no-open-questions page". Asserted on the
        # ARTIFACT (the page bytes), not on the message. A PRISTINE store is
        # used because the shared fixture store still holds open sets here --
        # running against it would measure those, not the empty state.
        empty_root = os.path.join(root, "empty-store")
        empty_env = dict(env)
        empty_env["OC_QUESTIONS_DIR"] = empty_root

        def run_empty(*args):
            proc = subprocess.run([tool] + list(args), env=empty_env,
                                  capture_output=True, text=True, timeout=90)
            return proc.returncode, proc.stdout, proc.stderr

        rc, out, err = run_empty("publish", "--json")
        ck(rc == 0, "publish with NOTHING open still exits 0 (rc=%d)" % rc)
        # Crash-free on purpose: json.loads on a pre-fix empty output raises,
        # and a selftest that dies mid-way reports NOTHING -- which reads as a
        # pass. Every step below degrades to a FAIL row instead.
        try:
            empty_meta = json.loads(out)
        except ValueError:
            empty_meta = {}
        empty_dir = os.path.join(empty_root, "pages", empty_meta.get("token", "?"))
        ck(os.path.isfile(os.path.join(empty_dir, "index.html")),
           "\u2026and still writes index.html -- the page is always deployed")
        empty_body = ""
        try:
            with open(os.path.join(empty_dir, "index.html"),
                      encoding="utf-8") as fh:
                empty_body = fh.read()
        except OSError:
            pass
        ck("No open questions" in empty_body,
           "the empty page carries the empty state, not a stale question")
        ck('name="qid"' not in empty_body,
           "\u2026and names no question, so no tap can read as a failure")
        ck((empty_meta.get("meta") or {}).get("questions") == 0,
           "\u2026and reports 0 open questions, not a stale count")
        rc, out, _ = run_empty("publish", "--json")
        try:
            again = json.loads(out).get("meta", {}).get("token")
        except ValueError:
            again = None
        ck(again is not None and again == empty_meta.get("token"),
           "\u2026on the SAME token -- an empty publish does not churn the URL")

        # C4: a mutation re-publishes, so the page is never hours stale.
        before = json.load(open(pointer, encoding="utf-8"))
        rc, out, _ = run("ask", "--factory", "f-republish-lane",
                         "--title", "t", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        ck(rc == 0, "ask with auto-republish exits 0 (rc=%d)" % rc)
        asked = json.loads(out)
        ck(asked.get("page", "").endswith(before["token"] + "/"),
           "ask returns the page url (%r)" % asked.get("page"))
        after = json.load(open(pointer, encoding="utf-8"))
        ck(after.get("token") == before["token"],
           "the auto-republish did NOT move the URL (token unchanged)")
        body = open(os.path.join(env["OC_QUESTIONS_DIR"], "pages",
                                 after["token"], "index.html"), encoding="utf-8").read()
        ck("f-republish-lane" in body,
           "\u2026and the re-rendered page actually carries the new set")
        rc, out, _ = run("ask", "--factory", "f-no-publish-lane",
                         "--title", "t", "--description", "d", "--no-publish", "--json")
        ck(rc == 0 and json.loads(out).get("page") is None,
           "--no-publish suppresses the refresh (rc=%d)" % rc)

        # A publish fault must never fail the mutation that triggered it.
        rc, out, err = run("ask", "--factory", "f-broken-page-lane",
                           "--title", "t", "--description", "d", "--json",
                           "--no-publish")
        ck(rc == 0, "the mutation succeeds regardless of the page (rc=%d)" % rc)

        # -- 8b2. the json-render page (owner order 2026-09-24: "rewrite for
        # json-render"). The page BODY is now a typed SPEC rendered by a Node
        # process; the shell stays in Python. These are the four legs HQ asked
        # for, plus the two properties that would break the live endpoint.
        rc, out, _ = run("publish", "--json")
        page = json.loads(out)
        body = open(os.path.join(page["path"], "index.html"), encoding="utf-8").read()
        # The BROWSER TAB title names the page and how much is waiting on it
        # (owner order 2026-09-26), so a browser with several factory pages open
        # says which one has questions. Read from the RENDERED page, not the
        # source: the title is emitted by the shell, and only the artifact shows
        # whether the derivation reached it.
        _t = re.search(r"<title>([^<]*)</title>", body)
        ck(_t is not None, "the page carries a <title>")
        ck(_t.group(1) == "%s (%d) - Factory Open Questions"
           % (page["slug"], page["meta"]["questions"]),
           "the tab title is '<slug> (<n>) - Factory Open Questions' (%r)"
           % (_t.group(1),))
        # NON-VACUITY, in a fixture BUILT to distinguish the two counts: ONE
        # open set holding TWO open questions. The assertion above cannot see
        # the difference, because the main fixture happens to hold exactly one
        # question per set -- sets and questions are both 9 there, so a title
        # built from the set count would satisfy it. len(sets) is the tempting
        # wrong answer: it is the count build_page already holds.
        _count_store = os.path.join(root, "count-store")
        os.makedirs(_count_store, exist_ok=True)
        with open(os.path.join(_count_store, "open.json"), "w",
                  encoding="utf-8") as fh:
            json.dump({"sets": [{
                "id": "f-count-lane", "status": "open", "lane": "Count Lane",
                "asked_at": None,
                "questions": [
                    {"qid": "c1", "title": "one", "status": "open",
                     "lane": "Count Lane", "asked_at": None},
                    {"qid": "c2", "title": "two", "status": "open",
                     "lane": "Count Lane", "asked_at": None}]}]}, fh)
        _saved_dir = env["OC_QUESTIONS_DIR"]
        env["OC_QUESTIONS_DIR"] = _count_store
        try:
            rc, out, err = run("publish", "--json")
            ck(rc == 0, "a one-set/two-question register publishes (rc=%d)" % rc)
            _p = json.loads(out)
            ck(len(_p["meta"]["sets"]) == 1 and _p["meta"]["questions"] == 2,
               "\u2026and the fixture distinguishes them (sets=%d questions=%d)"
               % (len(_p["meta"]["sets"]), _p["meta"]["questions"]))
            _html = open(os.path.join(_p["path"], "index.html"),
                         encoding="utf-8").read()
            _t2 = re.search(r"<title>([^<]*)</title>", _html)
            ck(_t2 is not None
               and _t2.group(1).endswith("(2) - Factory Open Questions"),
               "the tab counts OPEN QUESTIONS, never sets (%r)"
               % (_t2.group(1) if _t2 else None,))
        finally:
            env["OC_QUESTIONS_DIR"] = _saved_dir
        # Owner question 2026-09-24: the answer form should swap inline instead
        # of navigating. htmx breaks "no <script> at all", but the property that
        # mattered was NO CLIENT-SIDE LOGIC OF OUR OWN -- so the assertion
        # narrows instead of being deleted: at most ONE script, it must be the
        # vendored htmx from our own origin, and it must have a src (an INLINE
        # body is the thing the original leg actually guarded against).
        scripts = re.findall(r"<script\b[^>]*>", body, re.I)
        # TWO vendored files now: htmx, and our own questions.js affordance
        # (owner report 2026-09-25 -- the pre-checked radio was still selected
        # while the reader typed, and the typed answer used to be discarded).
        # The property the original leg guarded was NO CLIENT-SIDE LOGIC OF
        # OURS, so it is restated rather than deleted: every script must have a
        # src, every src must be a file VENDORED beside the page, and no script
        # may carry an inline body. An exact count is kept -- a ceiling is not
        # a presence test, and an unbounded count would accept an injected tag.
        ck(len(scripts) == 2,
           "1. exactly two <script> tags on the page (found %d)" % len(scripts))
        srcs = re.findall(r'<script\b[^>]*src="([^"]+)"', body, re.I)
        ck(sorted(srcs) == sorted([HTMX_FILE, UI_FILE]),
           "\u2026both VENDORED by name, from our own origin (%r)" % srcs)
        ck(not re.search(r"<script(?![^>]*\bsrc=)[^>]*>", body, re.I),
           "\u2026with no INLINE script body anywhere (the real guard)")

        # #562: the form swaps its own block in place instead of navigating.
        # Asserted on the FORM, and the target must name the section the
        # renderer actually emits -- a target that matches nothing swaps
        # nothing, which looks identical to htmx not loading.
        form_tag = re.search(r"<form\b[^>]*>", body)
        ck(form_tag is not None, "the page renders a <form>")
        form_html = form_tag.group(0) if form_tag else ""
        ck('hx-post="/answer"' in form_html,
           "the form carries hx-post=/answer (the inline swap)")
        # The target is an ATTRIBUTE selector: a CSS selector may not start
        # with a digit, so '#19f2d7-q1' made htmx throw on querySelectorAll
        # (owner report 2026-09-25). The selector is HTML-escaped in the
        # attribute, so its quotes arrive as &#x27;.
        target = re.search(r"hx-target=\"\[id=(?:&#x27;|')([^&']+)(?:&#x27;|')\]\"",
                           form_html)
        ck(target is not None, "\u2026and an hx-target (%r)" % form_html[:160])
        section_ids = re.findall(r'<section id="([^"]+)"', body)
        ck(target is not None and target.group(1) in section_ids,
           "\u2026naming a section the page actually renders (%r in %r)"
           % (target.group(1) if target else None, section_ids))
        ck(target is not None and not target.group(1)[:1].isdigit(),
           "\u2026and the target is valid for ANY id: a selector may not start "
           "with a digit, which is why it is an attribute selector")
        ck('hx-swap="outerHTML"' in form_html,
           "\u2026with outerHTML, so the answered block replaces the question")
        # The vendored file must sit BESIDE the page: a same-origin script is
        # the whole reason this is vendored rather than pulled from a CDN.
        # page["path"] IS the token dir -- dirname() of it is the pages ROOT,
        # which is what an earlier version of this leg checked, so it looked
        # for htmx beside the wrong thing.
        vendored = os.path.join(page["path"], HTMX_FILE)
        ck(os.path.isfile(vendored),
           "htmx is VENDORED beside the page (same origin, no CDN dependency)")
        ck(os.path.isfile(vendored) and os.path.getsize(vendored) > 10000,
           "\u2026and is a real payload, not a stub or an error page")
        ui = os.path.join(page["path"], UI_FILE)
        ck(os.path.isfile(ui),
           "questions.js is VENDORED beside the page too (same origin)")
        ui_body = open(ui, encoding="utf-8").read() if os.path.isfile(ui) else ""
        ck("textarea" in ui_body and "radio" in ui_body,
           "\u2026and it wires the text box to the radios (the exclusivity)")
        ck('name="token"' in body and 'name="set"' in body and 'name="qid"' in body,
           "2. the form carries token + set + qid as hidden inputs -- the submit "
           "contract the answer backend reads")
        ck('action="/answer"' in body,
           "\u2026and the action is the absolute /answer path")
        ck("noindex" in body, "\u2026and the noindex directive survives the rewrite")
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation.
        # Per-question, because the page carries EVERY open set: a global count
        # of "checked" measures the register size, not the recommendation. The
        # assertion is attribute-ORDER agnostic on purpose: React emits
        # checked="" BEFORE value, the Python fallback emits value="N" checked,
        # and a leg that assumes one order tests the renderer's ordering rather
        # than the recommendation.
        radios = re.findall(r"<input[^>]*type=\"radio\"[^>]*>", body)
        ck(bool(radios), "3. the page renders radio inputs")
        checked = [r for r in radios if "checked" in r]
        ck(len(checked) >= 1, "\u2026and a recommended option renders checked")
        ck(len(checked) < len(radios),
           "\u2026while a NON-recommended option does not (%d of %d checked)"
           % (len(checked), len(radios)))
        ck("<table>" in body and "mermaid.ink" in body,
           "4. a Markdown table and a ```mermaid fence still reach the page "
           "through RichText")

        # The spec is DATA, so its structure is assertable without parsing HTML
        # -- which is the whole reason for the rewrite.
        spec = build_spec([{"id": "abc123", "lane": "L", "asked_at": None,
                            "questions": [{"qid": "q1", "title": "T",
                                           "description": "d",
                                           "options": ["A", "B"],
                                           "recommended": 1,
                                           "lane": "L"}]}],
                          "tok", None, "/answer")
        ck(spec["root"] == "page" and spec["elements"]["page"]["type"] == "Page",
           "the spec has a named root element")
        ck(spec["elements"]["abc123-q1-o1"]["props"]["recommended"] is True
           and spec["elements"]["abc123-q1-o0"]["props"]["recommended"] is False,
           "\u2026and the recommended option is marked in the SPEC, not in a string")
        ck(all(isinstance(spec["elements"][k].get("children"), list)
               for k in spec["elements"]),
           "\u2026and every element carries a children LIST (the flat contract)")
        ck(set(spec["elements"]) >= {"page", "lane-l", "abc123-q1"},
           "the spec nests page -> LANE ANCHOR -> question by KEY")

        # --- the CONTENT is typed DATA too (owner: use json-render FULLY) -----
        rich = build_spec([{"id": "abc123", "lane": "L", "asked_at": None,
                            "questions": [{"qid": "q1", "title": "T", "lane": "L",
                                           "description":
                                               "## Head\n\nPara **b** *i* `c`.\n\n"
                                               "| a | b |\n|---|---|\n| 1 | 2 |\n\n"
                                               "```mermaid\nflowchart TD\n  A --> B\n```\n\n"
                                               "- x\n- y\n\n```py\nprint(1)\n```",
                                           "options": ["A"], "recommended": 0}]}],
                          "tok", "2026-01-01T00:00:00+00:00", "/answer")
        block_keys = [k for k in rich["elements"]["abc123-q1"]["children"]
                      if re.match(r"abc123-q1-b\d+$", k)]
        block_types = [rich["elements"][k]["type"] for k in block_keys]
        ck(block_types == ["Heading", "Paragraph", "Table", "Mermaid", "List",
                           "CodeBlock"],
           "3. a rich description emits SEPARATE typed block elements in document "
           "order, asserted on the SPEC and not on the HTML (%r)" % (block_types,))
        for _t in ("Heading", "Paragraph", "Table", "Mermaid", "List", "CodeBlock"):
            ck(_t in block_types, "5. the %s block is exercised by the spec" % _t)
        def _props_of(spec, wanted):
            """The first block's props of a given type, or None.

            next() without a default raises StopIteration, which ABORTS the
            selftest -- so a pre-port artifact that lacks the block reported no
            FAIL row and every leg after it silently never ran."""
            for _k in spec["elements"]:
                if spec["elements"][_k]["type"] == wanted:
                    return spec["elements"][_k]["props"]
            return None

        _tbl = _props_of(rich, "Table") or {}
        ck(bool(_tbl) and _tbl["headers"][0][0] == {"kind": "Text", "text": "a"}
           and _tbl["rows"][0][1][0]["text"] == "2",
           "\u2026and a table is structured DATA (headers + rows of typed spans), "
           "not an HTML string (%r)" % (_tbl,))
        _mer = _props_of(rich, "Mermaid") or {}
        ck("flowchart TD" in _mer.get("code", "")
           and "mermaid.ink" not in _mer.get("code", ""),
           "\u2026and Mermaid carries the CODE, so the component owns the URL "
           "(%r)" % (_mer,))
        _par = _props_of(rich, "Paragraph") or {}
        _kinds = [s["kind"] for s in _par.get("spans", [])]
        ck(_kinds == ["Text", "Strong", "Text", "Emphasis", "Text", "InlineCode",
                      "Text"],
           "\u2026and inline emphasis is typed SPANS, never an HTML fragment (%r)"
           % (_kinds,))
        ck(bool(_kinds) and not any("<" in s["text"]
                                    for s in _par.get("spans", [])),
           "\u2026and no span carries raw markup")

        # 6. the catalog is a GUARDRAIL: an unregistered type must be REJECTED,
        # not rendered as nothing.
        _bad = {"root": "page",
                "elements": {"page": {"type": "Page",
                                      "props": {"title": "t", "expires_at": "e"},
                                      "children": ["x"]},
                             "x": {"type": "Nope", "props": {}, "children": []}}}
        _html, _why = render_via_node(_bad)
        ck(_html is None and "rejected by the catalog" in (_why or ""),
           "6. an UNREGISTERED block type is REJECTED by the catalog's own "
           "validate(), not rendered as nothing and not merely thrown (%r)"
           % (_why,))

        # Owner order 2026-09-24: a renderer fault must fail the COMMAND, not
        # the page. Point the build dir at an impossible path and assert all
        # four halves: non-zero, reason on stderr, nothing written, last good
        # page byte-identical.
        before_dirs = sorted(os.listdir(pages_dir()))
        good_path = os.path.join(page["path"], "index.html")
        good_body = open(good_path, encoding="utf-8").read()
        broke = dict(env)
        broke["OC_QUESTIONS_RENDER_DIR"] = "/proc/nonexistent/build"
        proc = subprocess.run([tool, "publish"], env=broke,
                              capture_output=True, text=True, timeout=120)
        ck(proc.returncode != 0,
           "a renderer fault exits NON-ZERO (rc=%d)" % proc.returncode)
        ck("renderer fault" in proc.stderr,
           "\u2026and names the fault on stderr (%r)" % proc.stderr.strip()[-80:])
        ck(sorted(os.listdir(pages_dir())) == before_dirs,
           "\u2026and writes no page and creates no token dir (%r)"
           % (sorted(os.listdir(pages_dir())),))
        ck(open(good_path, encoding="utf-8").read() == good_body,
           "\u2026and the previous page is byte-identical, so the last good URL "
           "still serves instead of a 404")
        ck(render_via_node({"root": "page", "elements": {}})[1] is not None,
           "render_via_node reports a REASON on failure, never raises")

        # -- 8c. C5: amend -- the CLARIFY return leg. A Clarify click used to
        # dead-end: status=clarifying and the question could never be answered
        # again, so the loop never closed and the owner never saw the answer.
        rc, out, _ = run("ask", "--factory", "f-amend-lane",
                         "--title", "Original?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "clarify records status=clarifying")
        rc, out, _ = run("answer", am_set, "q1", "0")
        ck(rc == 0, "a clarifying question is still ANSWERABLE (rc=%d)" % rc)
        # amend on a set whose only question is answered: the set archived, so
        # amend must REPORT that rather than silently doing nothing.
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1", "--title", "x")
        ck(rc in (0, 1),
           "amend on a set with no open questions is handled explicitly "
           "(rc=%d)" % rc)
        # the real clarify loop, in order: ask -> clarify -> amend -> answer
        rc, out, _ = run("ask", "--factory", "f-clarify-lane",
                         "--title", "Clarify me?", "--description", "d",
                         "--option", "a", "--option", "b", "--recommended", "0",
                         "--json")
        am_set = json.loads(out)["set"]
        run("answer", am_set, "q1", "clarify", "--text", "what do you mean")
        ck(get_set(am_set)["questions"][0]["status"] == "clarifying",
           "the clarify loop starts from a clarifying question")
        rc, out, _ = run("amend", "--set", am_set, "--qid", "q1",
                         "--title", "Rewritten?", "--description", "d2",
                         "--option", "x", "--option", "y", "--recommended", "1",
                         "--json")
        ck(rc == 0, "amend exits 0 (rc=%d)" % rc)
        amended = json.loads(out)
        ck(amended["status"] == "open" and amended["was"] == "clarifying",
           "amend returns the question to OPEN (%r -> %r)"
           % (amended["was"], amended["status"]))
        ck(amended["amend_count"] == 1, "amend records an amend count")
        question = get_set(am_set)["questions"][0]
        ck(question["title"] == "Rewritten?" and question["options"] == ["x", "y"]
           and question["recommended"] == 1,
           "amend applied title, options and recommendation together")
        ck("answer" not in question,
           "amend CLEARS the stale answer, so the reopened question is clean")
        rc, out, _ = run("answer", am_set, "q1", "1")
        ck(rc == 0 and "y" in out,
           "the amended question is answerable and records the new option")
        rc, _, _ = run("amend", "--set", am_set, "--qid", "q1")
        ck(rc == 2, "amend with no field to change is rc=2 (rc=%d)" % rc)
        rc, _, _ = run("amend", "--set", am_set, "--qid", "nope", "--title", "t")
        ck(rc == 1, "amend on an unknown qid is rc=1 (rc=%d)" % rc)

        # -- 8d. C6: mechanical closure. The register used to close only on an
        # explicit answer or TTL, so questions outlived the thing they asked
        # about. "Never guess" is the contract: an unreadable predicate SKIPS.
        rc, out, _ = run("ask", "--factory", "f-mech-lane",
                         "--title", "Closed by predicate?", "--description", "d",
                         "--close-when", "true", "--json")
        mech_set = json.loads(out)["set"]
        ck(get_set(mech_set)["questions"][0]["status"] == "open",
           "a close_when predicate does not fire at register time")
        rc, out, _ = run("gc", "--json")
        ck("resolved_mechanically" in out,
           "gc reports the mechanical closure by STATUS (rc=%d)" % rc)
        ck(get_set(mech_set)["questions"][0]["status"] == "resolved_mechanically",
           "\u2026and the question is closed as resolved_mechanically")
        ck("closed_reason" in get_set(mech_set)["questions"][0],
           "\u2026with the REASON recorded, never a bare disappearance")

        rc, out, _ = run("ask", "--factory", "f-mech-no-lane",
                         "--title", "Must stay open?", "--description", "d",
                         "--close-when", "false", "--json")
        keep_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(keep_set)["questions"][0]["status"] == "open",
           "a predicate returning non-zero does NOT close the question")

        # A question whose subject names no fork issue and carries no predicate
        # must never be closed by the default arm -- the arm cannot guess.
        rc, out, _ = run("ask", "--factory", "f-mech-bare-lane",
                         "--title", "No issue named", "--description", "nothing here",
                         "--json")
        bare_set = json.loads(out)["set"]
        run("gc", "--json")
        ck(get_set(bare_set)["questions"][0]["status"] == "open",
           "the default arm closes NOTHING when no fork issue is named")

        # -- 9. the LOGGING path, unsuppressed -----------------------------
        # This leg exists because every other leg suppresses the unified log, so
        # oc_log_init returned BEFORE time.time(). A missing `import time`
        # therefore left the tool green in fixtures while it crashed on every
        # real invocation. A suppressed-log selftest cannot see that class.
        logfile = os.path.join(root, "tools.log")
        logenv = dict(env)
        logenv.pop("OC_TOOLS_NOLOG", None)
        logenv["OC_TOOLS_LOG"] = logfile
        proc = subprocess.run([tool, "list"], env=logenv, capture_output=True,
                              text=True, timeout=90)
        ck(proc.returncode == 0,
           "the UNSUPPRESSED logging path exits 0 (rc=%d %s)"
           % (proc.returncode, proc.stderr.strip().splitlines()[-1:]))
        rows = []
        if os.path.isfile(logfile):
            with open(logfile, encoding="utf-8") as fh:
                rows = [json.loads(line) for line in fh if line.strip()]
        ck(len(rows) == 1, "…and appends exactly one JSONL row (%d)" % len(rows))
        ck(bool(rows) and rows[0].get("tool") == PROG
           and "secs" in rows[0] and rows[0].get("exit") == 0,
           "…carrying tool/secs/exit per the unified-log schema")

        # WHICH renderer ran is observable ONLY in the log. The contract legs
        # above pass on the Python fallback too -- MEASURED: forcing the fallback
        # left all 114 legs green -- so without this leg nothing proves
        # json-render is actually in use, which is the owner's directive.
        pub_log = os.path.join(root, "publish.log")
        if os.path.isfile(pub_log):
            os.remove(pub_log)
        pubenv = dict(logenv)
        pubenv["OC_TOOLS_LOG"] = pub_log
        proc = subprocess.run([tool, "publish"], env=pubenv, capture_output=True,
                              text=True, timeout=120)
        ck(proc.returncode == 0,
           "publish under the unsuppressed log exits 0 (rc=%d)" % proc.returncode)
        fields = []
        if os.path.isfile(pub_log):
            with open(pub_log, encoding="utf-8") as fh:
                for line in fh:
                    if line.strip():
                        fields.append((json.loads(line).get("extra") or {}))
        ck(any(f.get("renderer") == "json-render" for f in fields),
           "publish records renderer=json-render -- there is exactly ONE "
           "builder, so the artifact states its own provenance (%r)"
           % (fields[-1:] if fields else None,))
        ck(not any("publish_failed" in f for f in fields),
           "…and a SUCCESSFUL publish records no fault, so a degradation cannot "
           "hide behind a green run")

        # -- 10. usage contract (the battery's edge cases) -----------------
        rc, _, _ = run("--help")
        ck(rc == 0, "--help exits 0 (rc=%d)" % rc)
        rc, _, _ = run("--bogus")
        ck(rc == 2, "unknown verb exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x", "--nope")
        ck(rc == 2, "unknown flag exits 2 (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x",
                       "--title", "t", "--description", "d", "--recommended", "3")
        ck(rc == 2, "a recommendation with NO options is refused (rc=%d)" % rc)
        rc, _, _ = run("ask", "--factory", "f-x",
                       "--title", "t", "--description", "d",
                       "--option", "a", "--option", "b", "--recommended", "3")
        ck(rc == 2, "a recommendation outside the option range is refused (rc=%d)" % rc)

        # -- 10. a CORRUPT register is an error, never a silent reset --------
        store = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        good = open(store, encoding="utf-8").read()
        with open(store, "w", encoding="utf-8") as fh:
            fh.write("{ not json")
        rc, out, err = run("list")
        ck(rc == 4, "a corrupt register is rc=4, not a silent reset (rc=%d)" % rc)
        with open(store, encoding="utf-8") as fh:
            survived = fh.read()
        ck(survived == "{ not json",
           "…and the tool did NOT overwrite it (the only copy of a parked question)")
        with open(store, "w", encoding="utf-8") as fh:
            fh.write(good)
        rc, _, _ = run("list")
        ck(rc == 0, "…and the restored register reads clean again")

        # -- 11. notify — the RETURN PATH (#547) ---------------------------
        # Delivery is a SEPARATE verb: `answer` holds RegisterLock, so a
        # network call inside it would block every other lane's ask/list for
        # the whole timeout, on a store whose point is concurrent safety.
        rc, _, err = run("notify")
        ck(rc == 2, "notify with no --set/--lane is usage rc=2 (rc=%d)" % rc)
        ck("requires --set" in err,
           "…and the usage error names the required flag, not an unknown verb")

        rc, out, _ = run("ask", "--factory", "f-return-lane",
                         "--questions-json", json.dumps([
                             {"title": "Ship it?", "description": "d",
                              "options": ["Yes", "No"], "recommended": 0}]),
                         "--json")
        ck(rc == 0, "ask registers the return-path set (rc=%d)" % rc)
        rset = json.loads(out)["set"]
        rc, _, _ = run("notify", "--set", rset)
        ck(rc == 1, "notify on an UNANSWERED set is rc=1, not a delivery (rc=%d)"
           % rc)

        rc, _, _ = run("answer", rset, "q1", "0")
        ck(rc == 0, "answer the return-path set (rc=%d)" % rc)
        # A factory set is NEVER auto-archived (owner order 2026-09-25): it
        # stays open at 0..N so its page and lane anchors are permanent. The
        # question is what closes; the SET does not.
        _live = get_set(rset)
        ck(_live is not None and _live.get("status") == "open",
           "…and the fully-answered factory set STAYS in the live register")

        # An answered set is normally ARCHIVED, so a reader that opens only
        # open.json cannot deliver the one answer that matters.
        rc, out, _ = run("notify", "--set", rset, "--dry-run", "--json")
        ck(rc == 0, "notify resolves an ARCHIVED set (rc=%d)" % rc)
        try:
            payload = json.loads(out)
        except Exception:  # noqa: BLE001
            # A leg that CRASHES reports nothing about the legs AFTER it, so a
            # missing payload is a FAIL row, never a traceback (see get_set).
            payload = {}
            ck(False, "notify --json emitted no JSON (the verb did not run)")
        ck(payload.get("session") == session_a,
           "…destination is the session recorded in the REGISTER")
        ck("Yes" in (payload.get("body") or ""),
           "…and the body carries the recorded answer")
        ck(len(payload.get("body") or "") <= 3020, "…and the body is bounded")

        rc, _, _ = run("notify", "--set", rset, "--dry-run",
                       "--session", "99999999-9999-9999-9999-999999999999")
        ck(rc == 2,
           "a caller-supplied destination is REFUSED rc=2 — no redirect (rc=%d)"
           % rc)

        rc, _, _ = run("notify", "--set", rset, "--mode", "bogus", "--dry-run")
        ck(rc == 2, "an unknown --mode is usage rc=2 (rc=%d)" % rc)

        rc, _, _ = run("notify", "--set", "nosuch", "--dry-run")
        ck(rc == 1, "an unknown set is rc=1 (rc=%d)" % rc)

        # A session that is not a session id must be REFUSED at REGISTER time
        # (C1): delivering to a guessed destination leaks an answer to a
        # stranger, and a register that holds a bad address can never deliver.
        rc, _, _ = run("ask", "--factory", "f-no-session-lane",
                       "--session", "not-a-uuid", "--title", "t",
                       "--description", "d", "--option", "a", "--option", "b")
        ck(rc == 2, "ask REFUSES a non-UUID session (rc=%d)" % rc)
        # …and the notify verb still refuses one that somehow got in, so the
        # guard exists at BOTH ends.
        nsid = json.loads(run("ask", "--factory", "f-guard-lane",
                              "--title", "t",
                              "--description", "d", "--json")[1])["set"]
        store_file = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        raw = json.load(open(store_file, encoding="utf-8"))
        for entry in raw["sets"]:
            if entry["id"] == nsid:
                entry["session"] = "not-a-uuid"
        json.dump(raw, open(store_file, "w", encoding="utf-8"))
        rc, _, _ = run("notify", "--set", nsid, "--dry-run")
        ck(rc == 3, "a non-uuid destination is refused rc=3 at the return end "
                    "too (rc=%d)" % rc)


        # =====================================================================
        # FACTORY-SET MODEL (owner orders 2026-09-25). Every leg below asserts a
        # criterion from the order, on the RECORD or the ARTIFACT rather than on
        # a message.
        # =====================================================================
        _fac = "f-acceptance"
        rc, out, _ = run("ask", "--factory", _fac, "--title", "A1",
                         "--description", "d1", "--option", "x", "--option", "y",
                         "--recommended", "0", "--json")
        ck(rc == 0, "ask --factory works with NO --lane and NO --session (rc=%d)"
           % rc)
        first_entry = json.loads(out).get("entry", {})
        ck(first_entry.get("id") == _fac and first_entry.get("factory") == _fac,
           "\u2026the factory key IS the set id (%r)" % first_entry.get("id"))
        ck(first_entry.get("lane") == "Carrier tools",
           "\u2026and the lane is DERIVED from the session's own binding, never "
           "supplied by the caller (%r)" % first_entry.get("lane"))
        ck(json.loads(out).get("created") is True,
           "\u2026the first ask CREATES the standing set")

        # A SECOND session, different lane, into the SAME factory.
        env_b = dict(env)
        env_b["OPENCRABS_SESSION_ID"] = session_b
        proc_b = subprocess.run([tool, "ask", "--factory", _fac,
                                 "--title", "B1", "--description", "d2",
                                 "--option", "z", "--recommended", "0", "--json"],
                                env=env_b, capture_output=True, text=True,
                                timeout=90)
        ck(proc_b.returncode == 0,
           "a second session asks into the SAME factory (rc=%d)"
           % proc_b.returncode)
        try:
            second = json.loads(proc_b.stdout)
        except ValueError:
            second = {}
        ck(second.get("created") is False,
           "\u2026and the standing set is REUSED, not re-created")
        ck(second.get("set") == _fac and second.get("lane")
           == "Governance: Ontology & RSI",
           "\u2026recording the SECOND session's own lane (%r)"
           % second.get("lane"))

        # ONE set, two questions, each with its own lane + session.
        acc = get_set(_fac)
        ck(acc is not None and len(acc.get("questions", [])) == 2,
           "ONE standing set holds BOTH questions (%d)"
           % len((acc or {}).get("questions", [])))
        _qs = (acc or {}).get("questions", [])
        ck([q.get("qid") for q in _qs] == ["q1", "q2"],
           "\u2026numbered q1..qN in call order (%r)"
           % [q.get("qid") for q in _qs])
        ck(len({q.get("session") for q in _qs}) == 2,
           "\u2026each question carrying its OWN asking session")
        ck({q.get("lane") for q in _qs} == {"Carrier tools",
                                           "Governance: Ontology & RSI"},
           "\u2026and its own lane (%r)" % sorted({q.get("lane") for q in _qs}))

        # Derived from the fixture's OWN output: a leg naming a live lane goes
        # stale the moment that lane changes.
        rc, _all, _ = run("list")
        _fleet = int(re.match(r"(\d+) open", _all.strip().splitlines()[0]).group(1))
        _lanes = re.findall(r"^(\S.*?) \u2014 (\d+) open", _all, re.M)
        ck(len(_lanes) >= 2 and _fleet > 0,
           "list fixture has >= 2 lanes and a non-zero fleet total (fleet=%d)"
           % _fleet)
        _probe_lane, _probe_open = _lanes[0][0], int(_lanes[0][1])
        rc, out, _ = run("list", "--lane", _probe_lane)
        _hdr = out.strip().splitlines()[0] if out.strip() else ""
        ck(rc == 0 and _hdr.startswith("%d open question(s) across 1 lane(s)" % _probe_open),
           "list --lane counts within the FILTER, not the fleet (want %d, got %r)"
           % (_probe_open, _hdr))
        ck(re.search(r"^%s \u2014 %d open(, \d+ closed \(history\))?$"
                     % (re.escape(_probe_lane), _probe_open), out, re.M) is not None,
           "\u2026and the lane subtotal names the history it lists beneath it")
        rc, out, _ = run("list", "--lane", _probe_lane, "--json")
        _fj = json.loads(out)
        ck(_fj.get("open_questions") == sum(r["open"] for r in _fj.get("lanes", [])),
           "list --lane --json: open_questions agrees with the lanes it shows "
           "(pre-fix it carried the fleet total beside a filtered lanes[])")

        # The page: ONE section per LANE, each with a STABLE anchor.
        rc, out, _ = run("publish", "--json")
        acc_page = json.loads(out)
        acc_body = open(os.path.join(acc_page["path"], "index.html"),
                        encoding="utf-8").read()
        _anchors = re.findall(r'<section id="(lane-[^"]+)"', acc_body)
        ck("lane-carrier-tools" in _anchors
           and "lane-governance-ontology-rsi" in _anchors,
           "the page carries one section per LANE with a stable anchor (%r)"
           % sorted(set(_anchors)))
        ck(len(_anchors) == len(set(_anchors)),
           "\u2026and every lane anchor is UNIQUE -- a duplicate id would make "
           "the handed-out URL ambiguous (%r)" % sorted(_anchors))
        ck(acc_body.count('id="lane-carrier-tools"') == 1,
           "\u2026one section per lane across the WHOLE page, not one per set")

        # A re-publish reproduces the anchors BYTE-IDENTICALLY.
        rc, out, _ = run("publish", "--json")
        again_body = open(os.path.join(json.loads(out)["path"], "index.html"),
                          encoding="utf-8").read()
        ck(re.findall(r'<section id="(lane-[^"]+)"', again_body) == _anchors,
           "a re-publish reproduces the lane anchors byte-identically")
        ck(json.loads(out)["slug"] == acc_page["slug"],
           "\u2026at the IDENTICAL page path (asserted twice, per the order)")

        # The page ALWAYS deploys, and a lane whose questions are all answered
        # still renders its section, so an anchor handed out yesterday resolves.
        rc, _, _ = run("answer", _fac, "q1", "0")
        rc, _, _ = run("answer", _fac, "q2", "0")
        rc, out, _ = run("publish", "--json")
        zero_body = open(os.path.join(json.loads(out)["path"], "index.html"),
                         encoding="utf-8").read()
        ck("lane-carrier-tools" in zero_body
           and "lane-governance-ontology-rsi" in zero_body,
           "a lane whose questions are all answered STILL renders its section "
           "(the anchor stays resolvable)")
        ck("0 open" in zero_body,
           "\u2026reporting its open count, so 0 is visible rather than the "
           "section vanishing")
        _rec = get_set(_fac)
        ck(_rec is not None and _rec.get("status") == "open",
           "answering the last question leaves the set OPEN (status=%r)"
           % (_rec or {}).get("status"))
        ck(all(question_is_closed(q) for q in (_rec or {}).get("questions", [])),
           "\u2026with 0 open questions, asserted on the RECORD")

        # list: the OPEN COUNT is the primary output, grouped by lane.
        rc, out, _ = run("list")
        ck(rc == 0 and out.strip().splitlines()[0].endswith("lane(s)"),
           "list prints the OPEN COUNT as its primary output (%r)"
           % out.strip().splitlines()[:1])
        ck(re.search(r"^Carrier tools \u2014 \d+ open(, \d+ closed \(history\))?$",
                     out, re.M) is not None,
           "\u2026and groups by lane with a per-lane open count")
        # The header must describe what is SHOWN. Pre-fix the count was taken
        # BEFORE the --lane filter, so a filtered view printed the FLEET total
        # against the filtered lane count ("7 open ... across 1 lane(s)" for a
        # lane holding zero) -- and the owner reads that header to decide what
        # to answer. MUTATION KILL: move the total_open computation back above
        # the --lane filter and leg (i) reddens.
        rc, out, _ = run("list", "--json")
        _lj = json.loads(out)
        ck(isinstance(_lj.get("open_questions"), int)
           and all("open" in row and "lane" in row for row in _lj.get("lanes", [])),
           "list --json carries one entry per lane with its open count")

        # An UNBOUND session is refused: it could never receive the answer.
        env_un = dict(env)
        env_un["OPENCRABS_SESSION_ID"] = session_unbound
        proc_un = subprocess.run([tool, "ask", "--factory", _fac,
                                  "--title", "x", "--description", "d"],
                                 env=env_un, capture_output=True, text=True,
                                 timeout=90)
        ck(proc_un.returncode != 0,
           "ask from an UNBOUND session exits non-zero (rc=%d)"
           % proc_un.returncode)
        ck("unbound" in (proc_un.stderr or "").lower()
           or "no session_bindings" in (proc_un.stderr or ""),
           "\u2026with a clear message naming why (%r)"
           % (proc_un.stderr or "").strip()[:90])

        # The return address is PER QUESTION: the answer reaches the lane that
        # ASKED it, not whoever created the standing set.
        rc, out, _ = run("ask", "--factory", _fac, "--title", "B2",
                         "--description", "d3", "--json")
        rc, out, _ = run("notify", "--set", _fac, "--qid", "q2", "--dry-run")
        ck(rc == 0 and "Governance: Ontology & RSI" in out,
           "notify --qid q2 resolves q2's OWN lane, not the set's (%r)"
           % out.strip()[:110])

        # PORTED WITH batch_return_address (#182 item 1, direction source ->
        # template): the function above had no probe here, and a gate that has
        # only ever seen good input has not been shown to reject bad input.
        #
        # NO --qid: one body carrying several lanes' answers cannot have ONE
        # destination. Pre-fix the destination fell back to the SET's session
        # while the body named the ASKING lane, so the answer reached a lane
        # that did not ask it (#612). MUTATION KILL: restore
        # question_return_address(entry, None) in the no-qid branch of
        # cmd_notify and both refusal legs redden.
        _reg = os.path.join(env["OC_QUESTIONS_DIR"], "open.json")
        with open(_reg, encoding="utf-8") as fh:
            _saved = json.load(fh)
        _SET_S = "11111111-1111-1111-1111-111111111111"
        _Q_S = "22222222-2222-2222-2222-222222222222"

        def _plant(questions):
            with open(_reg, "w", encoding="utf-8") as fh:
                json.dump({"sets": [{"id": "mixfac", "session": _SET_S,
                                     "lane": "Creator Lane", "ttl_days": 7,
                                     "status": "open", "questions": questions}]}, fh)

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "session": _SET_S, "lane": "Creator Lane"},
                {"qid": "q2", "title": "t2", "status": "answered", "answer": "a2",
                 "session": _Q_S, "lane": "Second Lane"}])
        rc, out, err = run("notify", "--set", "mixfac", "--dry-run", "--json")
        ck(rc == 1 and "--qid" in (out + err),
           "notify with NO --qid REFUSES when the answers span sessions, naming "
           "--qid (rc=%d, %r)" % (rc, (out + err).strip()[:100]))

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "session": _Q_S, "lane": "Second Lane"},
                {"qid": "q2", "title": "t2", "status": "answered", "answer": "a2",
                 "session": _Q_S, "lane": "Second Lane"}])
        rc, out, _ = run("notify", "--set", "mixfac", "--dry-run", "--json")
        try:
            _dest = json.loads(out).get("session")
        except Exception:
            _dest = None
        ck(rc == 0 and _dest == _Q_S,
           "notify with no --qid uses the questions' SHARED session, not the "
           "set's (%r, rc=%d)" % (_dest, rc))

        _plant([{"qid": "q1", "title": "t1", "status": "answered", "answer": "a1",
                 "lane": "Creator Lane"}])
        rc, out, _ = run("notify", "--set", "mixfac", "--dry-run", "--json")
        try:
            _dest = json.loads(out).get("session")
        except Exception:
            _dest = None
        ck(rc == 0 and _dest == _SET_S,
           "a question with no session of its own still falls back to the set's "
           "(%r, rc=%d)" % (_dest, rc))

        with open(_reg, "w", encoding="utf-8") as fh:
            json.dump(_saved, fh)

        # A real delivery that cannot reach the lane must be a FAULT, never a
        # silent success — otherwise a parked answer looks delivered.
        dead = dict(env)
        dead["OC_QUESTIONS_A2A"] = "http://127.0.0.1:1/a2a/v1"
        proc = subprocess.run([tool, "notify", "--set", rset], env=dead,
                              capture_output=True, text=True, timeout=90)
        ck(proc.returncode == 4,
           "an unreachable A2A endpoint is rc=4, never a false success (rc=%d)"
           % proc.returncode)

        if fails:
            print("  %d FAILED" % len(fails))
            return 1
        print("  all checks passed")
        return 0
    finally:
        shutil.rmtree(root, ignore_errors=True)

USAGE = """questions — the Open Questions register (#547)

  ask      --factory <KEY> [--session <id>]
           [--questions-file F | --questions-json J |
            --title T --description D [--option O]... [--recommended N]]
           [--ttl-days N] [--subject S] [--no-clarify] [--close-when CMD]
           [--no-publish] [--json]
           --factory is REQUIRED: the factory key IS the standing set id,
           reused on every ask. There is no --lane: the asking session is read
           from OPENCRABS_SESSION_ID and its display name is resolved from that
           session's own binding, so a caller cannot mislabel itself. --session
           is an override for callers outside a turn. Prints the open-question
           TOTAL and the page URL -- there is no card.
  answer   <set-id> <qid> <choice-index|clarify> [--text T] [--via card|page|cli]
           [--no-publish]
           clarify with NO --text is a COMPLETE request (#183): the owner's
           click alone asks the lane to restate the question in wider context
           and clearer language — the tool supplies that meaning; --text adds
           the owner's own wording and wins when present
  withdraw --set <id> --qid <qid> [--text REASON] [--no-publish] [--json]
           retracts a question that has become moot; the set stays open
  amend    --set <id> --qid <qid> [--title T] [--description D]
           [--option O]... [--recommended N] [--clear-options]
           the CLARIFY return leg: edits the question and reopens it
  notify   --set <id> | --lane <NAME> [--qid Q] [--mode turn-end|interrupt|quiet]
           [--dry-run] [--json]        the RETURN PATH: delivers the answer to
                                       the session recorded in the register.
                                       With no --qid the destination is the
                                       session every answered question SHARES;
                                       if they differ it refuses and names
                                       --qid, because one body cannot have one
                                       destination. A factory set records its
                                       CREATOR's session; each question carries
                                       its own, and that is what routes.
  list     [--lane NAME] [--session id] [--all] [--json] [--quiet]
  publish  [--set id] [--action URL] [--prune] [--rotate] [--json]
           reuses the live token; --rotate mints a new URL explicitly
  lint     [--json]
  gc       [--dry-run] [--json]        also applies mechanical closure

Store: <profile home>/questions/open.json (+ archive.jsonl, pages/<slug>/).
The PAGE is the owner surface and lives at a CONSTANT slug -- the directory is
reused on every publish, never re-minted. --factory is the standing set id.
--session is the RETURN ADDRESS: the calling session, never a cron or renderer.
rc: 0 ok / 1 finding-or-not-found / 2 usage / 3 state-refused / 4 store-or-IO.
"""

def main(argv):
    oc_log_init()
    if not argv or argv[0] in ("--help", "-h", "help"):
        sys.stdout.write(USAGE)
        return 0
    verb, rest = argv[0], argv[1:]
    if verb in ("--selftest", "selftest"):
        return selftest()
    handlers = {"ask": cmd_ask, "answer": cmd_answer, "amend": cmd_amend,
                "withdraw": cmd_withdraw, "list": cmd_list,
                "publish": cmd_publish, "lint": cmd_lint,
                "gc": cmd_gc, "notify": cmd_notify}
    if set(handlers) != set(_VERBS):
        sys.stderr.write("%s: verb set drifted from _VERBS\n" % PROG)
        return 2
    handler = handlers.get(verb)
    if handler is None:
        sys.stderr.write("%s: unknown verb %r\n\n%s" % (PROG, verb, USAGE))
        return 2
    return handler(rest)

if __name__ == "__main__":
    _rc = main(sys.argv[1:])
    oc_log_finish(_rc)
    sys.exit(_rc)
