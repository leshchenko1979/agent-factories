def page_wrapper(body, expires_at, title):
    """The page shell. Stays in Python deliberately: the noindex directive, the
    charset, the inline CSS and the TTL line are tested here and must not change
    just because the BODY is now rendered from a spec.

    `title` is the BROWSER TAB's title, and the shell is its ONE home. The
    spec's Page.title is a DIFFERENT surface -- the renderer emits it as the
    <h1> inside the body -- so the two are not two homes for one fact: the tab
    names the page and its open count, the heading names the page.

    The page is PERMANENT (owner order 2026-09-25), so the line says so rather
    than printing an expiry that no longer exists."""
    meta_line = (f"expires {expires_at}" if expires_at else "permanent link")
    return ("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">\n"
            "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n"
            "<meta name=\"robots\" content=\"noindex, nofollow\">\n"
            f"<title>{html.escape(title)}</title>\n"
            # defer: the page is readable and submittable before htmx arrives,
            # and the attributes are inert if the file never loads.
            f'<script src="{HTMX_FILE}" defer></script>\n'
            f'<script src="{UI_FILE}" defer></script>\n'
            f"<style>{PAGE_CSS}</style>\n"
            "</head><body>\n"
            f'<p class="meta">{html.escape(meta_line)}</p>\n'
            + body
            + "\n</body></html>\n")


def build_page(entries, slug, expires_at, action):
    """The page body from a json-render spec, wrapped in the tested shell.

    A renderer fault FAILS LOUDLY (owner order 2026-09-24). There is exactly one
    builder: a second one emitting near-identical HTML made the artifact unable
    to state its own provenance, so the fallback was deleted rather than kept as
    a safety net. The fault exits non-zero with the reason on stderr and NOTHING
    is written, so the previous page stays serving instead of a 404."""
    spec = build_spec(entries, slug, expires_at, action)
    html_body, why = render_via_node(spec)
    if html_body is None:
        oc_log_extra("publish_failed", why)
        die(4, "renderer fault: %s" % why)
    oc_log_extra("renderer", "json-render")
    # The tab title names the page AND how much is waiting on it, so a browser
    # with several factory pages open says which one has questions (owner order
    # 2026-09-26). The count is the OPEN QUESTIONS count, the same predicate the
    # pointer publishes -- never len(entries), which counts sets.
    title = "%s (%d) - Factory Open Questions" % (slug, open_question_count(entries))
    return page_wrapper(html_body, expires_at, title)


# Why the last vendoring attempt ended as it did. Recorded so the selftest can
# report the REASON rather than just the absence -- an unvendored page and a
# failed download look identical from the artifact alone.
_VENDOR_LAST = "not attempted"

def vendor_htmx(directory):
    global _VENDOR_LAST
    """Copy the vendored htmx beside the page. Best-effort BY DESIGN: a failure
    leaves the attributes inert and the form still submits normally, so this
    must never fail a publish. Downloaded once into the build dir, then copied
    from there -- the page never fetches it from a third party at runtime."""
    target = os.path.join(directory, HTMX_FILE)
    cached = os.path.join(render_dir(), HTMX_FILE)
    try:
        if not os.path.isfile(cached) or os.path.getsize(cached) < 10000:
            import urllib.request
            with urllib.request.urlopen(HTMX_URL, timeout=20) as response:
                payload = response.read()
            if len(payload) < 10000:
                raise OSError("suspiciously small htmx payload")
            with open(cached, "wb") as fh:
                fh.write(payload)
        with open(cached, "rb") as fh:
            payload = fh.read()
        if not os.path.isfile(target) or open(target, "rb").read() != payload:
            with open(target, "wb") as fh:
                fh.write(payload)
        _VENDOR_LAST = "ok (%d bytes)" % len(payload)
        return True
    except Exception as exc:  # noqa: BLE001
        _VENDOR_LAST = "%s: %s" % (exc.__class__.__name__, exc)
        oc_log_extra("htmx_vendor_failed", exc.__class__.__name__)
        return False

def vendor_ui(directory):
    """Write the radio/text affordance beside the page. Unlike htmx this is
    OURS, so it needs no download: it is written from the constant, which also
    means a stale copy can never linger (the content is overwritten every
    publish). Best-effort for the same reason as htmx: without it the form
    still submits, the two inputs are just not visually exclusive."""
    target = os.path.join(directory, UI_FILE)
    try:
        with open(target, "w", encoding="utf-8") as fh:
            fh.write(UI_JS)
        return True
    except Exception as exc:  # noqa: BLE001
        oc_log_extra("ui_vendor_failed", exc.__class__.__name__)
        return False

def prune_pages(keep=None):
    """Remove retired ROTATING-TOKEN directories, and only those.

    The path is a constant slug now, so a token-shaped directory is residue from
    the retired model: nothing can address it and its link is dead. The test is
    the SHAPE (LEGACY_TOKEN_RE), never "anything that is not the current slug",
    so a second factory's readable slug can never be swept by accident.

    The live slug is NEVER removed: its link is bookmarked and permanent
    (owner order 2026-09-25)."""
    import shutil
    removed = []
    root = pages_dir()
    if not os.path.isdir(root):
        return removed
    for name in sorted(os.listdir(root)):
        if not os.path.isdir(os.path.join(root, name)):
            continue
        if keep and name == keep:
            continue
        if not LEGACY_TOKEN_RE.match(name):
            continue
        shutil.rmtree(os.path.join(root, name), ignore_errors=True)
        removed.append(name)
    return removed

def page_is_live(token):
    """(live, reason) — used by the selftest and by anything that needs to know
    whether a token still serves."""
    directory = os.path.join(pages_dir(), token)
    meta_path = os.path.join(directory, "meta.json")
    if not os.path.isfile(meta_path):
        return False, f"no page for token {token!r}"
    try:
        with open(meta_path, "r", encoding="utf-8") as fh:
            meta = json.load(fh)
    except Exception as exc:
        return False, f"meta unreadable: {exc}"
    if not os.path.isfile(os.path.join(directory, "index.html")):
        return False, f"page directory {token!r} carries no index.html"
    # NO expiry check: the slug is a permanent bookmark (owner order
    # 2026-09-25). A 7-day page TTL is incompatible with a constant URL.
    return True, "live at %s" % page_url(token)

def latest_page():
    """The current published page as (url, meta), or (None, reason).

    publish records pages/latest.json so render does not have to guess which
    token directory is current. A pointer whose token has expired or been pruned
    reports the reason rather than omitting the link silently: a card with no
    pointer and a card whose pointer is dead look identical otherwise, and only
    one of them is a defect."""
    path = latest_pointer_path()
    if not os.path.isfile(path):
        return None, "no page published yet (run: %s publish)" % PROG
    try:
        with open(path, encoding="utf-8") as fh:
            meta = json.load(fh)
    except (OSError, ValueError) as exc:
        return None, "pages/latest.json unreadable (%s)" % exc.__class__.__name__
    token = meta.get("slug") or meta.get("token")
    if not token:
        return None, "pages/latest.json carries no slug"
    live, why = page_is_live(token)
    if not live:
        return None, "the latest page is not live (%s)" % why
    return page_url(token), None


def open_question_count(sets):
    """Open QUESTIONS across `sets` — the ONE predicate the page title, the
    pointer's `questions` field and `open_totals` all read.

    NOT len(sets): that counts question SETS and is a different number. The live
    register holds 3 open sets carrying 5 open questions, so a title built from
    the set count would read (3) while the page renders 5."""
    return sum(1 for s in sets for q in s.get("questions", [])
               if not question_is_closed(q))


def open_totals():
    """(open questions, open sets) across the WHOLE register — the number the
    owner asked ask to return."""
    with RegisterLock():
        data = read_register()
    sets = [s for s in data["sets"] if s.get("status") == "open"]
    return open_question_count(sets), len(sets)


def read_pointer():
    """The current published page's meta, or None. Never raises: a corrupt
    pointer is a condition to report, not a crash."""
    path = latest_pointer_path()
    if not os.path.isfile(path):
        return None
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return None


def republish(flags):
    """C4: refresh the page after a register mutation, BEST-EFFORT.

    A publish fault must never fail the mutation that triggered it — the
    mutation is the caller's work and the page is a convenience — so this
    swallows the fault and records it in the unified log instead."""
    if flags.get("--no-publish"):
        return None
    try:
        meta, _ = publish_page(quiet=True)
        return meta
    except SystemExit:
        oc_log_extra("publish_failed", "SystemExit")
        return None
    except Exception as exc:
        oc_log_extra("publish_failed", exc.__class__.__name__)
        return None


def publish_page(set_id=None, action=None, prune=False, rotate=False, quiet=False):
    """Build or refresh the public page. (meta, pruned).

    The path is a CONSTANT slug derived from the factory key, never a rotating
    token (owner order 2026-09-25). A fresh URL per publish would 404 the link
    the owner bookmarked, so re-render-on-change and a stable URL have to hold
    together or the feature is unusable.

    The page NEVER expires: a 7-day PAGE TTL is incompatible with a permanent
    bookmark. DEFAULT_TTL_DAYS still governs QUESTION staleness -- a different
    thing, and unchanged.

    `--rotate` no longer mints a URL (there is nothing to mint). It forces a
    full re-render and records rotated_at, which is all "rotate" can mean once
    the path is constant. Changing the path means changing the FACTORY KEY, and
    that has exactly one home: page_slug().

    `set_id` narrows the rendered questions but NOT the path: every publish
    writes the one shared page. republish() never passes it.
    """
    with RegisterLock():
        data = read_register()
    all_open = [s for s in data["sets"] if s.get("status") == "open"]
    entries = all_open
    if set_id:
        entries = [s for s in entries if s.get("id") == set_id]
        if not entries:
            die(1, f"no open question set {set_id!r}")
    entries = sorted(entries, key=lambda s: s.get("asked_at") or "")
    slug = page_slug_for(all_open)
    pruned = prune_pages(keep=slug)
    # No early return on an empty register (owner order 2026-09-24): the page
    # must always be deployed, so an empty state is rendered to the SAME slug
    # rather than leaving the previous page serving stale questions.

    created = datetime.datetime.now(datetime.timezone.utc)
    directory = os.path.join(pages_dir(), slug)
    # Render FIRST: a fault must leave no half-made directory behind and must
    # leave the previous page serving (owner order 2026-09-24).
    page = build_page(entries, slug, None, action or "/answer")
    os.makedirs(directory, exist_ok=True)
    vendor_htmx(directory)
    vendor_ui(directory)
    with open(os.path.join(directory, "index.html"), "w", encoding="utf-8") as fh:
        fh.write(page)
    # `expires_at` stays PRESENT and null: the live answer backend reads it and
    # fails OPEN on an empty value (backend.py: expired() -> False when unset),
    # so a null is "never expires" rather than "unknown".
    meta = {"slug": slug, "token": slug,
            "created_at": created.replace(microsecond=0).isoformat(),
            "expires_at": None,
            "action": action or "/answer", "sets": [e["id"] for e in entries],
            "url": page_url(slug),
            "rotated_at": (created.replace(microsecond=0).isoformat()
                           if rotate else None),
            "questions": open_question_count(entries)}
    with open(os.path.join(directory, "meta.json"), "w", encoding="utf-8") as fh:
        json.dump(meta, fh, indent=2)

    # The pointer render reads. Written AFTER the page and its meta exist, so a
    # reader never resolves a slug whose directory is still incomplete.
    pointer = dict(meta)
    with open(latest_pointer_path(), "w", encoding="utf-8") as fh:
        json.dump(pointer, fh, indent=2)

    oc_log_extra("slug", slug)
    oc_log_extra("questions", str(meta["questions"]))
    if not quiet:
        print(f"published {meta['questions']} question(s) to {directory}")
        print(f"  slug {slug} (permanent)")
        print(f"  url {page_url(slug)}")
        print(f"  action {meta['action']}")
        for name in pruned:
            print(f"  pruned retired token dir {name}")
    return meta, pruned

def cmd_publish(argv):
    _, flags = parse_flags(argv, valued=["--set", "--action"],
                           boolean=["--json", "--prune", "--rotate"])
    action = flags.get("--action") or "/answer"
    with RegisterLock():
        data = read_register()
    entries = [s for s in data["sets"] if s.get("status") == "open"]
    if flags.get("--set"):
        wanted = flags["--set"]
        entries = [s for s in entries if s.get("id") == wanted]
        if not entries:
            die(1, f"no open question set {wanted!r}")
    entries = sorted(entries, key=lambda s: s.get("asked_at") or "")

    meta, pruned = publish_page(set_id=flags.get("--set"), action=action,
                                prune=bool(flags.get("--prune")),
                                rotate=bool(flags.get("--rotate")), quiet=True)
    if flags.get("--json"):
        print(json.dumps({"slug": meta["slug"], "token": meta["slug"],
                          "path": os.path.join(pages_dir(), meta["slug"]),
                          "meta": meta, "pruned": pruned}, indent=2))
    else:
        directory = os.path.join(pages_dir(), meta["slug"])
        print(f"published {meta['questions']} question(s) to {directory}")
        print(f"  slug {meta['slug']} (permanent)")
        print(f"  url {page_url(meta['slug'])}")
        print(f"  action {meta['action']}")
        for name in pruned:
            print(f"  pruned retired token dir {name}")
    return 0

